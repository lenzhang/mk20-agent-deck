# Copy to .env (git-ignored) or export in your shell. Never commit real values.

# --- tools/cam (optional overhead ONVIF camera used to photograph the MK20 during device tests) ---
MK20_CAM_IP=192.0.2.10
MK20_CAM_USER=admin
MK20_CAM_PASS=change-me          # or put it in ~/.config/mk20-cam/cred (chmod 600)

# --- device access ---
MK20_ADB=~/mk20-backup/mkadb.sh  # adb wrapper that only ever talks to the MK20 (see tools/imac/mkadb.sh)

# --- link overrides (normally auto-detected) ---
# MK20_TCP=172.30.250.2:17890    # or "off" to force CDC-ACM
# MK20_ECM_IF=en13
# MK20DECK_HOME=~/.config/mk20-agent-deck

# --- tools/imac/route-check.sh (only if you route AI CLIs through a proxy) ---
# MIHOMO_API=http://127.0.0.1:9090
# WANT_IP=203.0.113.10
