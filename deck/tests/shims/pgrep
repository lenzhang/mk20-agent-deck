#!/bin/sh
# mock: prints $MOCK_DIR/pgrep.out lines (pids) if present
# keyed mode ($MOCK_DIR/pgrep.keyed): KeyboardDevice -> pgrep.kd; mk20-kbd/mk20-router ->
# pgrep.kbd/pgrep.router if present (including empty = absent), otherwise real live test processes.
# Anything else -> pgrep.out. Keep these process lists independent.
if [ -f "$MOCK_DIR/pgrep.keyed" ]; then
  pat=""; for a in "$@"; do pat=$a; done
  case "$pat" in
    *KeyboardDevice*) f=$MOCK_DIR/pgrep.kd;;
    *mk20-kbd*|*mk20-router*)
      case "$pat" in *mk20-kbd*) f=$MOCK_DIR/pgrep.kbd;; *) f=$MOCK_DIR/pgrep.router;; esac
      if [ ! -f "$f" ]; then
        for b in /usr/bin/pgrep /bin/pgrep; do [ -x $b ] && exec $b "$@"; done
        exit 1
      fi;;
    *) f=$MOCK_DIR/pgrep.out;;
  esac
  [ -s "$f" ] && { cat "$f"; exit 0; }; exit 1
fi
[ -s "$MOCK_DIR/pgrep.out" ] && { cat "$MOCK_DIR/pgrep.out"; exit 0; }; exit 1
