#!/bin/sh
# mock (1.6.2 ECM watchdog probe): never sends anything. Every call is logged to $MOCK_DIR/ping.calls. The fake usb0
# counters live in $MK20_NETDEV (/proc/net/dev format): the probe's ARP/echo "goes out" (usb0 TX +1, the host read it)
# unless $MOCK_DIR/ping.notx exists; $MOCK_DIR/ping.answer = the host answers (usb0 RX +1).
echo "$*" >> "$MOCK_DIR/ping.calls"
f=${MK20_NETDEV:-}
[ -n "$f" ] && [ -f "$f" ] || exit 1
tx=1; [ -f "$MOCK_DIR/ping.notx" ] && tx=0
rx=0; [ -f "$MOCK_DIR/ping.answer" ] && rx=1
exec 9>"$f.lock"; flock -x 9
awk -v tx="$tx" -v rx="$rx" '/^ *usb0:/ { sub(/^ *usb0:/, ""); $2 += rx; $10 += tx; print "  usb0: " $0; next } { print }' \
  "$f" > "$f.t.$$" && mv -f "$f.t.$$" "$f"
exit 0
