#!/bin/sh
# mock (ECM watchdog probe, 1.7.0): never sends anything. BusyBox forms: `ping -c 1 -W 1 HOST` (FEATURE_FANCY_PING) or
# `ping HOST`; rc 0 = an echo reply. 127.0.0.1 = the capability probe (answers, not logged). Every other call is logged
# to $MOCK_DIR/ping.calls (the host). The fake usb0 counters live in $MK20_NETDEV (/proc/net/dev format):
#   default            the ARP/echo "goes out" (usb0 TX +1: the host read it), nothing comes back (rc 1)
#   ping.notx          not even TX completes (the host does not read usb0)
#   ping.answer        the host answers: usb0 RX +1, rc 0
#   ping.rxonly        frames arrive (usb0 RX +1) but no echo reply (rc 1): e.g. a bare usb0 the Mac keeps ARPing
#   ping.nonfancy      a BusyBox without FEATURE_FANCY_PING: any option is a bad host (rc 1, no side effects)
for h in "$@"; do :; done
if [ -f "$MOCK_DIR/ping.nonfancy" ]; then case "$1" in -*) echo "ping: bad address '$1'" >&2; exit 1;; esac; fi
[ "$h" = 127.0.0.1 ] && exit 0
echo "$h" >> "$MOCK_DIR/ping.calls"
f=${MK20_NETDEV:-}
[ -n "$f" ] && [ -f "$f" ] || exit 1
tx=1; [ -f "$MOCK_DIR/ping.notx" ] && tx=0
rx=0; rc=1
[ -f "$MOCK_DIR/ping.answer" ] && { rx=1; rc=0; }
[ -f "$MOCK_DIR/ping.rxonly" ] && rx=1
exec 9>"$f.lock"; flock -x 9
awk -v tx="$tx" -v rx="$rx" '/^ *usb0:/ { sub(/^ *usb0:/, ""); $2 += rx; $10 += tx; print "  usb0: " $0; next } { print }' \
  "$f" > "$f.t.$$" && mv -f "$f.t.$$" "$f"
exit "$rc"
