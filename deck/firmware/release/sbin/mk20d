#!/bin/sh
# shellcheck disable=SC3043
# K4 release entry point. Boot starts only mk20-kbd (default-on); qt_app2 is STOP-ONLY.
# Crash loops latch minimal safe mode; ECM/adb remain up. Loader alone owns A/B rollback.
# mk20d kbd supervises with 1..30 s backoff and consumes MAINT-HOOKS.md requests.
# Restart after a Tina HID node re-bind may need a reboot to restore HID (RECOVERY.md).
# mk20d web supervises mk20-agent --web: the usb0 settings/maintenance web (FEATURE_WEB=1 default,
# http://<gadget.env MK20_ECM_IP>:8780) once composite is up and no gadget transition runs; the
# optional agent runtime joins that process only with FEATURE_AGENT=1 + kbd.sock. Run-level
# permission stays off; web/agent health is INFO/WARN only. Log /tmp/mk20/agent.log.
# Boot first puts /run/mk20 on a 512 KiB tmpfs (rootfs /run is the TF-card overlay); a failure is WARN only.
# 1.6.2: mk20d maint runs the ECM RX watchdog (host present + ECM active + usb0 RX frozen + probe -> one soft
# re-enumeration via gadget.sh --rearm-now, <= 3/h, then give up); on probation boot confirms only with proven
# host->device traffic when a host is present (ecm_gate). health usb.ecm_*; selftest INFO/WARN ecm line.
R=${MK20_ROOT:-}
REL=${MK20_REL:-$(cd "$(dirname "$0")/.." && pwd)}
V=${MK20_VERSION:-$(sed -n 's/^version=//p' "$REL/MANIFEST" 2>/dev/null)}
. "$REL/share/mk20lib.sh"
TM=$R/tmp/mk20; G=$R/sys/kernel/config/usb_gadget/g1; C=$G/configs/c.1
MOUNTS=${MK20_MOUNTS:-/proc/mounts}
mkdir -p "$TM" "$LOGDIR" "$MK20_HOME/state" 2>/dev/null
# Runtime state (health/selftest/gadget.env/maint inbox) is private to root: tighten only a real
# directory we own; never chmod through a symlink or someone else's directory.
[ -d "$TM" ] && [ ! -L "$TM" ] && [ -O "$TM" ] && chmod 700 "$TM" 2>/dev/null
log() { mk20log "$1" mk20d "$2" "v=$V" "$3"; }

p4sha() { [ -n "${MK20_P4_SHA:-}" ] && { echo "$MK20_P4_SHA"; return; }; [ -s "$TM/p4.sha" ] || sha256sum "$R/dev/by-name/boot" 2>/dev/null | cut -d' ' -f1 > "$TM/p4.sha"; cat "$TM/p4.sha"; }
kernel_line() { local p; p=$(p4sha); echo "$p" | grep -Eq '^[0-9a-f]{64}$' && awk -v p="$p" '$1==p && NF>=3 {print; exit}' "$MK20_HOME/kernel/ALLOWLIST" 2>/dev/null; }   # "<sha> <name> <features>"
kernel_has() { case ",$(kernel_line | cut -d' ' -f3)," in *",$1,"*) return 0;; esac; return 1; }
shim_mounted() { # $1=path: our KD shim (a tmpfs file bind-mounted exactly on a known vendor path)
  case "$1" in /data/appLunch.sh|/data/setusbconfig) ;; *) return 1;; esac
  awk -v f="$1" '$2==f && $3=="tmpfs" {ok=1} END{exit !ok}' "$MOUNTS" 2>/dev/null; }
# /run/mk20 (kbd.status rewritten 1/s by mk20-kbd's main loop, kbd.sock, pair-code, agent.status) sits on the TF-card
# overlay unless boot mounts a small tmpfs there: no TF wear, no TF stall in the e-stop/HID loop, nothing survives reboot.
RUNDIR=$R/run/mk20
fs_at() { # $1=canonical path -> "<fstype> <mountpoint>" holding it (longest mountpoint prefix; a later stacked entry wins)
  # /proc/mounts octal-escapes spaces (\040); fine here: only the fixed path $R/run/mk20 is ever looked up.
  awk -v p="$1" 'BEGIN{n=-1} {m=$2; if (m=="/" || p==m || index(p, m "/")==1) if (length(m) >= n) {n=length(m); r=$3 " " m}}
    END{if (r!="") print r}' "$MOUNTS" 2>/dev/null; }
run_fs() { local c; c=$(cd "$RUNDIR" 2>/dev/null && pwd -P) && fs_at "$c"; }   # mount points are canonical paths
run_tmpfs() { [ "$(run_fs | cut -d' ' -f1)" = tmpfs ]; }
run_report() { # INFO/WARN only, never part of the confirm decision
  local t; t=$(run_fs | cut -d' ' -f1)
  if [ "$t" = tmpfs ]; then echo "INFO /run/mk20 on tmpfs"; else echo "WARN /run/mk20 not on tmpfs (${t:-unknown})"; fi; }
run_mount() { # boot only, before any writer starts. Every refusal/failure is WARN + continue (status works on the overlay).
  local c fs t out rc
  [ -L "$RUNDIR" ] && { log WARN boot "run tmpfs: $RUNDIR is a symlink, not mounted"; return 0; }
  mkdir -p "$RUNDIR" 2>/dev/null
  c=$(cd "$RUNDIR" 2>/dev/null && pwd -P) || { log WARN boot "run tmpfs: no $RUNDIR"; return 0; }
  fs=$(fs_at "$c"); t=${fs%% *}; t=${t:-unknown}
  [ "$t" = tmpfs ] && { log INFO boot "run tmpfs: already ($fs)"; return 0; }   # mk20d re-run, or a tmpfs /run: never stack
  [ "${fs#* }" = "$c" ] && { log WARN boot "run tmpfs: $c already has a $t mount, left alone"; return 0; }
  # stale files from earlier boots are simply hidden; a live writer (bound kbd.sock) must never be hidden
  # a supervisor in backoff holds its lock and may start its child right after a pgrep: check the locks too (TOCTOU)
  if kbd_running || agent_running || lock_held "$TM/kbd.lock" || lock_held "$TM/agent.lock"; then
    log WARN boot "run tmpfs: mk20-kbd/web already running, not mounted"; return 0; fi
  out=$(mount -t tmpfs -o size=512k,mode=0755,nosuid,nodev,noexec tmpfs "$c" 2>&1); rc=$?
  if [ $rc = 0 ]; then log INFO boot "run tmpfs: mounted on $c (was $t)"
  else log WARN boot "run tmpfs: mount rc=$rc ($(printf '%s\n' "$out" | head -n 1 | cut -c1-120)); stays on $t"; fi
  return 0; }
vendor_check() { # prints "ok" or the first mismatch; all 4 vendor entries must be present and checked
  local h f n; n=0
  while read -r h f || [ -n "$h" ]; do
    [ -n "$h" ] || continue
    n=$((n+1))
    shim_mounted "$f" && continue
    [ "$(sha256sum "$R$f" 2>/dev/null | cut -d' ' -f1)" = "$h" ] || { echo "mismatch:$f"; return 1; }
  done < "$REL/share/vendor.sha256"
  [ "$n" -ge 4 ] || { echo "vendor list incomplete ($n)"; return 1; }
  echo ok
}
num() { case "$1" in ''|*[!0-9]*) echo 0;; *) echo "$1";; esac; }
mtime() { date -r "$1" +%s 2>/dev/null; }   # device BusyBox has no stat applet (K4 rc2 install: every age = now)
nlinks() { ls -ld "$1" 2>/dev/null | awk '{print $2}'; }
kd_count() { pgrep -f '^/data/KeyboardDevice' | wc -l | tr -d ' '; }   # not -x: BusyBox 1.27 -x never matches KD (1.0.3 field failure)
composite_up() { [ -e "$C/ecm.usb0" ]; }
listening() { netstat -ltn 2>/dev/null | awk -v a="$1" '$4==a {ok=1} END{exit !ok}'; }   # exact local address
lock_held() { ( exec 5>"$1"; ! flock -n 5 ) 2>/dev/null; }   # a live instance holds the lock
router_running() { pgrep -f 'bin/mk20-router --src' >/dev/null; }
kbd_running() { pgrep -f 'bin/mk20-kbd --run' >/dev/null; }
AST=${MK20_AGENT_STATUS:-$R/run/mk20/agent.status}
ASOCK=${MK20_AGENT_KBD_SOCK:-$R/run/mk20/kbd.sock}
agent_running() { pgrep -f "$REL/bin/mk20-agent --web" >/dev/null; }
web_ip() { # usb0 address applied at boot (mk20d wrote gadget.env), device .2 only; empty if none
  local f ip; f=$TM/gadget.env
  [ -f "$f" ] && [ ! -L "$f" ] && [ "$(wc -c < "$f")" -le 1024 ] || return 0
  ip=$(sed -n 's/^MK20_ECM_IP=//p' "$f" | head -n 1)
  case "$ip" in *.2) v_ip4 "$ip" && echo "$ip";; esac
  return 0; }
web_wanted() { [ "$FEATURE_WEB" = 1 ] || [ "$FEATURE_AGENT" = 1 ]; }
web_report() { # INFO/WARN only: the web is never part of the confirm decision
  local ip
  web_wanted || { echo "INFO web disabled"; return 0; }
  composite_up || { echo "INFO web waits for composite"; return 0; }
  ip=$(web_ip)
  if agent_running; then echo "INFO web running${ip:+ (http://$ip:8780)}"; else echo "WARN web not running${ip:+ (http://$ip:8780)}"; fi
  [ "$FEATURE_AGENT" = 1 ] || [ "$(agent_recent)" -lt 3 ] || echo "WARN web crash loop (3+ exits in 300s)"
  return 0; }
active_slot() { # loader A/B pointer holding this release (highest generation)
  local s g v best bg; best=""; bg=-1
  for s in A B; do
    v=$(sed -n 's/^version=//p' "$MK20_HOME/slots/$s" 2>/dev/null | head -n 1)
    g=$(num "$(sed -n 's/^gen=//p' "$MK20_HOME/slots/$s" 2>/dev/null | head -n 1)")
    [ -n "$V" ] && [ "$v" = "$V" ] && [ "$g" -gt "$bg" ] && { best=$s; bg=$g; }
  done
  echo "$best"; }
agent_recent() {
  local now count; now=$(cut -d. -f1 /proc/uptime)
  count=$(awk -v n="$now" '$1 ~ /^[0-9]+$/ && n >= $1 && n - $1 < 300 {c++} END{print c+0}' "$TM/agent-crash.times" 2>/dev/null)
  num "$count"; }
agent_status_load() {
  local k v
  AALLOWED=null; ASTATE=unknown; APROVIDER=unknown; AROUTE=unknown; AERROR=unknown
  [ -f "$AST" ] && [ ! -L "$AST" ] && [ "$(wc -c < "$AST")" -le 4096 ] || return 0
  while IFS='=' read -r k v; do
    case "$k" in allowed) AALLOWED=$v;; state) ASTATE=$v;; provider) APROVIDER=$v;; route) AROUTE=$v;; last_error_class) AERROR=$v;; esac
  done <<EOT
$(LC_ALL=C awk -f "$REL/share/mk20-agent-status.awk" "$AST" 2>/dev/null)
EOT
}
agent_report() { # Always INFO/WARN, never changes the selftest result or prints raw status.
  local age
  if [ "$FEATURE_AGENT" != 1 ]; then echo "INFO agent disabled"; return 0; fi
  agent_running && echo "INFO agent running" || echo "WARN agent not running"
  [ "$(agent_recent)" -lt 3 ] || echo "WARN agent crash loop (3+ exits in 300s)"
  if [ ! -f "$AST" ] || [ -L "$AST" ]; then echo "WARN agent status missing"
  else
    age=$(( $(date +%s) - $(num "$(mtime "$AST")") ))
    if [ "$age" -gt "${MK20_AGENT_STATUS_MAX_AGE:-10}" ] || [ "$age" -lt 0 ]; then echo "WARN agent status stale"
    else agent_status_load; [ "$ASTATE" != unknown ] || echo "WARN agent status unknown"; fi
  fi
  return 0
}
KDSVC=${MK20_KDSVC:-/etc/init.d/qt_app2}   # procd service: `stop` also stops the respawn (plain kill -> respawned)
KST=$R/run/mk20/kbd.status
kbd_wanted() { [ "$FEATURE_KBD" = 1 ]; }
probation() { [ -n "$V" ] && [ "$(cat "$MK20_HOME/state/pending" 2>/dev/null)" = "$V" ]; }
kbd_recent() { # mk20-kbd exits within the crash window (uptimes in $TM/kbd-crash.times)
  local now; now=$(cut -d. -f1 /proc/uptime)
  awk -v n="$now" -v w="${MK20_KBD_CRASH_WINDOW:-300}" '$1 ~ /^[0-9]+$/ && n >= $1 && n - $1 <= w {c++} END{print c+0}' "$TM/kbd-crash.times" 2>/dev/null || echo 0; }
kbd_total() { num "$(sed -n 's/^total=\([0-9]*\).*/\1/p' "$TM/kbd.crashes" 2>/dev/null)"; }
jnum() { num "$(sed -n "s/.*\"$1\": *\([0-9]*\).*/\1/p" "$KST" 2>/dev/null | head -n 1)"; }
# mk20-kbd problems: FAIL on probation (no confirm -> loader rolls back to the previous release), WARN once confirmed
# (a confirmed release keeps its composite/OTA path).
kbd_bad() { if probation; then echo "FAIL $1"; else echo "WARN $1"; fi; }
kbd_status_check() { # PASS/FAIL|WARN lines for the mk20-kbd status file; rc 0 = healthy
  local age kn fr pw rc; rc=0
  [ -f "$KST" ] || { kbd_bad "kbd status missing ($KST)"; return 1; }
  age=$(( $(date +%s) - $(num "$(mtime "$KST")") ))
  # age is wall clock (mtime), which jumps with clock sets (no RTC): the uptime lets a stale sample be lined up with mk20d.log
  [ $age -ge 0 ] && [ $age -le "${MK20_KBD_STATUS_MAX_AGE:-10}" ] && echo "PASS kbd status fresh (${age}s)" ||
    { kbd_bad "kbd status stale (${age}s, up $(cut -d. -f1 /proc/uptime)s)"; rc=1; }
  kn=$(jnum knob_ok); fr=$(( $(jnum key_events) + $(jnum knob_events) + $(jnum echo_frames) + $(jnum other_frames) ))
  if [ "$kn" = 6 ] || [ $fr -gt 0 ]; then echo "PASS kbd gd32 knob_ok=$kn frames=$fr"; else kbd_bad "kbd gd32 silent (knob_ok=$kn frames=$fr)"; rc=1; fi
  pw=$(jnum panels_written)
  [ "$pw" = 21 ] && echo "PASS kbd panels 21/21" || { kbd_bad "kbd panels $pw/21"; rc=1; }
  [ "$(jnum write_errors)" = 0 ] || { kbd_bad "kbd panel write errors"; rc=1; }
  return $rc; }
kd_svc() { [ "$1" = stop ] || return 1; if [ -x "$KDSVC" ]; then "$KDSVC" stop >>"$TM/kbd.log" 2>&1 5>&-; else log WARN kbd "no $KDSVC for $1"; return 1; fi; }
# Persistent latch/settings + two bounded, fixed-name request inboxes. Never source/eval hook data.
MP=$MK20_HOME/state/maint; MR=$TM/maint
kbd_mode() { if [ -f "$MP/safe" ] || grep -q '"mode": *"safe"' "$KST" 2>/dev/null; then echo safe; else echo normal; fi; }
maint_init() {
  [ ! -L "$MP" ] && [ ! -L "$MR" ] || return 1
  mkdir -p "$MP" "$MR" && chmod 700 "$MP" "$MR"
}
# mv without -T can descend into a destination directory (including a symlink).
# In these private inboxes, unlink only files/symlinks and require an absent exact target.
maint_dest_clear() {
  if [ -L "$1" ] || [ -f "$1" ]; then rm -f "$1" || return 1
  elif [ -e "$1" ]; then return 1; fi
  [ ! -e "$1" ] && [ ! -L "$1" ]
}
# Preserve atomic replacement of an existing regular snapshot/config file.
maint_replace() {
  if [ -L "$2" ]; then rm -f "$2" || return 1
  elif [ -e "$2" ] && [ ! -f "$2" ]; then return 1; fi
  mv -f "$1" "$2"
}
# The request may be on tmpfs. Stage on the persistent filesystem so the
# final replace is always a local atomic rename, even for runtime debug hooks.
debug_store() {
  ( umask 077
    tmp=$(mktemp "$MP/.debug.XXXXXX") || exit 1
    trap 'rm -f "$tmp"' 0
    cat "$1" > "$tmp" && chmod 600 "$tmp" && sync &&
      maint_replace "$tmp" "$MP/debug.conf" )
}
# Rename first, then inspect the claimed inode. Never read/chmod a symlink or hard link.
hook_take() { # $1=trusted inbox $2=fixed basename; sets HF
  HF=$1/.$2.consume
  [ -e "$1/$2" ] || [ -L "$1/$2" ] || return 1
  if [ ! -L "$1/$2" ] && [ -d "$1/$2" ]; then return 1; fi
  maint_dest_clear "$HF" || return 1
  mv -f "$1/$2" "$HF" 2>/dev/null || return 1
  if [ -L "$HF" ] || [ ! -f "$HF" ] || [ "$(nlinks "$HF")" != 1 ] || [ "$(wc -c < "$HF")" -gt 128 ]; then
    rm -f "$HF"; log WARN maint "invalid hook"; return 1
  fi
}
debug_read() { # complete replacement, one allow-listed boolean; no key/event tracing
  DEBUG_VERBOSE=0
  [ ! -L "$MP/debug.conf" ] && [ -f "$MP/debug.conf" ] || return 0
  [ "$(wc -c < "$MP/debug.conf")" -le 128 ] || return 0
  case "$(cat "$MP/debug.conf")" in verbose=1) DEBUG_VERBOSE=1;; esac
}
kbd_state() {
  ( umask 077
    tmp=$(mktemp "$MR/.state.XXXXXX") || exit 1
    trap 'rm -f "$tmp"' 0
    printf '{"mode":%s,"restarts":%s,"recent_crashes":%s,"last_rc":%s,"reason":%s,"version":%s}\n' \
      "$(jstr "$(kbd_mode)")" "$(kbd_total)" "$(num "$(kbd_recent)")" "$(num "${last_rc:-0}")" \
      "$(jstr "$reason")" "$(jstr "$V")" > "$tmp" &&
      chmod 444 "$tmp" && maint_replace "$tmp" "$MR/state.json" )
}
kbd_hooks() {
  restart=0
  for inbox in "$MP" "$MR"; do
    for hook in debug restart-kbd exit-safe-mode; do
      hook_take "$inbox" "$hook" || continue
      case "$hook" in
        debug)
          case "$(cat "$HF")" in
            verbose=0|verbose=1) debug_store "$HF";;
            *) log WARN maint "invalid debug hook";;
          esac;;
        restart-kbd|exit-safe-mode)
          if [ ! -s "$HF" ]; then
            restart=1
            if [ "$hook" = exit-safe-mode ]; then
              rm -f "$MP/safe" "$KST" "$TM/kbd-crash.times"
              reason=normal; d=1
            fi
          else log WARN maint "invalid command hook"; fi;;
      esac
      rm -f "$HF"
    done
  done
}
kbd_child_stop() { # our own unreaped child only; bounded graceful stop
  kill -TERM "$child" 2>/dev/null
  i=0; while kill -0 "$child" 2>/dev/null && [ $i -lt 15 ]; do sleep 0.2 5>&-; i=$((i+1)); done
  if kill -0 "$child" 2>/dev/null; then
    kill -KILL "$child" 2>/dev/null
    i=0; while kill -0 "$child" 2>/dev/null && [ $i -lt 10 ]; do sleep 0.2 5>&-; i=$((i+1)); done
    kill -0 "$child" 2>/dev/null && return 1
  fi
  return 0
}
wdt_armed() { ${MK20_UBUS:-ubus} call system watchdog 2>/dev/null | grep -q '"running"'; }

# ---- 1.6.2 ECM RX watchdog (mk20d maint) + probation confirm gate (boot) ----
# Incident 2026-10-23 23:07: after a reboot host->device was dead (gadget configured, usb0 carrier 1, usb0 RX frozen at
# 1 packet while the Mac kept sending), yet the selftest passed and the release was confirmed; a watcher hardreset
# fixed it. The fault is proven when the host is present and awake (UDC "configured": a sleeping Mac suspends the bus,
# an unplugged/charger port is not configured), its ECM driver runs the data interface (usb0 carrier 1), usb0 RX has
# not grown for ECM_STALL_S, and a probe shows the host reads the device but nothing it sends arrives: ping (ARP
# first) toward the host addresses makes usb0 TX grow - u_ether counts a TX packet only when its IN transfer
# completed, i.e. the host polled the bulk IN endpoint - while usb0 RX stays put. A healthy host answers the ARP in
# milliseconds; a host that does not read usb0 completes no TX (no action). Action: gadget.sh --rearm-now (ONE soft
# re-enumeration under the transition mutex; flapmon/install/rollback/adb rules there), at most ECM_REARM_MAX per
# ECM_REARM_WIN s, then give up for this boot (health usb.ecm_gave_up, selftest WARN). FAT mk20-no-ecm-rearm:
# observe and report only. State (this boot): $TM/ecm.state; health/selftest only read it.
ECM_ST=$TM/ecm.state
NETDEV=${MK20_NETDEV:-/proc/net/dev}; ARPF=${MK20_ARP:-/proc/net/arp}
ecm_k() { case "$1" in ''|*[!0-9]*) echo "$2";; *) if [ ${#1} -le 5 ] && [ "$1" -ge "$3" ] && [ "$1" -le "$4" ]; then echo "$1"; else echo "$2"; fi;; esac; }
ecm_init() {
  [ "${ECM_INIT:-}" = 1 ] && return 0; ECM_INIT=1
  ECM_STALL_S=$(ecm_k "${MK20_ECM_STALL_S:-}" 60 1 3600)        # usb0 RX frozen this long before a probe
  ECM_PROBE_S=$(ecm_k "${MK20_ECM_PROBE_S:-}" 8 1 60)           # probe window (> the 5 s ARP delay of a stale entry)
  ECM_GATE_WAIT_S=$(ecm_k "${MK20_ECM_GATE_WAIT_S:-}" 90 0 300) # gate: wait out a busy re-arm (flap window, transition)
  ECM_RECONF_S=$(ecm_k "${MK20_ECM_RECONF_S:-}" 30 1 120)       # gate: the host configures the re-enumerated device
  ECM_REARM_MAX=3; ECM_REARM_WIN=3600
}
ecm_up() { if [ -n "${MK20_UPTIME_CMD:-}" ]; then num "$($MK20_UPTIME_CMD)"; else cut -d. -f1 /proc/uptime; fi; }
udc_state() { local u; u=$(cat "$G/UDC" 2>/dev/null); case "$u" in ''|*/*|.*) return 0;; esac; head -n 1 "$R/sys/class/udc/$u/state" 2>/dev/null; }
usb0_carrier() { [ "$(cat "$R/sys/class/net/usb0/carrier" 2>/dev/null)" = 1 ]; }
ecm_counts() { # "rx_packets tx_packets" of usb0, empty if absent (/proc/net/dev: rx = field 2, tx = field 10)
  sed -n 's/^ *usb0://p' "$NETDEV" 2>/dev/null | awk 'NR==1 && NF>=10 && $2 ~ /^[0-9]+$/ && $10 ~ /^[0-9]+$/ {print $2, $10}'; }
ecm_hosts() { # host IPv4s to probe: learned on usb0 (ARP), the subnet's .1, the link-local .1 (at most 4)
  { awk 'NR>1 && $6=="usb0" && $3!="0x0" && $1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ {print $1}' "$ARPF" 2>/dev/null
    echo "${ECM_HOST_IP:-}"; echo "${MK20_LL_HOST_IP:-169.254.7.1}"; } | awk 'NF && !s[$0]++' | head -n 4; }
ecm_probe() { # $1 rx $2 tx at the start: ping (ARP first) the host addresses <= ECM_PROBE_S s, stop early when usb0 RX
  # grows or the host leaves; EP_RX/EP_TX = last counts; rc 0 = RX grew (the host answered or sent anything)
  local pids h i c; pids=""; EP_RX=$1; EP_TX=$2
  for h in $(ecm_hosts); do ping "$h" </dev/null >/dev/null 2>&1 5>&- & pids="$pids $!"; done
  i=0; while [ "$i" -lt $((ECM_PROBE_S * 4)) ]; do
    sleep 0.25 5>&-; i=$((i + 1))
    c=$(ecm_counts); [ -n "$c" ] && { EP_RX=${c% *}; EP_TX=${c#* }; }
    [ "$EP_RX" != "$1" ] && break
    [ "$(udc_state)" = configured ] || break
  done
  for h in $pids; do kill "$h" 2>/dev/null; done; for h in $pids; do wait "$h" 2>/dev/null; done
  [ "$EP_RX" != "$1" ]; }
ecm_load() { # whitelisted key=value state; anything unexpected is ignored (defaults)
  local k v
  ES_STATE=idle; ES_RX=; ES_SINCE=; ES_STALLS=0; ES_REARMS=0; ES_RECOV=0; ES_PROBES=0; ES_GAVEUP=0; ES_EPISODE=0; ES_EPRA=0
  ES_TIMES=; ES_KEV=; ES_NOTE=
  [ -f "$ECM_ST" ] && [ ! -L "$ECM_ST" ] && [ "$(wc -c < "$ECM_ST")" -le 1024 ] || return 0
  while IFS='=' read -r k v; do
    case "$k" in
      state) case "$v" in idle|absent|suspended|inactive|ok|host-idle|stalled|gave-up) ES_STATE=$v;; esac;;
      rx) case "$v" in ''|*[!0-9]*) ;; *) ES_RX=$v;; esac;;
      since) case "$v" in ''|*[!0-9]*) ;; *) ES_SINCE=$v;; esac;;
      stalls) ES_STALLS=$(num "$v");; rearms) ES_REARMS=$(num "$v");; recoveries) ES_RECOV=$(num "$v");;
      probes) ES_PROBES=$(num "$v");; ep_rearms) ES_EPRA=$(num "$v");; kev) ES_KEV=$(num "$v");;
      gave_up) [ "$v" = 1 ] && ES_GAVEUP=1;; episode) [ "$v" = 1 ] && ES_EPISODE=1;;
      times) echo "$v" | grep -Eq '^[0-9]+( [0-9]+){0,7}$' && ES_TIMES=$v;;
      note) case "$v" in *[!a-z]*) ;; *) ES_NOTE=$v;; esac;;
    esac
  done < "$ECM_ST"; }
ecm_save() {
  ( umask 077; t=$(mktemp "$TM/.ecm.XXXXXX") || exit 1
    printf 'state=%s\nrx=%s\nsince=%s\nstalls=%s\nrearms=%s\nrecoveries=%s\nprobes=%s\ngave_up=%s\nepisode=%s\nep_rearms=%s\ntimes=%s\nkev=%s\nnote=%s\n' \
      "$ES_STATE" "$ES_RX" "$ES_SINCE" "$ES_STALLS" "$ES_REARMS" "$ES_RECOV" "$ES_PROBES" "$ES_GAVEUP" "$ES_EPISODE" "$ES_EPRA" \
      "$ES_TIMES" "$ES_KEV" "$ES_NOTE" > "$t" && mv -f "$t" "$ECM_ST" || { rm -f "$t"; exit 1; } ); }
ecm_note() { [ "$ES_NOTE" = "$1" ] && return 0; ES_NOTE=$1; log "$2" ecm "$3"; }   # once per episode and reason
ecm_episode_end() { # usb0 RX grew while a stall episode was open
  [ "$ES_EPISODE" = 1 ] || return 0
  if [ "$ES_EPRA" -gt 0 ]; then ES_RECOV=$((ES_RECOV + 1)); log INFO ecm "host->device traffic back after $ES_EPRA re-arm(s) (usb0 rx $1)"
  else log INFO ecm "host->device traffic back without a re-arm (usb0 rx $1)"; fi
  ES_EPISODE=0; ES_EPRA=0; ES_NOTE=; [ "$ES_STATE" = gave-up ] && ES_STATE=ok; return 0; }
ecm_rearm_try() { # $1 watchdog|gate, $2 1 = keyboard in use (defer). ER_RC: gadget.sh --rearm-now rc, 4 deferred, 7 off
  local now n t keep gen
  now=$(ecm_up)
  if [ -f "$S/mk20-no-ecm-rearm" ]; then ER_RC=7; ecm_note disabled INFO "re-arm disabled by FAT mk20-no-ecm-rearm: observe only"; return 0; fi
  [ "$ES_GAVEUP" = 1 ] && { ER_RC=7; return 0; }
  n=0; keep=""; for t in $ES_TIMES; do [ $((now - t)) -lt "$ECM_REARM_WIN" ] && { n=$((n + 1)); keep="$keep $t"; }; done; ES_TIMES=${keep# }
  if [ "$n" -ge "$ECM_REARM_MAX" ]; then
    ES_GAVEUP=1; ES_STATE=gave-up; ER_RC=7
    log ERROR ecm "host->device still dead after $n re-arms within ${ECM_REARM_WIN}s: giving up until reboot (watcher cmd-reboot recovers)"
    return 0; fi
  if [ "${2:-0}" = 1 ]; then ER_RC=4; ecm_note typing INFO "re-arm deferred: keyboard in use"; return 0; fi
  [ -f "$TM/gadget-boot.sh" ] || { ER_RC=6; ecm_note na WARN "re-arm impossible: no $TM/gadget-boot.sh"; return 0; }
  gen=$(head -n 1 "$TM/composite.gen" 2>/dev/null)
  MK20_GEN=$gen MK20_REL=$REL MK20_GADGET_LOG=$LOGDIR/gadget.log sh "$TM/gadget-boot.sh" --rearm-now </dev/null >> "$LOGDIR/gadget.log" 2>&1 5>&- 6>&- 7>&- 8>&- 9>&-
  ER_RC=$?
  case "$ER_RC" in
    0|1|2|3) ES_REARMS=$((ES_REARMS + 1)); ES_EPRA=$((ES_EPRA + 1)); ES_TIMES="${ES_TIMES:+$ES_TIMES }$now"; ES_NOTE=
      log WARN ecm "re-arm #$ES_REARMS ($1): gadget.sh --rearm-now rc=$ER_RC$([ "$ER_RC" = 0 ] && echo ' (re-enumerated)')";;
    4) ecm_note busy INFO "re-arm deferred: gadget.sh busy (rc 4, reason in gadget.log)";;
    5) ecm_note stale INFO "re-arm skipped: stale composite generation (rc 5)";;
    *) ecm_note na WARN "re-arm not applicable (rc $ER_RC, reason in gadget.log): observe only";;
  esac; }
ecm_tick() { # one watchdog step (mk20d maint, every ECM_TICK_S); logs only on changes
  local now c rx tx st kev typing age
  ecm_init; ecm_load; now=$(ecm_up)
  kev=$(jnum key_events); typing=0; [ -n "$ES_KEV" ] && [ "$kev" != "$ES_KEV" ] && typing=1; ES_KEV=$kev
  c=$(ecm_counts); rx=${c% *}; tx=${c#* }
  if [ -z "$c" ]; then ES_STATE=idle; ES_RX=; ES_SINCE=$now; ecm_save; return 0; fi
  if [ -z "$ES_RX" ] || [ -z "$ES_SINCE" ] || [ "$rx" -lt "$ES_RX" ]; then ES_RX=$rx; ES_SINCE=$now   # (re)baseline
  elif [ "$rx" -gt "$ES_RX" ]; then ecm_episode_end "$rx"; ES_RX=$rx; ES_SINCE=$now; fi
  if ! composite_up || [ ! -f "$TM/gadget.env" ] || [ -f "$TM/gadget.busy" ]; then ES_STATE=idle; ES_SINCE=$now; ecm_save; return 0; fi
  st=$(udc_state)
  if [ "$st" != configured ] || ! usb0_carrier; then   # no host / asleep / ECM not enabled by the host
    case "$st" in suspended) ES_STATE=suspended;; configured) ES_STATE=inactive;; *) ES_STATE=absent;; esac
    ES_SINCE=$now; ecm_save; return 0; fi   # the window starts again once the host is back
  age=$((now - ES_SINCE))
  if [ "$age" -lt "$ECM_STALL_S" ]; then
    if [ "$ES_EPISODE" != 1 ]; then ES_STATE=ok; elif [ "$ES_GAVEUP" != 1 ]; then ES_STATE=stalled; else ES_STATE=gave-up; fi
    ecm_save; return 0; fi
  ES_PROBES=$((ES_PROBES + 1))
  if ecm_probe "$rx" "$tx"; then ecm_episode_end "$EP_RX"; ES_STATE=ok; ES_RX=$EP_RX; ES_SINCE=$(ecm_up); ecm_save; return 0; fi
  ES_RX=$EP_RX; ES_SINCE=$(ecm_up)   # the next probe after another window
  [ "$(udc_state)" = configured ] || { ecm_save; return 0; }                             # the host left meanwhile
  if [ "$EP_TX" = "$tx" ]; then [ "$ES_EPISODE" = 1 ] || ES_STATE=host-idle; ecm_save; return 0; fi   # host not reading
  if [ "$ES_EPISODE" != 1 ]; then
    ES_EPISODE=1; ES_EPRA=0; ES_NOTE=; ES_STALLS=$((ES_STALLS + 1))
    log WARN ecm "host->device stall #$ES_STALLS: usb0 rx $rx frozen ${age}s (udc configured, carrier 1); probe tx +$((EP_TX - tx)) rx +0"
  fi
  ES_STATE=stalled
  ecm_rearm_try watchdog "$typing"   # after a give-up: ER_RC 7, nothing touched (observe and report only)
  [ "$ES_GAVEUP" = 1 ] && ES_STATE=gave-up
  ecm_save; }
ecm_gate() { # probation confirm gate: prints its result line; rc 1 = FAIL (no confirm -> the loader rolls back)
  local st c rx tx w
  ecm_init; ecm_load
  composite_up && [ -f "$TM/gadget.env" ] || { echo "INFO ecm gate: no composite"; return 0; }
  st=$(udc_state)
  [ "$st" = configured ] || { echo "INFO ecm gate skipped: no host (udc ${st:-unbound}: asleep, unplugged or charger)"; return 0; }
  usb0_carrier || { echo "INFO ecm gate skipped: host has not enabled ECM (usb0 carrier 0)"; return 0; }
  c=$(ecm_counts); [ -n "$c" ] || { echo "FAIL ecm gate: no usb0 counters"; return 1; }
  rx=${c% *}; tx=${c#* }
  if ecm_probe "$rx" "$tx"; then
    ES_STATE=ok; ES_RX=$EP_RX; ES_SINCE=$(ecm_up); ecm_save; echo "PASS ecm host traffic (usb0 rx $rx -> $EP_RX)"; return 0; fi
  st=$(udc_state)
  [ "$st" = configured ] || { echo "INFO ecm gate skipped: host left during the probe (udc ${st:-unbound})"; return 0; }
  if [ "$EP_TX" = "$tx" ]; then echo "WARN ecm gate: host not reading usb0 (rx $rx, tx $tx unchanged in ${ECM_PROBE_S}s)"; return 0; fi
  ES_EPISODE=1; ES_EPRA=0; ES_NOTE=; ES_STALLS=$((ES_STALLS + 1)); ES_STATE=stalled
  log WARN ecm "gate: host->device stall #$ES_STALLS: usb0 rx $rx frozen (udc configured, carrier 1); probe tx +$((EP_TX - tx)) rx +0"
  w=0; while :; do
    ecm_rearm_try gate 0
    [ "$ER_RC" = 4 ] && [ "$w" -lt "$ECM_GATE_WAIT_S" ] || break
    sleep 5; w=$((w + 5))
  done
  ecm_save
  [ "$ER_RC" = 0 ] || { echo "FAIL ecm host->device dead: usb0 rx $rx frozen while the host reads usb0 (re-arm rc=$ER_RC)"; return 1; }
  w=0; while { [ "$(udc_state)" != configured ] || ! usb0_carrier; } && [ "$w" -lt "$ECM_RECONF_S" ]; do sleep 1; w=$((w + 1)); done
  c=$(ecm_counts); rx=${c% *}; tx=${c#* }
  if [ -n "$c" ] && [ "$(udc_state)" = configured ] && ecm_probe "$rx" "$tx"; then
    ecm_episode_end "$EP_RX"; ES_STATE=ok; ES_RX=$EP_RX; ES_SINCE=$(ecm_up); ecm_save
    echo "PASS ecm host traffic after re-arm (usb0 rx $rx -> $EP_RX)"; return 0; fi
  ES_RX=${EP_RX:-$rx}; ES_SINCE=$(ecm_up); ecm_save
  echo "FAIL ecm host->device dead after re-arm (udc $(udc_state), usb0 rx ${rx:-?})"; return 1; }
ecm_report() { # selftest INFO/WARN only (never FAIL: on probation the boot gate decides)
  local c st
  composite_up || return 0
  ecm_init; ecm_load; c=$(ecm_counts); st=$(udc_state)
  if [ "$ES_EPISODE" = 1 ] && [ "$ES_GAVEUP" = 1 ] && [ "$ES_STATE" = gave-up ]; then
    echo "WARN ecm host->device stalled: gave up after $ES_REARMS re-arm(s) (max $ECM_REARM_MAX per hour; reboot via watcher cmd-reboot)"
  elif [ "$ES_EPISODE" = 1 ] && [ "$ES_STATE" = stalled ]; then
    echo "WARN ecm host->device stalled (usb0 rx ${c%% *} frozen; $ES_EPRA re-arm(s) so far)"
  elif [ "$ES_GAVEUP" = 1 ]; then echo "INFO ecm re-arm off for this boot (gave up after $ES_REARMS re-arms)"
  elif [ "$ES_STALLS" -gt 0 ]; then echo "INFO ecm host->device stalls $ES_STALLS, re-arms $ES_REARMS, recovered $ES_RECOV"
  elif [ -n "$c" ]; then echo "INFO ecm usb0 rx ${c%% *} tx ${c##* } (udc ${st:-unbound})"; fi
  return 0; }

selftest() { # FAIL = host-independent breakage. KD is forbidden in every mode. The link-local rescue listener is
  # mandatory (1.1.0): it is the subnet-independent path, so a release that loses it must not be confirmed.
  local f n; f=0
  if [ "$FEATURE_KBD" = 1 ] || [ -f "$TM/kbd.mode" ]; then   # mk20-kbd replaces stock KD: KD must be gone, mk20-kbd alive and healthy
    local kr kt kl
    n=$(kd_count); [ "$n" = 0 ] && echo "PASS kd=0 (mk20-kbd mode)" || { echo "FAIL kd=$n beside mk20-kbd"; f=1; }   # double writer: always FAIL
    kl=$( { kbd_running && echo "PASS mk20-kbd running" || kbd_bad "mk20-kbd not running"; kbd_status_check
      [ "$(kbd_mode)" = safe ] && echo "WARN mk20-kbd safe mode (admin: http://$ECM_IP:8780)"
      kr=$(kbd_recent); kt=$(kbd_total)
      if [ "$kr" -ge "${MK20_KBD_CRASHES:-3}" ]; then echo "WARN mk20-kbd crash loop: $kr exits in ${MK20_KBD_CRASH_WINDOW:-300}s ($kt total)"
      elif [ "$kt" -gt 0 ]; then echo "INFO mk20-kbd restarted $kt times"; fi
      [ "$kt" -gt 0 ] && grep -q '"hid_open": *0[,}]' "$KST" 2>/dev/null && echo "WARN hidg0 not open after mk20-kbd restart (f_hid re-bind quirk: reboot clears it)"; } )
    echo "$kl"; echo "$kl" | grep -q '^FAIL' && f=1
  else
    n=$(kd_count); [ "$n" = 0 ] && echo "PASS kd=0 (developer kbd opt-out)" || { echo "FAIL kd=$n (stock KD forbidden)"; f=1; }
    echo "INFO mk20-kbd disabled (developer only; panels unpainted)"
  fi
  [ -n "$(cat "$G/UDC" 2>/dev/null)" ] && echo "PASS udc bound" || { echo "FAIL udc unbound"; f=1; }
  [ -e "$R/dev/ttyGS0" ] && echo "PASS ttyGS0" || { echo "FAIL no ttyGS0"; f=1; }
  wdt_armed && echo "PASS watchdog armed" || { echo "FAIL watchdog not armed"; f=1; }
  if composite_up; then
    listening "$ECM_IP:$BRIDGE_PORT" && echo "PASS bridge $ECM_IP:$BRIDGE_PORT" || { echo "FAIL bridge not on $ECM_IP:$BRIDGE_PORT"; f=1; }
    listening "${MK20_LL_IP:-169.254.7.2}:$BRIDGE_PORT" && echo "PASS bridge link-local" || { echo "FAIL bridge not on link-local"; f=1; }
    listening "0.0.0.0:$BRIDGE_PORT" && { echo "FAIL bridge on 0.0.0.0"; f=1; }
    if [ -e "$C/hid.usb0" ]; then [ -e "$R/dev/hidg0" ] && echo "PASS hid" || { echo "FAIL no hidg0"; f=1; }; fi
    ecm_report   # 1.6.2: INFO/WARN only (the probation host-traffic gate runs in boot)
  else echo "WARN composite down (ACM$([ -e "$C/ffs.adb" ] && echo +adb))"
    for n in /data/appLunch.sh /data/setusbconfig; do shim_mounted "$n" && { echo "FAIL shim still mounted on $n with composite down"; f=1; }; done; fi
  n=$(df -Pk "$S" 2>/dev/null | awk 'END{print $4}'); case "$n" in ''|*[!0-9]*) ;; *) [ "$n" -lt 1024 ] && echo "WARN FAT free ${n} KiB";; esac
  run_report
  # on-board router (1.2.0): reported only (INFO), never FAIL/WARN, so it can neither block confirm nor degrade status
  if [ "${FEATURE_ROUTER:-1}" != 1 ]; then echo "INFO router disabled"
  elif composite_up; then router_running && echo "INFO router running" || echo "INFO router not running"; fi
  web_report
  agent_report
  return $f
}

jstr() { # JSON string: drop control bytes, escape backslash and quote
  printf '"%s"' "$(printf '%s' "$1" | tr '\n\t' '  ' | LC_ALL=C tr -cd ' -~' | sed 's/\\/\\\\/g; s/"/\\"/g')"; }
jbool() { if "$@" >/dev/null 2>&1; then echo true; else echo false; fi; }
health() {
  local kl up fat dat mem links l st rc mounts ht ec
  cfg_load
  agent_status_load
  ecm_init; ecm_load; ec=$(ecm_counts)
  kl=$(kernel_line); up=$(cut -d. -f1 /proc/uptime)
  fat=$(df -Pk "$S" 2>/dev/null | awk 'END{print $4}'); dat=$(df -Pk "$MK20_HOME" 2>/dev/null | awk 'END{print $4}')
  mem=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
  links=""; for l in "$C"/*usb0 "$C"/*adb; do [ -e "$l" ] && links="$links${l##*/} "; done
  st=$(selftest 2>/dev/null); rc=$?
  mounts=0; for l in /data/appLunch.sh /data/setusbconfig; do shim_mounted "$l" && mounts=$((mounts+1)); done
  # Exclusive, unpredictable temp in the private runtime dir (0600), then atomic replace.
  ht=$(mktemp "$TM/.health.XXXXXX") || return 1
  {
    printf '{'
    printf '"version":%s,"uptime_s":%s,' "$(jstr "$V")" "$(num "$up")"
    printf '"kernel":{"p4":%s,"name":%s,"features":%s},' "$(jstr "$(p4sha)")" "$(jstr "$(echo "$kl" | cut -d' ' -f2)")" "$(jstr "$(echo "$kl" | cut -d' ' -f3)")"
    printf '"vendor":%s,' "$(jstr "$(vendor_check)")"
    printf '"usb":{"udc":%s,"state":%s,"functions":%s,"composite":%s,' "$(jstr "$(cat "$G/UDC" 2>/dev/null)")" \
      "$(jstr "$(cat "$R"/sys/class/udc/*/state 2>/dev/null | head -n 1)")" "$(jstr "$links")" "$(jbool composite_up)"
    printf '"ecm_state":%s,"ecm_rx_packets":%s,"ecm_tx_packets":%s,"ecm_rx_stalls":%s,"ecm_rearms":%s,"ecm_recoveries":%s,"ecm_probes":%s,"ecm_gave_up":%s},' \
      "$(jstr "$ES_STATE")" "$(num "${ec%% *}")" "$(num "${ec##* }")" "$ES_STALLS" "$ES_REARMS" "$ES_RECOV" "$ES_PROBES" \
      "$([ "$ES_GAVEUP" = 1 ] && echo true || echo false)"
    printf '"net":{"usb0":%s,"mtu":%s,"subnet":%s,"bridge":%s,"hidg0_writable":%s},' "$(jstr "$(ifconfig usb0 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')")" \
      "$(num "$(cat "$R/sys/class/net/usb0/mtu" 2>/dev/null)")" "$(jstr "$ECM_SUBNET")" "$(jbool listening "$ECM_IP:$BRIDGE_PORT")" "$(jbool test -w "$R/dev/hidg0")"
    printf '"kd":%s,"adbd":%s,"flapmon":%s,"maint":%s,"shim_mounts":%s,"run_tmpfs":%s,' "$(num "$(kd_count)")" "$(jbool pidof adbd)" \
      "$(jbool pgrep -f mk20-flapmon.sh)" "$(jbool lock_held "$TM/mk20d-maint.lock")" "$mounts" "$(jbool run_tmpfs)"
    printf '"router":{"enabled":%s,"running":%s,"loop":%s,"tap":%s},' "$([ "${FEATURE_ROUTER:-1}" = 1 ] && echo true || echo false)" \
      "$(jbool router_running)" "$(jbool lock_held "$TM/router.lock")" "$(jbool test -S "$TM/kd-tap.sock")"
    printf '"kbd":{"enabled":%s,"mode":%s,"running":%s,"restarts":%s,"recent_crashes":%s,"degraded":%s,"status":%s},' \
      "$([ "${FEATURE_KBD:-0}" = 1 ] && echo true || echo false)" "$(jstr "$(kbd_mode)")" "$(jbool kbd_running)" \
      "$(kbd_total)" "$(num "$(kbd_recent)")" "$(jstr "$(head -n 1 "$TM/kbd-degraded" 2>/dev/null)")" "$(jstr "$(head -c 700 "$KST" 2>/dev/null)")"
    printf '"agent":{"enabled":%s,"allowed":%s,"state":%s,"provider":%s,"route":%s,"last_error_class":%s,"running":%s},' \
      "$([ "$FEATURE_AGENT" = 1 ] && echo true || echo false)" "$AALLOWED" "$(jstr "$ASTATE")" \
      "$(jstr "$APROVIDER")" "$(jstr "$AROUTE")" "$(jstr "$AERROR")" "$(jbool agent_running)"
    printf '"web":{"enabled":%s,"running":%s,"url":%s},' "$(jbool web_wanted)" "$(jbool agent_running)" \
      "$(jstr "$(l=$(web_ip); [ -n "$l" ] && echo "http://$l:8780")")"
    printf '"watchdog":%s,"mem_avail_kb":%s,"fat_free_kb":%s,"data_free_kb":%s,' "$(jbool wdt_armed)" "$(num "$mem")" "$(num "$fat")" "$(num "$dat")"
    printf '"release":{"slot":%s,"good":%s,"pending":%s,"last_rollback":%s},' "$(jstr "$(active_slot)")" "$(jstr "$(head -n 1 "$MK20_HOME/state/good" 2>/dev/null)")" \
      "$(jstr "$(head -n 1 "$MK20_HOME/state/pending" 2>/dev/null)")" "$(jstr "$(head -n 1 "$MK20_HOME/state/last-rollback" 2>/dev/null)")"
    printf '"config":{"src":%s,"warnings":%s},' "$(jstr "$CFG_SRC")" "$(jstr "$CFG_WARN")"
    printf '"selftest":{"pass":%s,"detail":%s},' "$([ "$rc" = 0 ] && echo true || echo false)" "$(jstr "$st")"
    printf '"status":%s' "$(jstr "$(if [ "$rc" != 0 ]; then echo fail; elif echo "$st" | grep -q '^WARN'; then echo degraded; else echo ok; fi)")"
    printf '}\n'
  } > "$ht" && maint_replace "$ht" "$TM/health.json" || { rm -f "$ht"; [ -L "$TM/health.json" ] || [ -f "$TM/health.json" ] && rm -f "$TM/health.json"; return 1; }
  cat "$TM/health.json"
}

stock_adb() { # legacy adb.sh semantics: add adb beside ACM; on failure or lost ACM restore serial; bounded keepalive
  local rc
  sh "$REL/share/mk20-add-adb.sh" >> "$LOGDIR/gadget.log" 2>&1; rc=$?
  [ $rc = 0 ] || log WARN adb "add-adb rc=$rc -> restore serial"
  if [ $rc != 0 ] || [ ! -e "$R/dev/ttyGS0" ] || [ ! -e "$C/acm.usb0" ]; then
    killall adbd 2>/dev/null; [ -x "$R/data/setusbconfig" ] && "$R/data/setusbconfig" serial >> "$LOGDIR/gadget.log" 2>&1; fi
  [ "${MK20_ADB_KEEPALIVE:-1}" = 1 ] || return 0
  ( trap '' HUP INT; exec 5>"$TM/adb-keepalive.lock"; flock -n 5 || exit 0; n=0
    while [ $n -lt 5 ]; do sleep 30
      [ -f "$S/mk20-no-adb" ] && exit 0
      if [ ! -e "$C/ffs.adb" ] && pgrep -f KeyboardDevice >/dev/null; then sleep 10; n=$((n+1)); log INFO adb "keepalive re-add #$n"
        sh "$REL/share/mk20-add-adb.sh" >> "$LOGDIR/gadget.log" 2>&1 || { killall adbd 2>/dev/null; [ -x "$R/data/setusbconfig" ] && "$R/data/setusbconfig" serial; }; fi
    done ) </dev/null >/dev/null 2>&1 6>&- 7>&- 8>&- 9>&- &
}

[ "${MK20D_LIB:-}" = 1 ] && return 0 2>/dev/null   # tests: source the functions only
case "${1:-}" in
boot)
  cfg_load
  log_rotate "$LOGDIR/gadget.log"
  log INFO boot "rel=$REL cfg=$CFG_SRC subnet=$ECM_SUBNET composite=$FEATURE_COMPOSITE hid=$FEATURE_HID adb=$FEATURE_ADB warn=$CFG_WARN"
  run_mount   # first: before mk20-kbd, the web or anything else writes /run/mk20
  i=0; until [ -n "$(cat "$G/UDC" 2>/dev/null)" ] && [ -e "$C/acm.usb0" ] && [ -e "$R/dev/ttyGS0" ]; do
    i=$((i+1)); [ $i -gt 120 ] && { log WARN boot "g1 not up after 120 s"; break; }; sleep 1; done
  kd_svc stop || log WARN kbd "leftover KD service stop failed"
  sleep "${MK20_SETTLE:-20}"
  MODE=composite; why=""
  NOHID=0; [ "$FEATURE_HID" = 1 ] && kernel_has hid || NOHID=1
  NOADB=0; [ "$FEATURE_ADB" = 1 ] || NOADB=1   # composite only; the stock fallback always adds adb (FAT flag aside)
  [ "$FEATURE_COMPOSITE" = 1 ] || { MODE=stock; why="config/flag"; }
  kernel_has ecm || { MODE=stock; why="${why:+$why,}kernel '$(kernel_line | cut -d' ' -f2)' lacks ecm"; }
  vc=$(vendor_check) || { MODE=stock; why="${why:+$why,}vendor $vc"; }
  [ -n "$(kernel_line)" ] || { MODE=none; why="kernel $(p4sha) not in kernel/ALLOWLIST"; }
  rm -f "$TM/gadget.env" "$TM/kbd.mode" "$TM/kbd-degraded" "$TM/kbd.crashes" "$TM/kbd-crash.times"
  # Decide before gadget so the bridge starts without the legacy KD tap. Local UI also runs if USB setup fails.
  KBDM=0; kbd_wanted && KBDM=1
  [ $KBDM = 1 ] && [ ! -x "$REL/bin/mk20-kbd" ] && log ERROR kbd "missing binary; supervisor will retry, never KD"
  if [ $MODE = composite ]; then
    ( umask 077; printf 'MK20_ECM_IP=%s\nMK20_ECM_MASK=%s\nMK20_DEV_MAC=%s\nMK20_HOST_MAC=%s\nMK20_BRIDGE_PORT=%s\nMK20_FLAP_DROPS=%s\nMK20_FLAP_WINDOW=%s\nMK20_NOHID=%s\nMK20_NOADB=%s\nMK20_HID_SCROLL=%s\nMK20_KBD=%s\n' \
      "$ECM_IP" "$ECM_MASK" "$ECM_DEV_MAC" "$ECM_HOST_MAC" "$BRIDGE_PORT" "$FLAP_DROPS" "$FLAP_WINDOW_S" "$NOHID" "$NOADB" "$FEATURE_HID_SCROLL" "$KBDM" > "$TM/gadget.env.tmp" ) \
      && mv -f "$TM/gadget.env.tmp" "$TM/gadget.env"
    cp -f "$REL/share/gadget.sh" "$TM/gadget-boot.sh"
    MK20_REL=$REL MK20_GADGET_LOG=$LOGDIR/gadget.log MK20_ECM_IP=$ECM_IP MK20_ECM_MASK=$ECM_MASK \
      MK20_DEV_MAC=$ECM_DEV_MAC MK20_HOST_MAC=$ECM_HOST_MAC MK20_BRIDGE_PORT=$BRIDGE_PORT \
      MK20_FLAP_DROPS=$FLAP_DROPS MK20_FLAP_WINDOW=$FLAP_WINDOW_S MK20_NOHID=$NOHID MK20_NOADB=$NOADB MK20_KBD=$KBDM \
      sh "$TM/gadget-boot.sh" --boot >> "$LOGDIR/gadget.log" 2>&1
    grc=$?
    log INFO gadget "rc=$grc status=$(cat "$S/gadget-ecm-hid.status" 2>/dev/null) nohid=$NOHID noadb=$NOADB ip=$ECM_IP"
  elif [ $MODE = stock ]; then
    SADB=1; [ -f "$S/mk20-no-adb" ] && SADB=0; kernel_has adb || SADB=0
    log WARN boot "composite skipped: $why -> ACM (KD stopped)$([ $SADB = 1 ] && echo +adb)"
    [ $SADB = 1 ] && stock_adb
  else log ERROR boot "$why -> no USB changes (ACM only; KD stopped)"; fi
  if [ $KBDM = 1 ]; then
    # boot is the transition owner here: under the gadget transition mutex (no failsafe/rollback in progress, composite
    # still up) clear teardown's stop markers (setup_main's kbd_stop left them) and launch; the supervisor itself never
    # clears them, so a late supervisor cannot undo a later teardown
    launch_wait=0
    while :; do
      if ( exec 7>"$TM/transition.lock" && flock -n 7 || exit 1; [ ! -f "$TM/gadget.busy" ] || exit 1
         rm -f "$R/tmp/mk20-kbd-stop" "$R/tmp/mk20-router-stop"; touch "$TM/kbd.mode"
         ( trap '' HUP INT; MK20_REL=$REL MK20_VERSION=$V MK20_NOHID=$NOHID \
             MK20_AGENT_CTL=$FEATURE_AGENT_CTL MK20_HID_SCROLL=$FEATURE_HID_SCROLL \
             MK20_K2_ESTOP=$FEATURE_K2_ESTOP MK20_K2_RELEASE=$FEATURE_K2_RELEASE \
             exec sh "$REL/sbin/mk20d" kbd </dev/null >/dev/null 2>&1 6>&- 7>&- 8>&- 9>&- ) & ); then
        log INFO kbd "supervisor launched (nohid=$NOHID); router off"
        break
      fi
      [ "$launch_wait" = 0 ] && log WARN kbd "transition busy -> mk20-kbd launch deferred"
      if [ "$launch_wait" -ge "${MK20_KBD_LAUNCH_WAIT:-60}" ]; then
        log ERROR kbd "transition busy -> mk20-kbd launch gave up after ${launch_wait}s"
        break
      fi
      sleep 1; launch_wait=$((launch_wait+1))
    done
  fi
  # 1.2.0 on-board router: only on a composite that set up cleanly with HID; never part of the confirm decision
  # (mk20-kbd mode: the router's job is done inside mk20-kbd)
  if [ $KBDM = 0 ] && [ $MODE = composite ] && [ "${grc:-1}" = 0 ] && [ $NOHID = 0 ] && [ "$FEATURE_ROUTER" = 1 ] && [ -x "$REL/bin/mk20-router" ]; then
    ( trap '' HUP INT; MK20_REL=$REL MK20_VERSION=$V exec sh "$REL/sbin/mk20d" router </dev/null >/dev/null 2>&1 6>&- 7>&- 8>&- 9>&- ) &
    log INFO router "supervisor launched"
  else log INFO router "not started (mode=$MODE grc=${grc:-} nohid=$NOHID enabled=$FEATURE_ROUTER kbd=$KBDM)"; fi
  # usb0 settings web (default on) + optional agent: one detached supervisor, no part in
  # composite/kbd/router setup or confirmation.
  if web_wanted && [ -x "$REL/bin/mk20-agent" ]; then
    ( trap '' HUP INT; MK20_REL=$REL MK20_VERSION=$V exec sh "$REL/sbin/mk20d" web </dev/null >/dev/null 2>&1 6>&- 7>&- 8>&- 9>&- ) &
    log INFO web "supervisor launched (web=$FEATURE_WEB agent=$FEATURE_AGENT)"
  fi
  sleep "${MK20_STABLE:-30}"
  # a gadget failsafe (flap rollback + adb re-add, up to ~2.5 min) in progress is not a failure: wait it out (cap)
  # The marker is set by flapmon BEFORE it launches a rollback and by cleanup(); a sample taken while (or just
  # before) it appears is retaken after the failsafe ends. Total wait capped (stays well under the loader deadline).
  w=0; busy_wait() { while [ -f "$TM/gadget.busy" ] && [ $w -lt "${MK20_BUSY_CAP:-150}" ]; do sleep 5; w=$((w+5)); done; }
  busy_wait; try=0; src=1; grc=${grc:-0}
  while [ $try -lt 3 ]; do
    try=$((try+1)); r=$(selftest); src=$?
    if [ -f "$TM/gadget.busy" ] && [ $w -lt "${MK20_BUSY_CAP:-150}" ]; then busy_wait; try=$((try-1)); continue; fi
    [ $src = 0 ] && break; [ $try = 3 ] || sleep "${MK20_SELFTEST_GAP:-10}"
  done
  [ $w -gt 0 ] && log INFO selftest "waited ${w}s for gadget failsafe"
  # On probation, a composite that failed its own setup (gadget rc!=0: ip/alias/bridge/bind -> die -> stock) is a
  # release failure, not "degraded": roll back. Host-caused flap rollbacks happen only after rc 0 and stay WARN.
  if [ $MODE = composite ] && [ "$grc" != 0 ] && [ "$(cat "$MK20_HOME/state/pending" 2>/dev/null)" = "$V" ]; then
    r="$r
FAIL composite setup rc=$grc during probation"; src=1; fi
  # 1.6.2 (incident 2026-10-23 23:07): on probation a host that is present and awake (UDC configured) with ECM active
  # (usb0 carrier 1) must deliver host->device traffic: probe, at most one re-arm, probe again (ecm_gate). No host
  # (asleep/unplugged/charger) or ECM not enabled by the host = INFO, never a failure. FAIL = not confirmed -> the
  # loader's deadline reset -> rollback to the good release (the reset also re-enumerates).
  if [ $MODE = composite ] && [ "$grc" = 0 ] && [ $src = 0 ] && probation; then
    eg=$(ecm_gate); egrc=$?
    r="$r
$eg"; [ $egrc = 0 ] || src=1
  fi
  echo "$r" > "$TM/selftest.txt"; log INFO selftest "rc=$src try=$try mode=$MODE $(echo "$r" | tr '\n' ';')"
  # per-boot records: selftest-last.json + selftest-1..4.json (previous boots)
  ST=$MK20_HOME/state; for k in 3 2 1; do [ -f "$ST/selftest-$k.json" ] && mv -f "$ST/selftest-$k.json" "$ST/selftest-$((k+1)).json"; done
  [ -f "$ST/selftest-last.json" ] && mv -f "$ST/selftest-last.json" "$ST/selftest-1.json"
  # decide on the 3-sample result ($src) BEFORE the (slower) health record, which can never change it
  if [ $src = 0 ]; then
    if [ -f "$TM/rescue-loader.sh" ]; then sh "$TM/rescue-loader.sh" confirm "$V" && log INFO confirm "ok" || log INFO confirm "not pending/refused"; fi
  else log ERROR selftest "FAILED: not confirming; loader owns A/B rollback"
    if [ "$FEATURE_KBD" != 1 ] && [ -f "$TM/gadget-boot.sh" ] && composite_up; then
      # same contract as the confirm waiter: retry once (rc 3 = stuck, already escalated), then persist stock + reboot
      rbn() { MK20_GEN='' MK20_RB_CALLER_RETRIES=1 MK20_REL=$REL MK20_GADGET_LOG=$LOGDIR/gadget.log sh "$TM/gadget-boot.sh" --rollback-now >> "$LOGDIR/gadget.log" 2>&1 6>&- 8>&- 9>&-; }
      rbn; rrc=$?
      if [ $rrc != 0 ] && [ $rrc != 3 ]; then log WARN selftest "rollback rc=$rrc; retrying once"; sleep "${MK20_RB_RETRY_S:-20}"; rbn; rrc=$?; fi
      if [ $rrc != 0 ] && [ $rrc != 3 ]; then log ERROR selftest "rollback failed twice (rc=$rrc) -> mk20-no-composite + reboot"
        touch "${MK20_FLAP_FLAG:-/mnt/SDCARD/mk20-no-composite}" && touch "${MK20_FLAP_REBOOT:-/mnt/SDCARD/cmd-reboot}"; sync; fi
    fi; fi
  ( health ) > "$ST/selftest-last.json" 2>/dev/null
  if [ "${MK20_MAINT:-1}" = 1 ]; then
    export MK20_REL="$REL" MK20_VERSION="$V"
    ( trap '' HUP INT; exec sh "$REL/sbin/mk20d" maint </dev/null >/dev/null 2>&1 6>&- 7>&- 8>&- 9>&- ) &
  fi
  ;;
health) health;;
maint)
  exec 5>"$TM/mk20d-maint.lock"; flock -n 5 || exit 0   # single instance for the lifetime of the loop
  log INFO maint "start pid=$$"
  # 1.6.2: the loop ticks every ECM_TICK_S for the ECM RX watchdog; rotation + health keep their MK20_MAINT_S period
  ECM_TICK_S=${MK20_ECM_TICK_S:-5}; case "$ECM_TICK_S" in ''|.*|*[!0-9.]*) ECM_TICK_S=5;; esac
  mnext=0
  while :; do
    mnow=$(cut -d. -f1 /proc/uptime)
    if [ "$mnow" -ge "$mnext" ]; then
      cfg_load
      log_rotate "$LOGDIR/mk20d.log"; log_rotate "$LOGDIR/gadget.log"
      b=$TM/bridge.log; [ -f "$b" ] && [ "$(wc -c < "$b")" -gt 262144 ] && { tail -c 65536 "$b" > "$b.t" && cat "$b.t" > "$b"; rm -f "$b.t"; }   # O_APPEND writers keep appending
      b=$TM/router.log; [ -f "$b" ] && [ "$(wc -c < "$b")" -gt 262144 ] && { tail -c 65536 "$b" > "$b.t" && cat "$b.t" > "$b"; rm -f "$b.t"; }
      b=$TM/kbd.log; [ -f "$b" ] && [ "$(wc -c < "$b")" -gt 262144 ] && { tail -c 65536 "$b" > "$b.t" && cat "$b.t" > "$b"; rm -f "$b.t"; }
      b=$TM/agent.log; [ -f "$b" ] && [ "$(wc -c < "$b")" -gt 262144 ] && { tail -c 65536 "$b" > "$b.t" && cat "$b.t" > "$b"; rm -f "$b.t"; }
      # debug adbd logs every adb command into tmpfs RAM (~1 MB/h under soak/test polling): cap it like the others
      b=$R/tmp/adbd.log; [ -f "$b" ] && [ ! -L "$b" ] && [ "$(wc -c < "$b")" -gt 262144 ] && { tail -c 65536 "$b" > "$b.t" && cat "$b.t" > "$b"; rm -f "$b.t"; }
      health > /dev/null 2>&1
      mnext=$((mnow + $(num "${MK20_MAINT_S:-300}")))
    fi
    ecm_tick   # bounded: a probe <= ECM_PROBE_S, a re-arm bounded by gadget.sh's own supervisor
    sleep "$ECM_TICK_S" 5>&-   # the lock dies with this loop, not with an orphaned sleep
  done;;
router)
  exec 5>"$TM/router.lock"; flock -n 5 || exit 0
  RB=$REL/bin/mk20-router; TAP=$TM/kd-tap.sock; HID=$R/dev/hidg0; STOP=$R/tmp/mk20-router-stop; RL=$TM/router.log
  rm -f "$STOP"; d=1; why=""; echo $$ > "$TM/router-loop.pid"   # gadget.sh router_stop kills this loop first
  log INFO router "start pid=$$"
  while :; do
    cfg_load
    [ "$FEATURE_ROUTER" = 1 ] || { why="disabled"; break; }
    [ -f "$STOP" ] && { why="stop file"; break; }
    composite_up || { why="composite down"; break; }
    if [ -S "$TAP" ] && [ -e "$HID" ]; then
      t0=$(cut -d. -f1 /proc/uptime)
      [ -f "$STOP" ] && { why="stop file"; break; }   # re-check right before launch (transition in progress)
      "$RB" --src "unix:$TAP" --hid "$HID" </dev/null >>"$RL" 2>&1 5>&-; rc=$?
      t1=$(cut -d. -f1 /proc/uptime); [ $((t1 - t0)) -ge 60 ] && d=1   # a long healthy run resets the backoff
      echo "$(date '+%F %T') mk20-router exit rc=$rc after $((t1 - t0)) s; retry in ${d}s" >> "$RL"
    fi
    sleep "$d" 5>&-; d=$((d * 2)); [ $d -gt "${MK20_ROUTER_BACKOFF_MAX:-30}" ] && d=${MK20_ROUTER_BACKOFF_MAX:-30}
  done
  rm -f "$TM/router-loop.pid"; log INFO router "stop ($why)";;
web|agent)
  # One instance (agent.lock) supervises mk20-agent --web. Modes: web = settings/maintenance only
  # (no keyboard client); agent = FEATURE_AGENT=1 with kbd.sock (adds the task runtime). The child is
  # restarted (not counted as a crash) on mode/address change; real exits back off 1,2,4..30 s, a
  # healthy >=60 s run resets the backoff, exits are kept for the 300 s crash window (selftest WARN).
  exec 5>"$TM/agent.lock"; flock -n 5 || exit 0
  AB=$REL/bin/mk20-agent; AL=$TM/agent.log; ASTOP=$R/tmp/mk20-agent-stop
  d=1; ap=""; am=""; aip=""; why=""; tick=0; echo $$ > "$TM/agent-loop.pid"
  web_config() { cfg_load; WIP=$(web_ip); tick=0; }   # mk20.conf/gadget.env: every 5 s
  web_mode() { # WM=off|pending|web|agent; kill switches (stop file, FAT flags) checked every call
    tick=$((tick + 1)); [ "$tick" -ge 5 ] && web_config
    [ -f "$S/mk20-no-web" ] && FEATURE_WEB=0
    [ -f "$S/mk20-no-agent" ] && FEATURE_AGENT=0
    if [ -f "$ASTOP" ] || ! web_wanted; then WM=off
    elif ! composite_up || [ -f "$TM/gadget.busy" ] || [ -z "$WIP" ] || [ ! -f "$TM/gadget.env" ]; then WM=pending
    elif [ "$FEATURE_AGENT" = 1 ] && [ -e "$ASOCK" ]; then WM=agent
    elif [ "$FEATURE_WEB" = 1 ]; then WM=web
    else WM=pending; fi   # agent-only config without kbd.sock (legacy wait)
  }
  agent_reap() {
    [ -n "$ap" ] || return 0
    kill -TERM "$ap" 2>/dev/null
    i=0; while kill -0 "$ap" 2>/dev/null && [ "$i" -lt 25 ]; do sleep 0.2 5>&-; i=$((i+1)); done
    kill -KILL "$ap" 2>/dev/null; wait "$ap" 2>/dev/null; ap=""
  }
  agent_cleanup() { agent_reap; rm -f "$TM/agent-loop.pid"; }
  trap 'agent_cleanup; exit 0' TERM
  log INFO web "start pid=$$"
  web_config
  while :; do
    web_mode
    [ "$WM" = off ] && { why="disabled/stop file"; break; }
    [ -x "$AB" ] || { why="binary unavailable"; break; }
    if [ "$WM" = pending ]; then sleep 1 5>&-; continue; fi   # dependencies can appear later; no busy loop
    # Supported production CLI only: no run-level permission/grant flag; the agent starts disabled.
    set -- --web --web-listen "$WIP:8780" --web-config-dir "$MK20_HOME/agent" --web-secrets-dir "$MK20_HOME/secrets" \
      --web-pair-file "$R/run/mk20/pair-code" --web-health-file "$TM/health.json" --web-maint-dir "$MR" --web-debug-file "$MP/debug.conf"
    [ "$WM" = agent ] && set -- "$@" --kbd-sock "$ASOCK"
    mkdir -p "$R/run/mk20" 2>/dev/null
    [ "$WM:$WIP" = "$am:$aip" ] || log INFO web "mode=$WM url=http://$WIP:8780"
    am=$WM; aip=$WIP; t0=$(cut -d. -f1 /proc/uptime)
    sh "$REL/share/mk20-agent-child.sh" "$AB" "$@" </dev/null >>"$AL" 2>&1 5>&- &
    ap=$!; gated=0
    while kill -0 "$ap" 2>/dev/null; do
      web_mode
      if [ "$WM" != "$am" ] || [ "$WIP" != "$aip" ]; then agent_reap; gated=1; break; fi
      sleep 1 5>&-
    done
    [ "$gated" = 1 ] && continue   # dependency/mode/stop change is not a crash
    wait "$ap"; rc=$?; ap=""; t1=$(cut -d. -f1 /proc/uptime)
    web_config; web_mode; [ "$WM" = off ] && { why="disabled/stop file"; break; }
    [ $((t1 - t0)) -ge 60 ] && d=1
    { tail -n 19 "$TM/agent-crash.times" 2>/dev/null; echo "$t1"; } > "$TM/agent-crash.times.t" && mv -f "$TM/agent-crash.times.t" "$TM/agent-crash.times"
    echo "$(date '+%F %T') mk20-agent exit rc=$rc after $((t1 - t0)) s; retry in ${d}s" >> "$AL"
    # Poll kill switches during backoff too (maximum response one second).
    left=$d; while [ "$left" -gt 0 ]; do web_mode; [ "$WM" = off ] && break; sleep 1 5>&-; left=$((left-1)); done
    d=$((d * 2)); [ "$d" -gt 30 ] && d=30
  done
  agent_cleanup; log INFO web "stop ($why)";;

kbd)
  exec 5>"$TM/kbd.lock"; flock -n 5 || exit 0
  KB=$REL/bin/mk20-kbd; HID=$R/dev/hidg0; KSTOP=$R/tmp/mk20-kbd-stop; HSTOP=$R/tmp/mk20-router-stop; KL=$TM/kbd.log
  echo $$ > "$TM/kbd-loop.pid"; why=""; d=1; last_rc=$(num "$(sed -n 's/.*last_rc=\([0-9]*\).*/\1/p' "$TM/kbd.crashes" 2>/dev/null)"); reason=normal
  rm -f "$TM/kbd-degraded"; mkdir -p "$R/run/mk20"
  maint_init || { log ERROR maint "unsafe maintenance directory"; exit 1; }
  [ -f "$MP/safe" ] && reason='crash-loop'
  log INFO kbd "start pid=$$"
  stopped=0; kd_d=1
  while :; do
    [ -f "$KSTOP" ] && { why="stop file"; break; }
    [ -f "$TM/gadget.busy" ] && { why="composite busy"; break; }
    kbd_hooks
    # Always stop procd, even between KD respawns. Retry forever while devices are occupied.
    if [ "$stopped" = 0 ] || [ "$(kd_count)" != 0 ]; then
      if kd_svc stop; then stopped=1; else stopped=0; fi
      sleep "${MK20_KBD_KD_SETTLE:-1}" 5>&-
      if [ "$stopped" = 0 ] || [ "$(kd_count)" != 0 ]; then
        stopped=0
        reason='kd-stop'; echo "waiting for stock KD to stop" > "$TM/kbd-degraded"
        kbd_state
        kdwait=0; while [ "$kdwait" -lt "$((kd_d * 5))" ]; do
          kbd_hooks; [ -f "$KSTOP" ] && break
          sleep 0.2 5>&-; kdwait=$((kdwait+1))
        done
        kd_d=$((kd_d * 2)); [ "$kd_d" -gt "${MK20_KBD_KD_BACKOFF_MAX:-30}" ] && kd_d=${MK20_KBD_KD_BACKOFF_MAX:-30}
        continue
      fi
      kd_d=1
      rm -f "$TM/kbd-degraded"; reason=normal; [ -f "$MP/safe" ] && reason='crash-loop'
    fi
    if [ "$(kbd_recent)" -ge "${MK20_KBD_CRASHES:-3}" ] && [ ! -f "$MP/safe" ]; then
      ( umask 077; touch "$MP/safe" ); reason='crash-loop'
    fi
    [ -f "$MP/safe" ] && reason='crash-loop'
    set -- --hid "$HID" --hid-stop-file "$HSTOP"
    [ "${MK20_NOHID:-0}" = 1 ] && set -- --no-hid
    set -- "$@" --status "$KST" --lock "$R/tmp/mk20-kbd.lock" --exit-file "$KSTOP"
    if [ -f "$MP/safe" ]; then set -- "$@" --safe-mode
    else
      [ "${MK20_AGENT_CTL:-0}" = 1 ] && set -- "$@" --ctl "$R/run/mk20/kbd.sock"
    fi
    [ "${MK20_HID_SCROLL:-0}" = 1 ] && set -- "$@" --hid-scroll
    [ "${MK20_K2_ESTOP:-0}" = 1 ] && set -- "$@" --k2-estop
    [ "${MK20_K2_RELEASE:-0}" = 1 ] && set -- "$@" --k2-release
    debug_read; [ "$DEBUG_VERBOSE" = 1 ] && set -- "$@" --verbose
    [ -x "$KB" ] || reason='missing-binary'
    kbd_state
    t0=$(cut -d. -f1 /proc/uptime)
    # Markers are cleared only by boot under the transition lock. The binary rechecks --exit-file.
    "$KB" --run --host "$R/dev/ttyGS0" "$@" </dev/null >>"$KL" 2>&1 5>&- &
    child=$!; requested=0; state_tick=0; stop_failed=0
    while kill -0 "$child" 2>/dev/null; do
      kbd_hooks
      if [ "$restart" = 1 ] || [ -f "$KSTOP" ]; then
        requested=1
        if ! kbd_child_stop; then stop_failed=1; fi
        break
      fi
      state_tick=$((state_tick + 1))
      if [ "$state_tick" -ge 5 ]; then
        kbd_state; state_tick=0
        if [ "$(kd_count)" != 0 ]; then
          # A respawn means procd ownership is uncertain, even if its next stop
          # removes the PID but fails. Quiesce our writer before any stop/retry.
          stopped=0; requested=1; reason='kd-stop'
          if ! kbd_child_stop; then stop_failed=1; fi
          break
        fi
      fi
      sleep 0.2 5>&-
    done
    if [ "$stop_failed" = 1 ]; then
      why='child-stop-failed'; reason=$why
      log ERROR kbd "mk20-kbd did not stop after bounded TERM/KILL; supervisor exiting"
      break
    fi
    wait "$child"; rc=$?
    [ "$requested" = 1 ] && rc=0
    [ -f "$KSTOP" ] && { why="stop file"; break; }
    # Maintenance restarts (and signals requested above) never contribute to crash history.
    if [ "$requested" = 1 ]; then d=1; rm -f "$KST"; kbd_state; continue; fi
    last_rc=$rc; t1=$(cut -d. -f1 /proc/uptime)
    total=$(( $(kbd_total) + 1 )); [ $((t1 - t0)) -ge 60 ] && d=1
    { tail -n 19 "$TM/kbd-crash.times" 2>/dev/null; echo "$t1"; } > "$TM/kbd-crash.times.t" && mv -f "$TM/kbd-crash.times.t" "$TM/kbd-crash.times"
    echo "total=$total last_rc=$rc last_up=$t1" > "$TM/kbd.crashes"
    echo "$(date '+%F %T') mk20-kbd exit rc=$rc after $((t1 - t0)) s; restart #$total in ${d}s" >> "$KL"
    [ "$total" = 1 ] || [ $((total % 10)) = 0 ] && log WARN kbd "mk20-kbd exit rc=$rc (restart #$total, backoff ${d}s)"
    # Interruptible backoff: web hooks/teardown remain responsive, even at the 30-second cap.
    ticks=$((d * 5)); iwait=0
    while [ "$iwait" -lt "$ticks" ]; do
      kbd_hooks; [ "$restart" = 1 ] && break
      [ -f "$KSTOP" ] && break
      sleep 0.2 5>&-; iwait=$((iwait+1))
    done
    if [ "$restart" = 1 ]; then d=1
    else d=$((d * 2)); [ $d -gt "${MK20_KBD_BACKOFF_MAX:-30}" ] && d=${MK20_KBD_BACKOFF_MAX:-30}; fi
  done
  kbd_state; rm -f "$TM/kbd-loop.pid"; log INFO kbd "stop ($why)";;
selftest) cfg_load; selftest; exit $?;;
config) cfg_load; cfg_print;;
version) echo "$V";;
*) echo "usage: mk20d boot|health|selftest|config|maint|router|kbd|web|version"; exit 2;;
esac
