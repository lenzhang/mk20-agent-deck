#!/bin/sh
# shellcheck disable=SC3043
# MK20 Agent firmware single entry point (release tier). Launched by the rescue loader with
#   MK20_REL (verified tmpfs copy of this release), MK20_VERSION, MK20_HOME (/data/mk20).
#   mk20d boot      gates (kernel features, vendor hashes, config) -> composite ECM+HID+ADB+KD-bridge or stock
#                   ACM+KD(+adb) -> self-test (3 samples) -> confirm with the loader (or restore stock on failure)
#   mk20d health    JSON health report (stdout; also written to /tmp/mk20/health.json)
#   mk20d selftest  host-independent checks, PASS/FAIL/WARN lines, rc 0 = pass
#   mk20d config    effective configuration (mk20.conf + flag overrides) and warnings
#   mk20d maint     detached housekeeping loop started by boot (single instance: flock): log rotation
#                   (/data/mk20/logs), tmpfs bridge-log trim, periodic /tmp/mk20/health.json (MK20_MAINT_S=300 s)
#   mk20d version
# Gate policy: kernel not in kernel/ALLOWLIST -> NO USB changes at all (KD's stock ACM stays); kernel without ecm or
# vendor hash mismatch or config/flag -> stock ACM+KD+adb (adb with restore-to-serial on failure, like legacy adb.sh).
R=${MK20_ROOT:-}
REL=${MK20_REL:-$(cd "$(dirname "$0")/.." && pwd)}
V=${MK20_VERSION:-$(sed -n 's/^version=//p' "$REL/MANIFEST" 2>/dev/null)}
. "$REL/share/mk20lib.sh"
TM=$R/tmp/mk20; G=$R/sys/kernel/config/usb_gadget/g1; C=$G/configs/c.1
MOUNTS=${MK20_MOUNTS:-/proc/mounts}
mkdir -p "$TM" "$LOGDIR" "$MK20_HOME/state" 2>/dev/null
log() { mk20log "$1" mk20d "$2" "v=$V" "$3"; }

p4sha() { [ -n "${MK20_P4_SHA:-}" ] && { echo "$MK20_P4_SHA"; return; }; [ -s "$TM/p4.sha" ] || sha256sum "$R/dev/by-name/boot" 2>/dev/null | cut -d' ' -f1 > "$TM/p4.sha"; cat "$TM/p4.sha"; }
kernel_line() { local p; p=$(p4sha); echo "$p" | grep -Eq '^[0-9a-f]{64}$' && awk -v p="$p" '$1==p && NF>=3 {print; exit}' "$MK20_HOME/kernel/ALLOWLIST" 2>/dev/null; }   # "<sha> <name> <features>"
kernel_has() { case ",$(kernel_line | cut -d' ' -f3)," in *",$1,"*) return 0;; esac; return 1; }
shim_mounted() { # $1=path: our KD shim (a tmpfs file bind-mounted exactly on a known vendor path)
  case "$1" in /data/appLunch.sh|/data/setusbconfig) ;; *) return 1;; esac
  awk -v f="$1" '$2==f && $3=="tmpfs" {ok=1} END{exit !ok}' "$MOUNTS" 2>/dev/null; }
vendor_check() { # prints "ok" or the first mismatch; all 4 vendor entries must be present and checked
  local h f n; n=0
  while read -r h f || [ -n "$h" ]; do
    [ -n "$h" ] || continue
    n=$((n+1))
    shim_mounted "$f" && continue
    [ "$(sha256sum "$R$f" 2>/dev/null | cut -d' ' -f1)" = "$h" ] || { echo "mismatch:$f"; return 1; }
  done < "$REL/share/vendor.sha256"
  [ "$n" -ge 4 ] || { echo "vendor list incomplete ($n)"; return 1; }
  echo ok
}
num() { case "$1" in ''|*[!0-9]*) echo 0;; *) echo "$1";; esac; }
kd_count() { pgrep -f '^/data/KeyboardDevice' | wc -l | tr -d ' '; }   # not -x: BusyBox 1.27 -x never matches KD (1.0.3 field failure)
composite_up() { [ -e "$C/ecm.usb0" ]; }
listening() { netstat -ltn 2>/dev/null | awk -v a="$1" '$4==a {ok=1} END{exit !ok}'; }   # exact local address
lock_held() { ( exec 5>"$1"; ! flock -n 5 ) 2>/dev/null; }   # a live instance holds the lock
wdt_armed() { ${MK20_UBUS:-ubus} call system watchdog 2>/dev/null | grep -q '"running"'; }

selftest() { # FAIL = host-independent breakage; composite rollback / missing rescue alias is "degraded" (WARN)
  local f n; f=0
  n=$(kd_count); [ "$n" = 1 ] && echo "PASS kd=1" || { echo "FAIL kd=$n"; f=1; }
  [ -n "$(cat "$G/UDC" 2>/dev/null)" ] && echo "PASS udc bound" || { echo "FAIL udc unbound"; f=1; }
  [ -e "$R/dev/ttyGS0" ] && echo "PASS ttyGS0" || { echo "FAIL no ttyGS0"; f=1; }
  wdt_armed && echo "PASS watchdog armed" || { echo "FAIL watchdog not armed"; f=1; }
  if composite_up; then
    listening "$ECM_IP:$BRIDGE_PORT" && echo "PASS bridge $ECM_IP:$BRIDGE_PORT" || { echo "FAIL bridge not on $ECM_IP:$BRIDGE_PORT"; f=1; }
    listening "${MK20_LL_IP:-169.254.7.2}:$BRIDGE_PORT" && echo "PASS bridge link-local" || echo "WARN bridge not on link-local"
    listening "0.0.0.0:$BRIDGE_PORT" && { echo "FAIL bridge on 0.0.0.0"; f=1; }
    if [ -e "$C/hid.usb0" ]; then [ -e "$R/dev/hidg0" ] && echo "PASS hid" || { echo "FAIL no hidg0"; f=1; }; fi
  else echo "WARN composite down (stock ACM+KD$([ -e "$C/ffs.adb" ] && echo +adb))"
    for n in /data/appLunch.sh /data/setusbconfig; do shim_mounted "$n" && { echo "FAIL shim still mounted on $n with composite down"; f=1; }; done; fi
  n=$(df -Pk "$S" 2>/dev/null | awk 'END{print $4}'); case "$n" in ''|*[!0-9]*) ;; *) [ "$n" -lt 1024 ] && echo "WARN FAT free ${n} KiB";; esac
  return $f
}

jstr() { # JSON string: drop control bytes, escape backslash and quote
  printf '"%s"' "$(printf '%s' "$1" | tr '\n\t' '  ' | LC_ALL=C tr -cd ' -~' | sed 's/\\/\\\\/g; s/"/\\"/g')"; }
jbool() { if "$@" >/dev/null 2>&1; then echo true; else echo false; fi; }
health() {
  local kl up fat dat mem links l st rc mounts
  cfg_load
  kl=$(kernel_line); up=$(cut -d. -f1 /proc/uptime)
  fat=$(df -Pk "$S" 2>/dev/null | awk 'END{print $4}'); dat=$(df -Pk "$MK20_HOME" 2>/dev/null | awk 'END{print $4}')
  mem=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
  links=""; for l in "$C"/*usb0 "$C"/*adb; do [ -e "$l" ] && links="$links${l##*/} "; done
  st=$(selftest 2>/dev/null); rc=$?
  mounts=0; for l in /data/appLunch.sh /data/setusbconfig; do shim_mounted "$l" && mounts=$((mounts+1)); done
  {
    printf '{'
    printf '"version":%s,"uptime_s":%s,' "$(jstr "$V")" "$(num "$up")"
    printf '"kernel":{"p4":%s,"name":%s,"features":%s},' "$(jstr "$(p4sha)")" "$(jstr "$(echo "$kl" | cut -d' ' -f2)")" "$(jstr "$(echo "$kl" | cut -d' ' -f3)")"
    printf '"vendor":%s,' "$(jstr "$(vendor_check)")"
    printf '"usb":{"udc":%s,"state":%s,"functions":%s,"composite":%s},' "$(jstr "$(cat "$G/UDC" 2>/dev/null)")" \
      "$(jstr "$(cat "$R"/sys/class/udc/*/state 2>/dev/null | head -n 1)")" "$(jstr "$links")" "$(jbool composite_up)"
    printf '"net":{"usb0":%s,"mtu":%s,"subnet":%s,"bridge":%s,"hidg0_writable":%s},' "$(jstr "$(ifconfig usb0 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')")" \
      "$(num "$(cat "$R/sys/class/net/usb0/mtu" 2>/dev/null)")" "$(jstr "$ECM_SUBNET")" "$(jbool listening "$ECM_IP:$BRIDGE_PORT")" "$(jbool test -w "$R/dev/hidg0")"
    printf '"kd":%s,"adbd":%s,"flapmon":%s,"maint":%s,"shim_mounts":%s,' "$(num "$(kd_count)")" "$(jbool pidof adbd)" \
      "$(jbool pgrep -f mk20-flapmon.sh)" "$(jbool lock_held "$TM/mk20d-maint.lock")" "$mounts"
    printf '"watchdog":%s,"mem_avail_kb":%s,"fat_free_kb":%s,"data_free_kb":%s,' "$(jbool wdt_armed)" "$(num "$mem")" "$(num "$fat")" "$(num "$dat")"
    printf '"release":{"good":%s,"pending":%s,"last_rollback":%s},' "$(jstr "$(head -n 1 "$MK20_HOME/state/good" 2>/dev/null)")" \
      "$(jstr "$(head -n 1 "$MK20_HOME/state/pending" 2>/dev/null)")" "$(jstr "$(head -n 1 "$MK20_HOME/state/last-rollback" 2>/dev/null)")"
    printf '"config":{"src":%s,"warnings":%s},' "$(jstr "$CFG_SRC")" "$(jstr "$CFG_WARN")"
    printf '"selftest":{"pass":%s,"detail":%s},' "$([ "$rc" = 0 ] && echo true || echo false)" "$(jstr "$st")"
    printf '"status":%s' "$(jstr "$(if [ "$rc" != 0 ]; then echo fail; elif echo "$st" | grep -q '^WARN'; then echo degraded; else echo ok; fi)")"
    printf '}\n'
  } > "$TM/health.json.tmp.$$" && mv -f "$TM/health.json.tmp.$$" "$TM/health.json" || { rm -f "$TM/health.json" "$TM/health.json.tmp.$$"; return 1; }
  cat "$TM/health.json"
}

stock_adb() { # legacy adb.sh semantics: add adb beside ACM; on failure or lost ACM restore serial; bounded keepalive
  local rc
  sh "$REL/share/mk20-add-adb.sh" >> "$LOGDIR/gadget.log" 2>&1; rc=$?
  [ $rc = 0 ] || log WARN adb "add-adb rc=$rc -> restore serial"
  if [ $rc != 0 ] || [ ! -e "$R/dev/ttyGS0" ] || [ ! -e "$C/acm.usb0" ]; then
    killall adbd 2>/dev/null; [ -x "$R/data/setusbconfig" ] && "$R/data/setusbconfig" serial >> "$LOGDIR/gadget.log" 2>&1; fi
  [ "${MK20_ADB_KEEPALIVE:-1}" = 1 ] || return 0
  ( trap '' HUP INT; exec 5>"$TM/adb-keepalive.lock"; flock -n 5 || exit 0; n=0
    while [ $n -lt 5 ]; do sleep 30
      [ -f "$S/mk20-no-adb" ] && exit 0
      if [ ! -e "$C/ffs.adb" ] && pgrep -f KeyboardDevice >/dev/null; then sleep 10; n=$((n+1)); log INFO adb "keepalive re-add #$n"
        sh "$REL/share/mk20-add-adb.sh" >> "$LOGDIR/gadget.log" 2>&1 || { killall adbd 2>/dev/null; [ -x "$R/data/setusbconfig" ] && "$R/data/setusbconfig" serial; }; fi
    done ) </dev/null >/dev/null 2>&1 6>&- 7>&- 8>&- 9>&- &
}

case "${1:-}" in
boot)
  cfg_load
  log_rotate "$LOGDIR/gadget.log"
  log INFO boot "rel=$REL cfg=$CFG_SRC subnet=$ECM_SUBNET composite=$FEATURE_COMPOSITE hid=$FEATURE_HID adb=$FEATURE_ADB warn=$CFG_WARN"
  i=0; until [ -n "$(cat "$G/UDC" 2>/dev/null)" ] && [ -e "$C/acm.usb0" ] && [ -e "$R/dev/ttyGS0" ] && pgrep -f KeyboardDevice >/dev/null; do
    i=$((i+1)); [ $i -gt 120 ] && { log WARN boot "KD/g1 not up after 120 s"; break; }; sleep 1; done
  sleep "${MK20_SETTLE:-20}"
  MODE=composite; why=""
  NOHID=0; [ "$FEATURE_HID" = 1 ] && kernel_has hid || NOHID=1
  NOADB=0; [ "$FEATURE_ADB" = 1 ] || NOADB=1   # composite only; the stock fallback always adds adb (FAT flag aside)
  [ "$FEATURE_COMPOSITE" = 1 ] || { MODE=stock; why="config/flag"; }
  kernel_has ecm || { MODE=stock; why="${why:+$why,}kernel '$(kernel_line | cut -d' ' -f2)' lacks ecm"; }
  vc=$(vendor_check) || { MODE=stock; why="${why:+$why,}vendor $vc"; }
  [ -n "$(kernel_line)" ] || { MODE=none; why="kernel $(p4sha) not in kernel/ALLOWLIST"; }
  rm -f "$TM/gadget.env"
  if [ $MODE = composite ]; then
    ( umask 077; printf 'MK20_ECM_IP=%s\nMK20_ECM_MASK=%s\nMK20_DEV_MAC=%s\nMK20_HOST_MAC=%s\nMK20_BRIDGE_PORT=%s\nMK20_FLAP_DROPS=%s\nMK20_FLAP_WINDOW=%s\nMK20_NOHID=%s\nMK20_NOADB=%s\n' \
      "$ECM_IP" "$ECM_MASK" "$ECM_DEV_MAC" "$ECM_HOST_MAC" "$BRIDGE_PORT" "$FLAP_DROPS" "$FLAP_WINDOW_S" "$NOHID" "$NOADB" > "$TM/gadget.env.tmp" ) \
      && mv -f "$TM/gadget.env.tmp" "$TM/gadget.env"
    cp -f "$REL/share/gadget.sh" "$TM/gadget-boot.sh"
    MK20_REL=$REL MK20_GADGET_LOG=$LOGDIR/gadget.log MK20_ECM_IP=$ECM_IP MK20_ECM_MASK=$ECM_MASK \
      MK20_DEV_MAC=$ECM_DEV_MAC MK20_HOST_MAC=$ECM_HOST_MAC MK20_BRIDGE_PORT=$BRIDGE_PORT \
      MK20_FLAP_DROPS=$FLAP_DROPS MK20_FLAP_WINDOW=$FLAP_WINDOW_S MK20_NOHID=$NOHID MK20_NOADB=$NOADB \
      sh "$TM/gadget-boot.sh" --boot >> "$LOGDIR/gadget.log" 2>&1
    log INFO gadget "rc=$? status=$(cat "$S/gadget-ecm-hid.status" 2>/dev/null) nohid=$NOHID noadb=$NOADB ip=$ECM_IP"
  elif [ $MODE = stock ]; then
    SADB=1; [ -f "$S/mk20-no-adb" ] && SADB=0; kernel_has adb || SADB=0
    log WARN boot "composite skipped: $why -> stock ACM+KD$([ $SADB = 1 ] && echo +adb)"
    [ $SADB = 1 ] && stock_adb
  else log ERROR boot "$why -> no USB changes (stock ACM+KD only)"; fi
  sleep "${MK20_STABLE:-30}"
  # a gadget failsafe (flap rollback + adb re-add, up to ~2.5 min) in progress is not a failure: wait it out (cap)
  # The marker is set by flapmon BEFORE it launches a rollback and by cleanup(); a sample taken while (or just
  # before) it appears is retaken after the failsafe ends. Total wait capped (stays well under the loader deadline).
  w=0; busy_wait() { while [ -f "$TM/gadget.busy" ] && [ $w -lt "${MK20_BUSY_CAP:-150}" ]; do sleep 5; w=$((w+5)); done; }
  busy_wait; try=0; src=1
  while [ $try -lt 3 ]; do
    try=$((try+1)); r=$(selftest); src=$?
    if [ -f "$TM/gadget.busy" ] && [ $w -lt "${MK20_BUSY_CAP:-150}" ]; then busy_wait; try=$((try-1)); continue; fi
    [ $src = 0 ] && break; [ $try = 3 ] || sleep "${MK20_SELFTEST_GAP:-10}"
  done
  [ $w -gt 0 ] && log INFO selftest "waited ${w}s for gadget failsafe"
  echo "$r" > "$TM/selftest.txt"; log INFO selftest "rc=$src try=$try mode=$MODE $(echo "$r" | tr '\n' ';')"
  # per-boot records: selftest-last.json + selftest-1..4.json (previous boots)
  ST=$MK20_HOME/state; for k in 3 2 1; do [ -f "$ST/selftest-$k.json" ] && mv -f "$ST/selftest-$k.json" "$ST/selftest-$((k+1)).json"; done
  [ -f "$ST/selftest-last.json" ] && mv -f "$ST/selftest-last.json" "$ST/selftest-1.json"
  # decide on the 3-sample result ($src) BEFORE the (slower) health record, which can never change it
  if [ $src = 0 ]; then
    if [ -f "$TM/rescue-loader.sh" ]; then sh "$TM/rescue-loader.sh" confirm "$V" && log INFO confirm "ok" || log INFO confirm "not pending/refused"; fi
  else log ERROR selftest "FAILED: not confirming; restoring stock ACM+KD+adb now"
    [ -f "$TM/gadget-boot.sh" ] && composite_up && MK20_REL=$REL MK20_GADGET_LOG=$LOGDIR/gadget.log sh "$TM/gadget-boot.sh" --rollback-now >> "$LOGDIR/gadget.log" 2>&1; fi
  ( health ) > "$ST/selftest-last.json" 2>/dev/null
  if [ "${MK20_MAINT:-1}" = 1 ]; then
    export MK20_REL="$REL" MK20_VERSION="$V"
    ( trap '' HUP INT; exec sh "$REL/sbin/mk20d" maint </dev/null >/dev/null 2>&1 6>&- 7>&- 8>&- 9>&- ) &
  fi
  ;;
health) health;;
maint)
  exec 5>"$TM/mk20d-maint.lock"; flock -n 5 || exit 0   # single instance for the lifetime of the loop
  log INFO maint "start pid=$$"
  while :; do
    cfg_load
    log_rotate "$LOGDIR/mk20d.log"; log_rotate "$LOGDIR/gadget.log"
    b=$TM/bridge.log; [ -f "$b" ] && [ "$(wc -c < "$b")" -gt 262144 ] && { tail -c 65536 "$b" > "$b.t" && cat "$b.t" > "$b"; rm -f "$b.t"; }   # O_APPEND writers keep appending
    health > /dev/null 2>&1
    sleep "${MK20_MAINT_S:-300}" 5>&-   # the lock dies with this loop, not with an orphaned sleep
  done;;
selftest) cfg_load; selftest; exit $?;;
config) cfg_load; cfg_print;;
version) echo "$V";;
*) echo "usage: mk20d boot|health|selftest|config|maint|version"; exit 2;;
esac
