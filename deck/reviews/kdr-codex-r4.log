    73	
    74	KDSVC=/etc/init.d/qt_app2   # procd service (CMD=/data/appLunch.sh). NOT qt_app1 (plain sh, kills adbd)
    75	[ -x $KDSVC ] || KDSVC=""
    76	udc_now() { cat $G/UDC 2>/dev/null; }
    77	# KD start: via procd only when the service exists (a manual fallback raced procd -> TWO KD processes, 16:17).
    78	# 1.2.0 r2 (Opus r120 #1): the on-board router holds /dev/hidg0 open. On this kernel (pre-6.2 f_hid: cdev embedded in
    79	# f_hidg, freed on configfs unlink) removing hid.usb0 under an open fd is a use-after-free, so every path that touches
    80	# the UDC/configfs (cleanup = all rollbacks, setup_main = (re-)setup) first stops it: stop file (mk20d supervisor
    81	# will not relaunch), kill the validated supervisor loop, SIGTERM (router sends all-keys-up) for <= ~2 s, then SIGKILL.
    82	# Only pids whose cmdline really is `.../bin/mk20-router --src ...` are signalled.
    83	router_pids() { for p in $(pgrep -f 'bin/mk20-router --src' 2>/dev/null); do
    84	  case "$p" in ''|*[!0-9]*) continue;; esac
    85	  tr '\000' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q 'bin/mk20-router --src' && echo "$p"; done; }
    86	router_stop() {
    87	  touch /tmp/mk20-router-stop
    88	  rp=$(cat /tmp/mk20/router-loop.pid 2>/dev/null)
    89	  case "$rp" in ''|*[!0-9]*|0|1) ;; *) tr '\000' ' ' < "/proc/$rp/cmdline" 2>/dev/null | grep -q 'mk20d router' && kill "$rp" 2>/dev/null;; esac
