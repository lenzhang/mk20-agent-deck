    99	}
   100	# mk20-kbd (KD replacement) also holds /dev/hidg0. Same UAF rule: before any UDC/configfs change it must have closed
   101	# it. It watches /tmp/mk20-router-stop (touched above) and closes on SIGUSR1; we wait until /proc shows no hidg0 fd.
   102	# Fail closed: still held after ~3 s -> SIGTERM, then SIGKILL (the fd dies with the process).
   103	# Only pids whose cmdline really is `.../bin/mk20-kbd --run ...` are signalled.
   104	kbd_pids() { for p in $(pgrep -f 'bin/mk20-kbd --run' 2>/dev/null); do
   105	  case "$p" in ''|*[!0-9]*) continue;; esac
   106	  tr '\000' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q 'bin/mk20-kbd --run' && echo "$p"; done; }
   107	# a parked stale fd (mk20-kbd keeps it open after a node re-create, see kbd/hid.h) reads "/dev/hidg0 (deleted)"
   108	# a recorded pid is gone only when /proc/<pid> vanished or it is a zombie leader with no thread left: after SIGKILL
   109	# the leader can be a zombie (empty cmdline, fd dir unreadable) while a worker thread sits in uninterruptible fb I/O
   110	# and still holds the shared fd table (codex kdr-r2 #1)
   111	kbd_st() { sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | cut -d' ' -f20; }   # process start time (field 22)
   112	kbd_alive() { # $1 = pid or pid:starttime (a reused pid with another start time is not ours)
   113	  set -- "${1%%:*}" "$(case "$1" in *:*) echo "${1#*:}";; esac)"
   114	  [ -d "/proc/$1" ] || return 1
   115	  [ -z "$2" ] || [ "$(kbd_st "$1")" = "$2" ] || return 1
   116	  [ "$(sed -n 's/^State:[[:space:]]*\(.\).*/\1/p' "/proc/$1/status" 2>/dev/null)" = Z ] || return 0
   117	  [ "$(ls "/proc/$1/task" 2>/dev/null | wc -l)" -gt 1 ]; }
   118	# every validated mk20-kbd pid ever signalled is persisted (/tmp/mk20/kbd-pids.rec) until it is verifiably gone: a
   119	# zombie leader has an empty cmdline, so later discovery (kbd_stop, a rollback retry) would otherwise forget a
   120	# surviving worker thread (codex kdr-r3 #1)
   121	kbd_rec() { [ $# -gt 0 ] || return 0; mkdir -p /tmp/mk20; for p in "$@"; do echo "$p:$(kbd_st "$p")"; done >> /tmp/mk20/kbd-pids.rec; }
   122	kbd_any_alive() { for p in "$@"; do kbd_alive "$p" && { echo "$p"; return 0; }; done; return 1; }
   123	kbd_hid_holders() { for p in $(kbd_pids); do for f in /proc/"$p"/fd/*; do
   124	  case "$(readlink "$f" 2>/dev/null)" in "${MK20_HIDG:-/dev/hidg0}"|"${MK20_HIDG:-/dev/hidg0} (deleted)") echo "$p"; break;; esac; done; done; }
