   132	def run_sup(dev, rel, until, env=None, t=20):
   133	    p = subprocess.Popen([BB, "sh", str(rel / "sbin/mk20d"), "kbd"], env=dict(dev.env, **(env or {})))
   134	    try:
   135	        ok = wait(until, t)
   136	        alive = p.poll() is None
   137	        dev.p("tmp/mk20-kbd-stop").write_text(""); subprocess.run(["pkill", "-f", f"{rel}/bin/mk20-kbd --run"])
   138	        p.wait(10)
   139	        return ok, alive
   140	    finally:
   141	        if p.poll() is None:
   142	            p.kill(); p.wait(5)
