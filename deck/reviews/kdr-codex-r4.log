   161	# KD stop: procd may respawn appLunch.sh right after `stop`; killing that sh later orphaned its fresh KD
   162	# (PPid 1) -> TWO KD after rollback (16:17 and 16:20). Kill appLunch.sh first, then KD, until both stay gone.
   163	kd_stop() {
   164	  [ -n "$KDSVC" ] && $KDSVC stop >>"$LOG" 2>&1 7>&-
   165	  i=0; while [ $i -lt 15 ]; do
   166	    for p in $(pgrep -f /data/appLunch.sh); do kill $p 2>/dev/null; done
   167	    killall KeyboardDevice 2>/dev/null; sleep 1
   168	    pgrep -f /data/KeyboardDevice >/dev/null || pgrep -f /data/appLunch.sh >/dev/null || { sleep 1; pgrep -f /data/KeyboardDevice >/dev/null || pgrep -f /data/appLunch.sh >/dev/null || return 0; }
   169	    i=$((i+1)); done
   170	  killall -9 KeyboardDevice 2>/dev/null; log "WARN kd_stop: KD/appLunch still alive after 15 s (sent KILL)"
   171	}
   172	# reap any KD whose parent is not appLunch.sh (orphan from a respawn race)
