   183	    pgrep -f /data/KeyboardDevice >/dev/null || { [ -x /data/KeyboardDevice ] && ( ( trap '' HUP INT; exec /data/appLunch.sh </dev/null >/dev/null 2>&1 7>&- ) & ); }   # detached (r5 #4): reparented to init
