void hid_request_close(hid_t *h);       /* async-signal-safe */
int hid_wants_pollout(const hid_t *h);  /* dirty and no hard failure */
int hid_node_replaced(const hid_t *h);  /* 1 if the open fd no longer is the node at h->path */
