   140	}
   141	# Full stop (every cleanup/setup path, after router_stop): stock KD is restarted by these paths, so mk20-kbd must not
   142	# keep running beside it. Stop file (the mk20d kbd supervisor will not relaunch), validated supervisor kill, bounded
   143	# SIGTERM (mk20-kbd sends all-keys-up), then SIGKILL. The next boot decides again.
   144	kbd_stop() {
   145	  touch /tmp/mk20-kbd-stop
   146	  kl=$(cat /tmp/mk20/kbd-loop.pid 2>/dev/null)
   147	  case "$kl" in ''|*[!0-9]*|0|1) ;; *) tr '\000' ' ' < "/proc/$kl/cmdline" 2>/dev/null | grep -q 'mk20d kbd' && kill "$kl" 2>/dev/null;; esac
