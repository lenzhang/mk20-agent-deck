   149	  krec="$(cat /tmp/mk20/kbd-pids.rec 2>/dev/null) $kps"   # every validated pid ever seen, also by earlier calls
   150	  while [ -n "$kps" ] && [ $ki -lt "${MK20_KBD_TERM_TICKS:-15}" ]; do
   151	    for kp in $kps; do kill "$kp" 2>/dev/null; done; sleep 0.2; ki=$((ki+1)); kps=$(kbd_pids); kbd_rec $kps; krec="$krec $kps"; done
