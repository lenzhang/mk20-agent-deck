   176	            }
   177	        }
   178	        if (o->status && mono_ms() >= next_status) { kbd_write_status(&k, o->status); next_status = mono_ms() + 1000; }
   179	        if (o->exit_file && o->exit_file[0] && access(o->exit_file, F_OK) == 0) {
   180	            fprintf(stderr, "mk20-kbd: %s present: exiting\n", o->exit_file); break;
   181	        }
   182	    }
   183	    if (k.hid) { hid_release_all(k.hid, 1500); hid_close(k.hid, 0); }   /* never leave RAlt stuck (r120) */
   184	    screen_stop_writers(&k.scr, 1, 500);   /* bounded drain of the last frame */
   185	    if (o->status) kbd_write_status(&k, o->status);
   186	    if (k.host_fd >= 0) close(k.host_fd);
   187	    close(gfd);
   188	    kbd_free(&k);
   189	    return 0;
   190	}
   191	
   192	static void usage(void)
   193	{
   194	    fprintf(stderr, "usage: mk20-kbd --run [--no-host] [--no-gd32-write] [--gd32 TTY] [--host TTY] [--fb DIR]\n"
   195	                    "                      [--bl DIR|''] [--status FILE] [--knob-timeout-ms N]\n"
   196	                    "                      [--no-hid | --hid PATH] [--hid-stop-file PATH] [--ptt COL,ROW (1-based)]\n"
   197	                    "                      [--lock FILE (default /tmp/mk20-kbd.lock; '' = none)] [--exit-file FILE]\n"
   198	                    "       mk20-kbd --monitor [tty] | --pattern [fbdir] | --getinfo\n"
   199	                    "  kill file " GD32_NO_WRITE_FILE " = same as --no-gd32-write\n");
   200	}
   201	
   202	int main(int argc, char **argv)
   203	{
   204	    if (argc >= 2 && !strcmp(argv[1], "--monitor")) return monitor(argc > 2 ? argv[2] : "/dev/ttyS1");
   205	    if (argc >= 2 && !strcmp(argv[1], "--pattern")) return pattern(argc > 2 ? argv[2] : "/dev");
   206	    if (argc >= 2 && !strcmp(argv[1], "--getinfo")) {
