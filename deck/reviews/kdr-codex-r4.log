    con.execute("PRAGMA journal_mode=WAL")
    con.execute(SCHEMA)
    now = time.time()
    for tid, src, orig, title, name, cwd, eff, rec, kind, arch in THREADS:
        rp = sess / f"rollout-2026-10-17T00-00-00-{tid}.jsonl"
