   204	  # mk20-kbd off too (these paths hand the panels back to stock KD); fail closed: a surviving mk20-kbd means no
   205	  # UDC/configfs change (hidg0 fd) and no KD start (two writers on ttyS1/fb)
   206	  kbd_stop || { log "FAILSAFE ABORT: mk20-kbd not stopped -> UDC/configfs untouched, KD not started"; rm -f /tmp/mk20/gadget.busy; return 1; }
   207	  touch /tmp/mk20-flapmon-stop
   208	  killall adbd 2>/dev/null
   209	  echo "" > $G/UDC 2>/dev/null
   210	  for l in $C/*; do [ -L "$l" ] && rm -f "$l"; done
   211	  rmdir $G/functions/ecm.usb0 $G/functions/hid.usb0 2>/dev/null
   212	  # stop the bridge loop + bridge, restore the real ttyGS0 (validated pid: BusyBox `kill ""` = own process group)
   213	  touch /tmp/mk20-bridge-stop; bp=$(cat /tmp/mk20-bridge-loop.pid 2>/dev/null); case "$bp" in ''|*[!0-9]*|0|1) ;; *) kill "$bp" 2>/dev/null;; esac
   214	  killall ttygs_tcp_bridge 2>/dev/null; sleep 0.5; [ -L /dev/ttyGS0 ] && rm -f /dev/ttyGS0; [ -e /dev/ttyGS0.real ] && [ ! -e /dev/ttyGS0 ] && mv /dev/ttyGS0.real /dev/ttyGS0
   215	  # KD may hold the dead PTY: restart it cleanly on real ttyGS0
   216	  # unmount the shims only after KD + appLunch.sh have exited (a running sh keeps its script busy -> EBUSY)
   217	  kd_stop
   218	  for m in /data/setusbconfig /data/appLunch.sh; do i=0; while grep -q " $m " /proc/mounts && [ $i -lt 5 ]; do umount $m 2>/dev/null || sleep 1; i=$((i+1)); done
   219	    grep -q " $m " /proc/mounts && log "WARN still mounted: $m"; done
   220	  /data/setusbconfig serial >>"$LOG" 2>&1 7>&-
   221	  kd_start
   222	  readd_adb
   223	  log "FAILSAFE done UDC=$(udc_now) acm=$([ -e $C/acm.usb0 ] && echo y || echo n) kd=$(pgrep -f KeyboardDevice | head -1)"
   224	  rm -f /tmp/mk20/gadget.busy
   225	}
   226	# rollback runs before any preflight so an abnormal state cannot block it
   227	# Transition mutex (1.1.4, r5): ONE flock (fd 7 on /tmp/mk20/transition.lock) is held for the WHOLE setup or the WHOLE
   228	# rollback, so they can never overlap (flapmon, the confirm waiter and mk20d may all ask for --rollback-now). Every
   229	# process spawned while it is held gets 7>&- (adbd, bridge loop, KD, add-adb, flapmon, confirm waiter), so only the
   230	# owner holds it and it is released when the owner exits. A rollback that finds stock verified is a no-op: exit 0
   231	# always means stock is up. Every lock step is checked (fail closed: no mutation without the mutex).
   232	# Owner-local bounded supervisor: the rollback runs cleanup in its own child and waits at most MK20_RB_TIMEOUT
   233	# (default 330 s); on timeout it stops, kills and reaps ITS OWN child tree before releasing the mutex. No caller ever
   234	# kills another owner; a waiter that cannot get the mutex in MK20_RB_LOCK_TRIES*0.25 s (default 900 s) gives up (rc 4).
   235	# >>> rollback-block (tests extract from here to the matching end marker)
   236	TL=/tmp/mk20/transition.lock
   237	stock_ok() { [ -e $C/acm.usb0 ] && [ ! -e $C/ecm.usb0 ] && [ ! -e $C/hid.usb0 ] && [ -n "$(udc_now)" ] &&
   238	  [ -c /dev/ttyGS0 ] && [ ! -L /dev/ttyGS0 ] && ! grep -qE ' /data/(setusbconfig|appLunch\.sh) ' /proc/mounts &&
   239	  pgrep -f '^/data/KeyboardDevice' >/dev/null; }
   240	rb_status() { echo "$1" > /mnt/SDCARD/gadget-ecm-hid.status 2>/dev/null; }
   241	pstart() { awk '$3 != "Z" {print $22}' "/proc/$1/stat" 2>/dev/null; }   # empty if gone or a zombie
   242	# tl_lock <tries>: take the transition mutex on fd 7 (tries 0.25 s apart; BusyBox flock has no -w). 1 = not held.
   243	tl_lock() {
   244	  mkdir -p "$(dirname "$TL")" 2>/dev/null || return 1
   245	  touch "$TL" 2>/dev/null || return 1   # an exec redirect error would exit the shell (special builtin)
   246	  exec 7>"$TL" || return 1
   247	  n=0; until flock -n 7; do n=$((n+1)); [ "$n" -ge "$1" ] && { exec 7>&-; return 1; }; sleep 0.25; done
   248	}
   249	kids() { for d in /proc/[0-9]*; do [ "$(awk '/^PPid:/{print $2}' "$d/status" 2>/dev/null)" = "$1" ] && echo "${d#/proc/}"; done; }
   250	# kill_tree prints "pid:starttime" for every process it stops (taken while STOPped, before SIGKILL reparents the
   251	# descendants to init) so bounded_wait can check the WHOLE tree afterwards (r6: an unkillable grandchild may hold fd 7).
   252	kill_tree() { kill -STOP "$1" 2>/dev/null; echo "$1:$(pstart "$1")"; for k in $(kids "$1"); do kill_tree "$k"; done; kill -9 "$1" 2>/dev/null; }
   253	# any_alive "<pid:start ...>": 0 if any listed process still runs with the same start time (not a zombie)
   254	any_alive() { for e in $1; do [ -n "${e#*:}" ] && [ "$(pstart "${e%%:*}")" = "${e#*:}" ] && return 0; done; return 1; }
   255	# uint_cap <value> <default> <min> <max>: a validated, clamped decimal (no octal, no overflow: >6 digits = max).
   256	# Every timeout/lock-try knob goes through this BEFORE any lock or fork (r5: bad arithmetic must not kill the owner).
   257	uint_cap() {
   258	  case "$1" in ''|*[!0-9]*) echo "$2"; return;; esac
   259	  v=${1#"${1%%[!0]*}"}; [ -n "$v" ] || v=0
   260	  [ ${#v} -gt 6 ] && { echo "$4"; return; }
   261	  [ "$v" -lt "$3" ] && v=$3; [ "$v" -gt "$4" ] && v=$4; echo "$v"
   262	}
   263	# r5 #5: cleanup worst case on a HEALTHY board = kd_stop<=32 + umount<=10 + kd_start<=23 + readd_adb (g1 wait<=60,
   264	# 5, add-adb ~4 x7, 6x15 re-add window) ~= 260 s -> 330 s so a healthy rollback incl. add-adb is never cut off.
   265	RBRETRY=$(uint_cap "${MK20_RB_RETRY_S:-}" 20 0 300)       # queued/manual rollback: pause before its one retry (s)
   266	RBT=$(uint_cap "${MK20_RB_TIMEOUT:-}" 330 1 900)          # rollback / post-timeout cleanup bound (s)
   267	RBTRIES=$(uint_cap "${MK20_RB_LOCK_TRIES:-}" 4400 1 4800)  # rollback mutex wait (x0.25 s = 1100 s) > worst owner hold:
   268	# setup supervisor SUT+RBT+30 verify+2x10 kill checks+20 escalate (~850 s) + fork/poll overhead (r8 #4)
   269	SUTRIES=$(uint_cap "${MK20_SETUP_LOCK_TRIES:-}" 40 1 4800) # setup mutex wait (x0.25 s)
   270	SUT=$(uint_cap "${MK20_SETUP_TIMEOUT:-}" 450 1 1800)       # whole setup incl. its own failsafe (~60 s + cleanup <=330 s)
   271	# bounded_wait <pid> <s>: 0 = the child exited in time (rc in BW_RC); 1 = timed out: its whole tree was stopped,
   272	# SIGKILLed and the child reaped; 2 = timed out AND still alive 10 s after SIGKILL (D state, e.g. a stuck UDC write):
   273	# not waited for (an unbounded wait would wedge us). "Alive" covers EVERY process of the tree snapshotted by
   274	# kill_tree, not just the root (r6). Only ever used on OUR OWN children.
   275	bounded_wait() {
   276	  bst=$(pstart "$1"); bi=0; BW_RC=1
   277	  while [ -n "$bst" ] && [ "$(pstart "$1")" = "$bst" ] && [ $bi -lt $(($2*4)) ]; do sleep 0.25; bi=$((bi+1)); done
   278	  if [ -n "$bst" ] && [ "$(pstart "$1")" = "$bst" ]; then
   279	    bsnap="$1:$bst $(kill_tree "$1")"; bi=0
   280	    while any_alive "$bsnap" && [ $bi -lt 40 ]; do sleep 0.25; bi=$((bi+1)); done
   281	    any_alive "$bsnap" && return 2
   282	    wait "$1" 2>/dev/null; return 1
   283	  fi
   284	  wait "$1" 2>/dev/null; BW_RC=$?; return 0
   285	}
   286	# escalate <why>: no transition can complete (an unkillable child holds fd 7, or stock is not reached): persist
   287	# stock mode (flag read at boot) and hard-reset via the rescue watcher (cmd-reboot) - same path as flapmon's.
   288	# r6: the writes run in a bounded child WITHOUT fd 7 (a hung FAT write cannot wedge the mutex); success = both files
   289	# exist afterwards (sync cannot mask a failed touch). 0 = escalated, 1 = could not persist (caller exits 1, not 3).
   290	# r8: BW_RC is saved/restored (callers still need their own child's rc); the writer marks success on tmpfs BEFORE
   291	# sync (a slow sync or the watcher consuming cmd-reboot is not a failure); the STUCK/ESCALATED status is written last.
   292	escalate() {
   293	  ebrc=${BW_RC:-1}; EF=${MK20_FLAP_FLAG:-/mnt/SDCARD/mk20-no-composite}; ER=${MK20_FLAP_REBOOT:-/mnt/SDCARD/cmd-reboot}
   294	  EOKF=/tmp/mk20/escalate.ok; rm -f "$EOKF"
   295	  log "ESCALATE: $1 -> $EF + reboot"
   296	  ( touch "$EF" && touch "$ER" && [ -e "$EF" ] && [ -e "$ER" ] && touch "$EOKF"; sync ) </dev/null 7>&- &
   297	  bounded_wait $! 20; ebw=$?; BW_RC=$ebrc
   298	  if [ -e "$EOKF" ]; then rm -f "$EOKF"; rb_status "$2"; return 0; fi
   299	  log "ESCALATE FAILED (bw=$ebw): $EF / $ER not persisted"; rb_status "$2-ESCALATE-FAILED"; return 1
   300	}
   301	# stuck <why> <status>: rc-3 exit (escalated; flapmon/confirm waiter do not retry). Clears gadget.busy like every
   302	# other exit under the mutex; rc 1 if the escalation itself could not be persisted.
   303	stuck() { rm -f /tmp/mk20/gadget.busy; escalate "$1" "$2" && exit 3; exit 1; }
   304	# Exit codes of --rollback-now: 0 stock verified | 1 not verified | 3 stuck+escalated | 4 refused (mutex busy: another
   305	# owner is mid-transition and owns gadget.busy) | 5 stale (r5 #7: MK20_GEN names an older composite than the current
   306	# generation in $GENF -> a queued rollback from a dead composite must not tear down a newer one; nothing touched).
   307	GENF=/tmp/mk20/composite.gen
   308	# stale only when a DIFFERENT current generation is published (GPT r7: a missing/empty token is not "stale")
   309	gen_stale() { gcur=$(cat "$GENF" 2>/dev/null); [ -n "${MK20_GEN:-}" ] && [ -n "$gcur" ] && [ "$gcur" != "$MK20_GEN" ]; }
   310	if [ "${1:-}" = --rollback-now ]; then
   311	  # GPT r7: a stale request that could not get the mutex is rc 5 (no-op), never rc 4 (callers would retry/escalate)
   312	  tl_lock "$RBTRIES" || { gen_stale && { log "rollback: mutex busy and request stale ($MK20_GEN) -> ignored"; exit 5; }
   313	    log "rollback: transition mutex not acquired (busy or lock error) -> refused"; exit 4; }
   314	  if gen_stale; then
   315	    log "rollback: stale request for generation $MK20_GEN (current $(cat "$GENF" 2>/dev/null || echo none)) -> ignored"; exit 5; fi
   316	  if stock_ok; then log "rollback already done (stock verified)"; exit 0; fi
   317	  log "rollback requested"
   318	  # r6: flapmon, the confirm waiter and mk20d retry/escalate themselves (MK20_RB_CALLER_RETRIES=1: one attempt, rc 1).
   319	  # A queued/manual run has nobody behind it: it retries once (still under the mutex) and then escalates (rc 3).
   320	  RBA=2; [ "${MK20_RB_CALLER_RETRIES:-0}" = 1 ] && RBA=1; a=0
   321	  while :; do a=$((a+1))
   322	    ( trap - EXIT INT TERM; cleanup ) </dev/null &
   323	    CP=$!
   324	    bounded_wait $CP "$RBT"; bw=$?
   325	    [ $bw = 0 ] || log "rollback cleanup exceeded ${RBT}s -> killing own child tree $CP ($([ $bw = 1 ] && echo killed+reaped || echo UNKILLABLE))"
   326	    [ $bw = 2 ] && stuck "rollback cleanup tree $CP unkillable (D state)" rollback-STUCK   # flapmon: rc 3 = no retry
   327	    rm -f /tmp/mk20/gadget.busy   # always, still under the mutex (a killed cleanup never reached its own rm)
   328	    i=0; while ! stock_ok && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done   # KD's own setusbconfig reset can lag
   329	    if stock_ok; then log "rollback verified"; rb_status rollback-verified; exit 0; fi
   330	    rb_status rollback-NOT-verified
   331	    log "rollback NOT verified, attempt $a/$RBA (acm=$([ -e $C/acm.usb0 ] && echo y || echo n) udc=$(udc_now) ttyGS0=$([ -L /dev/ttyGS0 ] && echo link || echo dev))"
   332	    [ $a -ge $RBA ] && break
   333	    sleep "$RBRETRY"
   334	  done
   335	  [ $RBA = 1 ] && exit 1   # the caller retries / escalates
   336	  stuck "queued/manual rollback not verified after $RBA attempts" rollback-NOT-verified-ESCALATED
   337	fi
   338	# <<< rollback-block
   339	
   340	# ---- preflight (nothing touched yet) ----
   341	UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
   342	[ -n "$UDC" ] || { log "ABORT no udc"; exit 1; }
   343	[ -d $G ] && [ -d $C ] || { log "ABORT no g1 (KD has not configured USB yet)"; exit 1; }
   344	[ "${1:-}" = --rollback-now ] || [ -x $BR ] || { log "ABORT $BR missing: KD would lose ttyGS0 (black screens)"; exit 1; }
   345	[ -x /bin/adbd ] || { log "ABORT no /bin/adbd"; exit 1; }
   346	grep -q '^usb_f_ecm ' /proc/modules || [ -f $ECMKO ] || { log "ABORT no $ECMKO"; exit 1; }
   347	[ -n "${MK20_REL:-}" ] && [ -f "$MK20_REL/share/flapmon.sh" ] || { log "ABORT no flapmon.sh (MK20_REL unset?)"; exit 1; }
   348	supervise_setup() {
   349	# >>> setup-supervisor (r6): the owner holds fd 7 and runs the mutating setup (and its own EXIT failsafe) in a
   350	# child bounded by MK20_SETUP_TIMEOUT. A hung service script / setusbconfig / add-adb can no longer wedge the mutex:
   351	# on timeout the owner kills+reaps ITS OWN setup tree, runs a cleanup bounded by MK20_RB_TIMEOUT (killed+reaped
   352	# too if it hangs), clears gadget.busy and only then releases fd 7 (exit). The child inherits fd 7 on purpose, so
   353	# the mutex also stays held if the owner itself dies while the child is still mutating.
   354	tl_lock "$SUTRIES" || { log "ABORT transition in progress (mutex busy) or lock error"; exit 1; }   # held until exit
   355	trap '' HUP
   356	( setup_main ) </dev/null &
   357	SP=$!
   358	bounded_wait $SP "$SUT"; bw=$?
   359	if [ $bw = 0 ]; then
   360	  src=$BW_RC; [ "$src" = 0 ] && exit 0   # r8 BLOCKER: saved before escalate() can run another bounded_wait
   361	  # setup failed and ran its own failsafe: verify stock, else escalate (flapmon is stopped at this point)
   362	  i=0; while ! stock_ok && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done
   363	  stock_ok || escalate "setup failed (rc $src) and its failsafe did not reach stock" setup-failsafe-NOT-verified
   364	  rm -f /tmp/mk20/gadget.busy; exit "$src"
   365	fi
   366	[ $bw = 2 ] && stuck "setup tree $SP unkillable after ${SUT}s (D state)" setup-STUCK
   367	log "SETUP TIMEOUT: exceeded ${SUT}s -> killed+reaped own setup tree $SP; bounded cleanup"
   368	( trap - EXIT INT TERM; OK=0; cleanup ) </dev/null &
   369	SC=$!
   370	bounded_wait $SC "$RBT"; bw=$?
   371	[ $bw = 0 ] || log "cleanup after setup timeout exceeded ${RBT}s -> killed+reaped own cleanup tree $SC"
   372	[ $bw = 2 ] && stuck "cleanup tree $SC unkillable (D state)" setup-STUCK
   373	rm -f /tmp/mk20/gadget.busy
   374	i=0; while ! stock_ok && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done
   375	if stock_ok; then rb_status setup-timeout; else escalate "setup timeout and cleanup did not reach stock" setup-timeout-NOT-verified; fi
   376	exit 1
   377	# <<< setup-supervisor
   378	}
   379	setup_main() {
   380	GEN="$(cut -d' ' -f1 /proc/uptime)-$$"; mkdir -p /tmp/mk20; echo "$GEN" > "$GENF.t" && mv -f "$GENF.t" "$GENF"   # under the mutex (r5 #7)
   381	[ "$(cat "$GENF" 2>/dev/null)" = "$GEN" ] || { log "FAIL cannot publish generation $GEN (nothing mutated)"; exit 1; }   # GPT r7
   382	touch /tmp/mk20-flapmon-stop   # r8 #5: only after the publish: a re-run: any old flap monitor / confirm waiter exits
   383	log "BEGIN udc=$UDC kdsvc=${KDSVC:-none}"
   384	
   385	trap cleanup EXIT
   386	trap 'exit 1' INT TERM
   387	trap '' HUP
   388	die() { log "FAIL $*"; exit 1; }
   389	
   390	# ---- stop KD (via procd so it is not respawned mid-change) and adbd ----
   391	kd_stop; killall adbd 2>/dev/null; sleep 1
   392	pgrep -f /data/KeyboardDevice >/dev/null && die "KD still running/respawned after stop"
   393	# ---- unbind + clean stale links ----
   394	router_stop   # 1.2.0: no open /dev/hidg0 across unbind/unlink (re-setup over a live composite)
   395	kbd_stop || die "mk20-kbd not stopped (no open /dev/hidg0 across unbind/unlink, no KD beside it)"   # stock KD restarted below; mk20d kbd retakes it after boot
   396	i=0; while [ -n "$(udc_now)" ] && [ $i -lt 10 ]; do echo "" > $G/UDC 2>/dev/null; sleep 0.3; i=$((i+1)); done
   397	[ -z "$(udc_now)" ] || die "cannot unbind"
   398	for l in $C/*; do [ -L "$l" ] && rm -f "$l"; done
   399	# ---- functions ----
   400	grep -q '^usb_f_ecm ' /proc/modules || insmod $ECMKO 2>>"$LOG" || die "insmod ecm"
   401	mkdir -p $G/functions/ecm.usb0 || die "mkdir ecm"
   402	echo "$DEV_MAC" > $G/functions/ecm.usb0/dev_addr 2>/dev/null
   403	echo "$HOST_MAC" > $G/functions/ecm.usb0/host_addr 2>/dev/null
   404	NOHID=${MK20_NOHID:-0}; [ -f /mnt/SDCARD/mk20-gadget-nohid ] && NOHID=1   # ECM+ADB+bridge only (works on the ep3-only kernel)
   405	if [ $NOHID = 0 ]; then
   406	mkdir -p $G/functions/hid.usb0 || die "mkdir hid"
   407	echo 1 > $G/functions/hid.usb0/protocol; echo 1 > $G/functions/hid.usb0/subclass
   408	echo 9 > $G/functions/hid.usb0/report_length || die "report_length"
   409	printf '\x05\x01\x09\x06\xa1\x01\x85\x01\x05\x07\x19\xe0\x29\xe7\x15\x00\x25\x01\x75\x01\x95\x08\x81\x02\x95\x01\x75\x08\x81\x03\x95\x05\x75\x01\x05\x08\x19\x01\x29\x05\x91\x02\x95\x01\x75\x03\x91\x03\x95\x06\x75\x08\x15\x00\x25\x65\x05\x07\x19\x00\x29\x65\x81\x00\xc0\x05\x01\x09\x02\xa1\x01\x85\x02\x09\x01\xa1\x00\x05\x09\x19\x01\x29\x03\x15\x00\x25\x01\x95\x03\x75\x01\x81\x02\x95\x01\x75\x05\x81\x03\x05\x01\x09\x30\x09\x31\x16\x00\x00\x26\xff\x7f\x75\x10\x95\x02\x81\x02\xc0\xc0' > /tmp/hid.desc
   410	cat /tmp/hid.desc > $G/functions/hid.usb0/report_desc || die "report_desc"
   411	fi
   412	[ "$NOADB" = 1 ] || mkdir -p $G/functions/ffs.adb || die "mkdir ffs.adb"
   413	# link order: ECM, HID, ADB
   414	ln -s $G/functions/ecm.usb0 $C/ecm.usb0 || die "link ecm"
   415	[ $NOHID = 1 ] || ln -s $G/functions/hid.usb0 $C/hid.usb0 || die "link hid"
   416	[ "$NOADB" = 1 ] || ln -s $G/functions/ffs.adb $C/ffs.adb || die "link adb"
   417	echo "ECM+HID+ADB" > $C/strings/0x409/configuration 2>/dev/null
   418	# ---- adbd BEFORE bind (writes FFS descriptors; stock adbd then binds g1/UDC itself) ----
   419	if [ "$NOADB" = 0 ]; then
   420	mkdir -p /dev/usb-ffs/adb
   421	grep -q ' /dev/usb-ffs/adb ' /proc/mounts || mount -t functionfs adb /dev/usb-ffs/adb || die "mount ffs"
   422	/bin/adbd </dev/null >/tmp/adbd.log 2>&1 7>&- &
   423	i=0; while [ ! -e /dev/usb-ffs/adb/ep1 ] && [ $i -lt 40 ]; do sleep 0.2; i=$((i+1)); done
   424	[ -e /dev/usb-ffs/adb/ep1 ] || die "adbd did not write FFS descriptors"
   425	fi
   426	i=0; while [ -z "$(udc_now)" ] && [ $i -lt 40 ]; do sleep 0.2; i=$((i+1)); done
   427	if [ -z "$(udc_now)" ]; then echo "$UDC" > $G/UDC 2>>"$LOG" || die "bind"; fi
   428	[ "$(udc_now)" = "$UDC" ] || die "UDC not bound"
   429	sleep 1
   430	[ $NOHID = 1 ] || [ -e /dev/hidg0 ] || die "no /dev/hidg0"
   431	[ -d /sys/class/net/usb0 ] || die "no usb0 netdev"
   432	ifconfig usb0 mtu 478 2>>"$LOG" || die "mtu"   # <=512B OUT requests -> PIO only (sunxi_udc DMA/bounce bug, proven 14:4x)
   433	ifconfig usb0 "$ECM_IP" netmask "$ECM_MASK" up 2>>"$LOG" || die "usb0 ip"
   434	BRIDGE_LISTEN="--dev usb0 --listen $ECM_IP:$BRIDGE_PORT"
   435	if ifconfig usb0:1 "$LL_IP" netmask 255.255.0.0 up 2>>"$LOG"; then BRIDGE_LISTEN="$BRIDGE_LISTEN --listen $LL_IP:$BRIDGE_PORT"
   436	else log "WARN link-local alias $LL_IP failed (bridge on $ECM_IP only)"; fi
   437	# 1.2.0: KD->host copy for the on-board router (release bridge only; a legacy /data bridge has no --tap)
   438	# mk20-kbd mode (MK20_KBD=1 from mk20d): no KD output to tap, mk20-kbd owns ttyGS0 and hidg0 itself
   439	[ -n "${MK20_REL:-}" ] && [ "${MK20_KBD:-0}" != 1 ] && BRIDGE_LISTEN="$BRIDGE_LISTEN --tap /tmp/mk20/kd-tap.sock"
   440	rm -f /tmp/mk20-bridge-stop
   441	# ---- KD back up on a PTY bridge; shadow setusbconfig so KD's start does not reset USB ----
   442	mkdir -p /tmp/mk20
   443	[ -e /dev/ttyGS0 ] && [ ! -L /dev/ttyGS0 ] && mv /dev/ttyGS0 /dev/ttyGS0.real
   444	( trap '' HUP INT; exec sh -c "echo \$\$ > /tmp/mk20-bridge-loop.pid; while [ ! -f /tmp/mk20-bridge-stop ]; do $BR $BRIDGE_LISTEN --link /dev/ttyGS0; sleep 1; done" </dev/null >>/tmp/mk20/bridge.log 2>&1 7>&- ) &   # supervised (tmpfs log: an open FAT file blocks hardreset's remount ro)
   445	i=0; while [ ! -e /dev/ttyGS0 ] && [ $i -lt 25 ]; do sleep 0.2; i=$((i+1)); done
   446	[ -e /dev/ttyGS0 ] || die "bridge did not create /dev/ttyGS0"
   447	printf '#!/bin/sh\necho "setusbconfig shadowed by mk20 composite: $*"\nexit 0\n' > /tmp/setusbconfig-noop; chmod 755 /tmp/setusbconfig-noop
