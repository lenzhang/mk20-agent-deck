   208	    }
   209	    if (argc >= 2 && !strcmp(argv[1], "--run")) {
   210	        struct run_opts o = {"/dev/ttyS1", "/dev/ttyGS0", "/dev", "/sys/kernel/debug/dispdbg", "/run/mk20/kbd.status",
   211	                             HID_DEFAULT_PATH, HID_DEFAULT_STOP_FILE, "/tmp/mk20-kbd.lock", NULL, 0, 0, 1000, 0, 0, 3};
   212	        for (int i = 2; i < argc; i++) {
   213	            const char *a = argv[i], *v = i + 1 < argc ? argv[i + 1] : NULL;
   214	            if (!strcmp(a, "--no-host")) o.no_host = 1;
   215	            else if (!strcmp(a, "--no-gd32-write")) o.no_write = 1;
   216	            else if (v && !strcmp(a, "--gd32")) { o.gd32 = v; i++; }
   217	            else if (v && !strcmp(a, "--host")) { o.host = v; i++; }
   218	            else if (v && !strcmp(a, "--fb")) { o.fb = v; i++; }
   219	            else if (v && !strcmp(a, "--bl")) { o.bl = v; i++; }
   220	            else if (v && !strcmp(a, "--status")) { o.status = *v ? v : NULL; i++; }
   221	            else if (v && !strcmp(a, "--knob-timeout-ms")) { o.timeout_ms = atoi(v); i++; }
   222	            else if (!strcmp(a, "--no-hid")) o.no_hid = 1;
   223	            else if (v && !strcmp(a, "--hid")) { o.hid = v; i++; }
   224	            else if (v && !strcmp(a, "--hid-stop-file")) { o.hid_stop = v; i++; }
   225	            else if (v && !strcmp(a, "--lock")) { o.lock = v; i++; }
   226	            else if (v && !strcmp(a, "--exit-file")) { o.exit_file = v; i++; }
   227	            else if (v && !strcmp(a, "--ptt")) {
   228	                int c, r;
   229	                if (sscanf(v, "%d,%d", &c, &r) != 2 || c < 1 || c > 5 || r < 1 || r > 4) { usage(); return 2; }
   230	                o.ptt_col = c - 1; o.ptt_row = r - 1; i++;
   231	            }
   232	            else { usage(); return 2; }
   233	        }
   234	        return run(&o);
   235	    }
   236	    usage();
   237	    return 2;
   238	}

