   133	  for kp in $kh; do kill "$kp" 2>/dev/null; done
   134	  ki=0; while [ -n "$(kbd_hid_holders)" ] && [ $ki -lt 10 ]; do sleep 0.2; ki=$((ki+1)); done
   135	  kh=$(kbd_hid_holders); [ -n "$kh" ] || return 0
   136	  log "mk20-kbd ignored SIGTERM -> SIGKILL $kh"; for kp in $kh; do kill -9 "$kp" 2>/dev/null; done
   137	  ki=0; while kbd_any_alive $kh >/dev/null && [ $ki -lt 20 ]; do sleep 0.1; ki=$((ki+1)); done
   138	  { [ -n "$(kbd_hid_holders)" ] || kbd_any_alive $kh >/dev/null; } && { log "FAIL mk20-kbd still holds hidg0 / threads alive after SIGKILL ($kh)"; return 1; }
