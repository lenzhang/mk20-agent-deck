    89	    if (tcgetattr(fd, &t) == 0) { cfmakeraw(&t); tcsetattr(fd, TCSANOW, &t); }
    90	    return fd;   /* stays O_NONBLOCK: replies are written with a bounded wait (kbd_host_send), never block the loop */
    91	}
    92	
    93	struct run_opts { const char *gd32, *host, *fb, *bl, *status, *hid, *hid_stop, *lock, *exit_file; int no_host, no_write, timeout_ms, no_hid, ptt_col, ptt_row; };
    94	
    95	static int run(const struct run_opts *o)
    96	{
    97	    /* single writer: a daemon-lifetime lock taken BEFORE touching ttyS1 / framebuffers (a surviving instance whose
    98	     * supervisor died keeps it; a second one exits 3) */
    99	    if (o->lock && o->lock[0]) {
   100	        int lfd = open(o->lock, O_RDWR | O_CREAT | O_CLOEXEC, 0600);
   101	        if (lfd < 0 || flock(lfd, LOCK_EX | LOCK_NB)) { fprintf(stderr, "mk20-kbd: %s busy: another instance runs\n", o->lock); return 3; }
   102	        /* lfd intentionally kept open for the process lifetime */
   103	    }
   104	    if (o->exit_file && o->exit_file[0] && access(o->exit_file, F_OK) == 0) {   /* teardown fence (gadget.sh kbd_stop) */
   105	        fprintf(stderr, "mk20-kbd: %s present: not starting\n", o->exit_file); return 0;
   106	    }
   107	    signal(SIGPIPE, SIG_IGN);
   108	    struct sigaction sa; memset(&sa, 0, sizeof sa); sa.sa_handler = on_sig;
   109	    sigaction(SIGTERM, &sa, NULL); sigaction(SIGINT, &sa, NULL);
   110	    sa.sa_handler = on_usr1; sigaction(SIGUSR1, &sa, NULL);
   111	    kbd_t k;
   112	    if (kbd_init(&k, o->fb, o->bl, KBD_VERSION)) { fprintf(stderr, "mk20-kbd: init failed\n"); return 1; }
   113	    k.ptt_col = o->ptt_col; k.ptt_row = o->ptt_row;
   114	    hid_init(&g_hid, o->hid, o->hid_stop);
   115	    if (!o->no_hid) { k.hid = &g_hid; hid_service(&g_hid, mono_ms()); }   /* open + startup all-keys-up */
   116	    k.local_ui = o->no_host;
   117	    kbd_draw_idle(&k);
   118	    if (screen_start_writers(&k.scr)) {   /* fall back to synchronous flushes */
   119	        fprintf(stderr, "mk20-kbd: writer threads failed, synchronous panel writes\n");
   120	        if (kbd_flush(&k) < 0) fprintf(stderr, "mk20-kbd: initial panel write failed (errors=%u)\n", k.scr.write_errors);
   121	    }
   122	
   123	    /* kill file: the fixed path, or an extra one from MK20_KBD_NO_WRITE_FILE (tests, TF rescue);
   124	     * either existing keeps the GD32 tty read-only. The env can only ADD a kill file. */
   125	    const char *extra = getenv("MK20_KBD_NO_WRITE_FILE");
   126	    int no_write = o->no_write || access(GD32_NO_WRITE_FILE, F_OK) == 0 || (extra && *extra && access(extra, F_OK) == 0);
   127	    int gfd = gd32_open(o->gd32, !no_write);
   128	    if (gfd < 0) { perror(o->gd32); kbd_free(&k); return 1; }
   129	    k.gd32_rw = !no_write;
   130	    gd32_parser gp; gd32_parser_init(&gp);
   131	    /* host link first, so key events arriving during knob init (<= 18 s worst case if the
   132	     * GD32 never echoes) are still forwarded */
   133	    if (!o->no_host && (k.host_fd = open_host(o->host)) >= 0) fprintf(stderr, "mk20-kbd: host link %s open\n", o->host);
   134	    long next_host_try = mono_ms() + 1000;
   135	    if (no_write) {
   136	        k.knob.state = 4;
   137	        fprintf(stderr, "mk20-kbd: GD32 write disabled (%s); knob K2 stays as configured in the GD32\n",
   138	                o->no_write ? "--no-gd32-write" : "kill file");
   139	    } else {
   140	        gd32_knob_opts ko = {o->timeout_ms, 3};
   141	        gd32_knob_init(gfd, &gp, &ko, &k.knob, kbd_gd32_cb, &k);
   142	        fprintf(stderr, "mk20-kbd: knob init %s (%d/6 slots, timeouts=%d tx_errors=%d)\n",
   143	                gd32_knob_state_name(k.knob.state), k.knob.ok_count, k.knob.timeouts, k.knob.tx_errors);
   144	    }
   145	    if (o->status) kbd_write_status(&k, o->status);
   146	
   147	    long next_status = mono_ms() + 1000;
   148	    uint8_t buf[16384];
   149	    while (!g_stop) {
   150	        long now = mono_ms();
   151	        if (!o->no_host && k.host_fd < 0 && now >= next_host_try) {
   152	            k.host_fd = open_host(o->host);
   153	            next_host_try = now + 1000;
   154	            if (k.host_fd >= 0) fprintf(stderr, "mk20-kbd: host link %s open\n", o->host);
   155	        }
   156	        if (k.hid) hid_service(k.hid, now);
   157	        struct pollfd pf[3] = {{gfd, POLLIN, 0}, {k.host_fd, POLLIN, 0}, {k.hid ? k.hid->fd : -1, POLLOUT, 0}};
   158	        int np = k.host_fd >= 0 ? 2 : 1;
   159	        if (!(k.hid && hid_wants_pollout(k.hid))) pf[2].fd = -1;
   160	        /* 100 ms tick while /dev/hidg0 is open: a stop file must close it well inside gadget.sh's window */
