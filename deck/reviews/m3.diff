+def _code(text):
+    """shell text without comments (a '#' at line start or after whitespace, outside quotes - good enough here)"""
+    out = []
+    for line in text.splitlines():
+        q = None; buf = ""
+        for i, ch in enumerate(line):
+            if q:
+                if ch == q: q = None
+            elif ch in "'\"":
+                q = ch
+            elif ch == "#" and (i == 0 or line[i - 1] in " \t;"):
+                break
+            buf += ch
+        out.append(buf)
+    return "\n".join(out)
+
