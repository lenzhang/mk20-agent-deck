   265	int kbd_write_status(kbd_t *k, const char *path)
   266	{
   267	    char tmp[256]; snprintf(tmp, sizeof tmp, "%s.tmp", path);
   268	    FILE *f = fopen(tmp, "w");
   269	    if (!f) return -1;
   270	    const gd32_knob_status *ks = &k->knob;
   271	    int panels_written = 0, dirty = 0; unsigned wr[PANEL_COUNT], werr;
   272	    screen_stats(&k->scr, wr, &werr, &dirty);
   273	    for (int i = 0; i < PANEL_COUNT; i++) panels_written += wr[i] > 0;
   274	    fprintf(f, "{\"version\":\"%s\",\"gd32_rw\":%d,\"knob_init\":\"%s\",\"knob_ok\":%d,\"knob_timeouts\":%d,"
   275	               "\"knob_tx_errors\":%d,\"panels_written\":%d,\"panels_dirty\":%d,\"write_errors\":%u,\"key_events\":%u,\"knob_events\":%u,"
   276	               "\"echo_frames\":%u,\"other_frames\":%u,\"jpg_ok\":%u,\"jpg_bad\":%u,\"jpg_size\":%u,\"json_in\":%u,"
   277	               "\"host\":%d,\"host_tx_errors\":%u,\"backlight\":%d,\"hid_open\":%d,\"hid_reopens\":%u,\"hid_replaced\":%u}\n",
   278	            k->version, k->gd32_rw, gd32_knob_state_name(ks->state), ks->ok_count, ks->timeouts, ks->tx_errors,
   279	            panels_written, dirty, werr, k->st.key_events, k->st.knob_events, k->st.echo_frames,
   280	            k->st.other_frames, k->st.jpg_ok, k->st.jpg_bad, k->st.jpg_size, k->st.json_in, k->host_fd >= 0,
   281	            k->st.host_tx_errors, k->backlight, k->hid ? k->hid->fd >= 0 : -1, k->hid ? k->hid->reopens : 0u,
   282	            k->hid ? k->hid->replaced : 0u);
   283	    if (fclose(f)) { unlink(tmp); return -1; }
   284	    return rename(tmp, path);
   285	}

