    94	    h->fd = fd; h->opens++; h->reopens++; h->hard_fail = 0; h->dirty = 1;
    95	    if (wr(h, up, sizeof up) == 0) { memcpy(h->sent, up, sizeof up); h->dirty = 0; }
    96	    flush(h);
