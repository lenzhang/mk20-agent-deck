    55	static int pattern(const char *fbdir)
    56	{
    57	    screen_t s;
    58	    if (screen_init(&s, fbdir)) return 1;
    59	    for (int i = 0; i < PANEL_COUNT; i++) {
    60	        int w = PANELS[i].w, h = PANELS[i].h;
    61	        uint16_t *px = malloc((size_t)w * h * 2);
    62	        /* stripes: count of white bars == fb number, on a bus-coloured background */
    63	        for (int y = 0; y < h; y++) for (int x = 0; x < w; x++) {
    64	            int bar = (x * (PANELS[i].fb * 2 + 1)) / w;
    65	            px[y * w + x] = (bar & 1) ? 0xFFFF : (PANELS[i].bus ? 0x001F : 0xF800);
    66	        }
    67	        screen_set_tile565(&s, PANELS[i].fb, 0, 0, w, h, px);
    68	        free(px);
    69	    }
    70	    int a = screen_flush_bus(&s, 0), b = screen_flush_bus(&s, 1);
    71	    printf("pattern written bus0=%d bus1=%d errors=%u\n", a, b, s.write_errors);
    72	    screen_free(&s);
    73	    return (a < 0 || b < 0) ? 1 : 0;
    74	}
