    13	void hid_init(hid_t *h, const char *path, const char *stop_file)
    14	{
    15	    memset(h, 0, sizeof *h);
    16	    h->fd = -1;
    17	    snprintf(h->path, sizeof h->path, "%s", path ? path : HID_DEFAULT_PATH);
    18	    snprintf(h->stop_file, sizeof h->stop_file, "%s", stop_file ? stop_file : "");
