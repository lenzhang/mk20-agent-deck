   184	/* ------------------------------------------------------------------ host frames */
   185	static void ack_json_result(kbd_t *k, uint32_t id, const char *method, const char *result)
   186	{
   187	    char j[256];
   188	    int n = snprintf(j, sizeof j, "{\"ack_method\":\"%s\",\"success\":true,\"result\":%s}", method, result);
   189	    if (n > 0 && (size_t)n < sizeof j) kbd_host_send(k, id, HOST_CMD_JSON, j, (size_t)n);
   190	}
   191	
   192	static void ack_json(kbd_t *k, uint32_t id, const char *method, int ok, const char *err)
   193	{
   194	    char j[256]; int n;
   195	    if (ok) n = snprintf(j, sizeof j, "{\"ack_method\":\"%s\",\"success\":true,\"result\":{}}", method);
   196	    else n = snprintf(j, sizeof j, "{\"ack_method\":\"%s\",\"success\":false,\"errorString\":\"%s\"}", method, err);
   197	    if (n > 0 && (size_t)n < sizeof j) kbd_host_send(k, id, HOST_CMD_JSON, j, (size_t)n);
   198	}
   199	
   200	static void on_json(kbd_t *k, const host_frame *f)
   201	{
   202	    const char *s = (const char *)f->data; size_t n = f->size;
   203	    char m[64];
   204	    k->st.json_in++;
   205	    if (kbd_json_str(s, n, "method", m, sizeof m) < 0) { k->st.json_bad++; return; }
   206	    if (!strcmp(m, "getInfo")) {
   207	        char j[8192]; int l = host_json_getinfo_ack(j, sizeof j, k->version);
   208	        if (l > 0) kbd_host_send(k, f->id, HOST_CMD_JSON, j, (size_t)l);
   209	    } else if (!strcmp(m, "setBacklight") || !strcmp(m, "setDeviceBl")) {
   210	        /* KD handleSetBacklight (@0x60eb0): needs "level" (JSON number), 0..100, then
   211	         * replies {"success":true,"result":<level>} */
   212	        long lv; char eb[96];
   213	        if (kbd_json_int(s, n, "level", &lv)) ack_json(k, f->id, m, 0, "Missing or invalid level");
   214	        else if (lv < 0 || lv > 100) {
   215	            snprintf(eb, sizeof eb, "Backlight level must be between 0 and 100, got %ld", lv);
   216	            ack_json(k, f->id, m, 0, eb);
   217	        } else if (kbd_set_backlight(k, (int)lv)) ack_json(k, f->id, m, 0, "backlight write failed");
   218	        else { char r[16]; snprintf(r, sizeof r, "%ld", lv); ack_json_result(k, f->id, m, r); }
   219	    } else {
   220	        k->st.json_unsupported++;
   221	        ack_json(k, f->id, m, 0, "unsupported");
   222	    }
   223	}
   224	
   225	static uint16_t rd16(const uint8_t *p) { return (uint16_t)(p[0] | p[1] << 8); }
   226	
   227	static void on_tile(kbd_t *k, const host_frame *f)
   228	{
   229	    /* u8 fb, u16 x, y, w, h, w*h RGB565 LE */
   230	    int ok = 0;
   231	    if (f->size >= 9) {
   232	        int fb = f->data[0], x = rd16(f->data + 1), y = rd16(f->data + 3), w = rd16(f->data + 5), h = rd16(f->data + 7);
   233	        if (w > 0 && h > 0 && (size_t)w * h * 2 + 9 == f->size) {
   234	            uint16_t *px = malloc((size_t)w * h * 2);
   235	            if (px) {
   236	                memcpy(px, f->data + 9, (size_t)w * h * 2);   /* alignment */
   237	                ok = screen_set_tile565(&k->scr, fb, x, y, w, h, px) >= 0;
   238	                free(px);
   239	            }
   240	        }
   241	    }
   242	    if (ok) { k->st.tiles++; kbd_flush(k); }
   243	    kbd_host_send(k, f->id, HOST_CMD_TILE565, ok ? "" : "E", ok ? 0 : 1);
   244	}
   245	
   246	void kbd_on_host_frame(kbd_t *k, const host_frame *f)
   247	{
   248	    switch (f->cmd) {
   249	    case HOST_CMD_JPG: {
   250	        int r = jpeg_decode565(f->data, f->size, k->canvas, CANVAS_W, CANVAS_H);
   251	        if (r == 0) { k->st.jpg_ok++; screen_set_canvas565(&k->scr, k->canvas); kbd_flush(k); }
   252	        else if (r == -2) k->st.jpg_size++;
   253	        else k->st.jpg_bad++;
   254	        /* KD semantics: empty cmd-100 frame with the same id once handled; always ack so the
   255	         * host's one-frame-in-flight pacing never stalls on a bad frame. */
   256	        kbd_host_send(k, f->id, HOST_CMD_JPG, "", 0);
   257	        break;
   258	    }
   259	    case HOST_CMD_JSON: on_json(k, f); break;
   260	    case HOST_CMD_TILE565: on_tile(k, f); break;
   261	    default: break;
   262	    }
   263	}
