   106	/* ------------------------------------------------------------------ JSON */
   107	static const char *find_key(const char *s, size_t n, const char *key)
   108	{
   109	    size_t kl = strlen(key);
   110	    for (size_t i = 0; i + kl + 2 <= n; i++) {
   111	        if (s[i] != '"' || memcmp(s + i + 1, key, kl) || s[i + 1 + kl] != '"') continue;
   112	        size_t j = i + kl + 2;
   113	        while (j < n && (s[j] == ' ' || s[j] == '\t' || s[j] == '\r' || s[j] == '\n')) j++;
   114	        if (j < n && s[j] == ':') {
   115	            j++;
   116	            while (j < n && (s[j] == ' ' || s[j] == '\t' || s[j] == '\r' || s[j] == '\n')) j++;
   117	            return j < n ? s + j : NULL;
   118	        }
   119	    }
   120	    return NULL;
   121	}
   122	
   123	int kbd_json_str(const char *s, size_t n, const char *key, char *out, size_t cap)
   124	{
   125	    const char *v = find_key(s, n, key), *end = s + n;
   126	    if (!v || *v != '"' || cap == 0) return -1;
   127	    size_t o = 0;
   128	    for (v++; v < end && *v != '"'; v++) {
   129	        if (*v == '\\' || o + 1 >= cap) return -1;   /* method names never need escapes */
   130	        out[o++] = *v;
   131	    }
   132	    if (v >= end) return -1;
   133	    out[o] = 0; return (int)o;
   134	}
   135	
   136	int kbd_json_int(const char *s, size_t n, const char *key, long *val)
   137	{
   138	    const char *v = find_key(s, n, key), *end = s + n;
   139	    if (!v) return -1;
   140	    int neg = 0; long x = 0; int digits = 0;
   141	    if (v < end && *v == '-') { neg = 1; v++; }
   142	    for (; v < end && *v >= '0' && *v <= '9' && digits < 9; v++, digits++) x = x * 10 + (*v - '0');
   143	    if (!digits) return -1;
   144	    if (v < end && *v == '.') { v++; while (v < end && *v >= '0' && *v <= '9') v++; }  /* truncate */
   145	    *val = neg ? -x : x; return 0;
   146	}
   147	
   148	/* ------------------------------------------------------------------ backlight */
   149	int kbd_bl_param(int level)
   150	{
   151	    /* KD V2.32 exactly: BacklightAdjuster = Adjuster(min 0, max 100, ctrlMin 10, ctrlMax 255)
   152	     * (@0xd16b8); Adjuster::mapToControl (@0xd1228):
   153	     *   ctrl = ctrlMin + (int)((double)(v - min) / (max - min) * (ctrlMax - ctrlMin)), clamped.
   154	     * v is clamped to [min,max] first by Adjuster::setValue (@0xd1284). Floor 10 = never dark. */
   155	    if (level < 0) level = 0;
   156	    if (level > 100) level = 100;
   157	    int c = 10 + (int)((double)level / 100.0 * 245.0);
   158	    return c < 10 ? 10 : c > 255 ? 255 : c;
   159	}
   160	
   161	static int put_file(const char *dir, const char *name, const char *val)
   162	{
   163	    char path[200]; snprintf(path, sizeof path, "%s/%s", dir, name);
   164	    int fd = open(path, O_WRONLY | O_CLOEXEC | O_TRUNC);
   165	    if (fd < 0) return -1;
   166	    size_t l = strlen(val);
   167	    ssize_t w = write(fd, val, l);
   168	    close(fd);
   169	    return w == (ssize_t)l ? 0 : -1;
   170	}
   171	
   172	int kbd_set_backlight(kbd_t *k, int level)
   173	{
   174	    if (level < 0 || level > 100) return -1;
   175	    k->backlight = level;
   176	    if (!k->bl_dir[0]) return 0;
   177	    char p[16]; snprintf(p, sizeof p, "%d", kbd_bl_param(level));
   178	    if (put_file(k->bl_dir, "name", "lcd0") || put_file(k->bl_dir, "command", "setbl") ||
   179	        put_file(k->bl_dir, "param", p) || put_file(k->bl_dir, "start", "1"))
   180	        return -2;
   181	    return 0;
   182	}
   183	
   184	/* ------------------------------------------------------------------ host frames */
   185	static void ack_json_result(kbd_t *k, uint32_t id, const char *method, const char *result)
   186	{
   187	    char j[256];
   188	    int n = snprintf(j, sizeof j, "{\"ack_method\":\"%s\",\"success\":true,\"result\":%s}", method, result);
   189	    if (n > 0 && (size_t)n < sizeof j) kbd_host_send(k, id, HOST_CMD_JSON, j, (size_t)n);
   190	}
   191	
   192	static void ack_json(kbd_t *k, uint32_t id, const char *method, int ok, const char *err)
   193	{
   194	    char j[256]; int n;
   195	    if (ok) n = snprintf(j, sizeof j, "{\"ack_method\":\"%s\",\"success\":true,\"result\":{}}", method);
   196	    else n = snprintf(j, sizeof j, "{\"ack_method\":\"%s\",\"success\":false,\"errorString\":\"%s\"}", method, err);
   197	    if (n > 0 && (size_t)n < sizeof j) kbd_host_send(k, id, HOST_CMD_JSON, j, (size_t)n);
   198	}
   199	
   200	static void on_json(kbd_t *k, const host_frame *f)
   201	{
   202	    const char *s = (const char *)f->data; size_t n = f->size;
   203	    char m[64];
   204	    k->st.json_in++;
   205	    if (kbd_json_str(s, n, "method", m, sizeof m) < 0) { k->st.json_bad++; return; }
   206	    if (!strcmp(m, "getInfo")) {
   207	        char j[8192]; int l = host_json_getinfo_ack(j, sizeof j, k->version);
   208	        if (l > 0) kbd_host_send(k, f->id, HOST_CMD_JSON, j, (size_t)l);
   209	    } else if (!strcmp(m, "setBacklight") || !strcmp(m, "setDeviceBl")) {
   210	        /* KD handleSetBacklight (@0x60eb0): needs "level" (JSON number), 0..100, then
   211	         * replies {"success":true,"result":<level>} */
   212	        long lv; char eb[96];
   213	        if (kbd_json_int(s, n, "level", &lv)) ack_json(k, f->id, m, 0, "Missing or invalid level");
   214	        else if (lv < 0 || lv > 100) {
   215	            snprintf(eb, sizeof eb, "Backlight level must be between 0 and 100, got %ld", lv);
   216	            ack_json(k, f->id, m, 0, eb);
   217	        } else if (kbd_set_backlight(k, (int)lv)) ack_json(k, f->id, m, 0, "backlight write failed");
   218	        else { char r[16]; snprintf(r, sizeof r, "%ld", lv); ack_json_result(k, f->id, m, r); }
   219	    } else {
   220	        k->st.json_unsupported++;
   221	        ack_json(k, f->id, m, 0, "unsupported");
   222	    }
   223	}
   224	
   225	static uint16_t rd16(const uint8_t *p) { return (uint16_t)(p[0] | p[1] << 8); }
   226	
   227	static void on_tile(kbd_t *k, const host_frame *f)
   228	{
   229	    /* u8 fb, u16 x, y, w, h, w*h RGB565 LE */
   230	    int ok = 0;
   231	    if (f->size >= 9) {
   232	        int fb = f->data[0], x = rd16(f->data + 1), y = rd16(f->data + 3), w = rd16(f->data + 5), h = rd16(f->data + 7);
   233	        if (w > 0 && h > 0 && (size_t)w * h * 2 + 9 == f->size) {
   234	            uint16_t *px = malloc((size_t)w * h * 2);
   235	            if (px) {
   236	                memcpy(px, f->data + 9, (size_t)w * h * 2);   /* alignment */
   237	                ok = screen_set_tile565(&k->scr, fb, x, y, w, h, px) >= 0;
   238	                free(px);
   239	            }
   240	        }
   241	    }
   242	    if (ok) { k->st.tiles++; kbd_flush(k); }
   243	    kbd_host_send(k, f->id, HOST_CMD_TILE565, ok ? "" : "E", ok ? 0 : 1);
   244	}
   245	
   246	void kbd_on_host_frame(kbd_t *k, const host_frame *f)
   247	{
   248	    switch (f->cmd) {
   249	    case HOST_CMD_JPG: {
   250	        int r = jpeg_decode565(f->data, f->size, k->canvas, CANVAS_W, CANVAS_H);
   251	        if (r == 0) { k->st.jpg_ok++; screen_set_canvas565(&k->scr, k->canvas); kbd_flush(k); }
   252	        else if (r == -2) k->st.jpg_size++;
   253	        else k->st.jpg_bad++;
   254	        /* KD semantics: empty cmd-100 frame with the same id once handled; always ack so the
   255	         * host's one-frame-in-flight pacing never stalls on a bad frame. */
   256	        kbd_host_send(k, f->id, HOST_CMD_JPG, "", 0);
   257	        break;
   258	    }
   259	    case HOST_CMD_JSON: on_json(k, f); break;
   260	    case HOST_CMD_TILE565: on_tile(k, f); break;
   261	    default: break;
   262	    }
   263	}
   264	
   265	int kbd_write_status(kbd_t *k, const char *path)
   266	{
   267	    char tmp[256]; snprintf(tmp, sizeof tmp, "%s.tmp", path);
   268	    FILE *f = fopen(tmp, "w");
   269	    if (!f) return -1;
   270	    const gd32_knob_status *ks = &k->knob;
   271	    int panels_written = 0, dirty = 0; unsigned wr[PANEL_COUNT], werr;
   272	    screen_stats(&k->scr, wr, &werr, &dirty);
   273	    for (int i = 0; i < PANEL_COUNT; i++) panels_written += wr[i] > 0;
   274	    fprintf(f, "{\"version\":\"%s\",\"gd32_rw\":%d,\"knob_init\":\"%s\",\"knob_ok\":%d,\"knob_timeouts\":%d,"
   275	               "\"knob_tx_errors\":%d,\"panels_written\":%d,\"panels_dirty\":%d,\"write_errors\":%u,\"key_events\":%u,\"knob_events\":%u,"
   276	               "\"echo_frames\":%u,\"other_frames\":%u,\"jpg_ok\":%u,\"jpg_bad\":%u,\"jpg_size\":%u,\"json_in\":%u,"
   277	               "\"host\":%d,\"host_tx_errors\":%u,\"backlight\":%d,\"hid_open\":%d,\"hid_reopens\":%u,\"hid_replaced\":%u}\n",
   278	            k->version, k->gd32_rw, gd32_knob_state_name(ks->state), ks->ok_count, ks->timeouts, ks->tx_errors,
   279	            panels_written, dirty, werr, k->st.key_events, k->st.knob_events, k->st.echo_frames,
   280	            k->st.other_frames, k->st.jpg_ok, k->st.jpg_bad, k->st.jpg_size, k->st.json_in, k->host_fd >= 0,
   281	            k->st.host_tx_errors, k->backlight, k->hid ? k->hid->fd >= 0 : -1, k->hid ? k->hid->reopens : 0u,
   282	            k->hid ? k->hid->replaced : 0u);
   283	    if (fclose(f)) { unlink(tmp); return -1; }
   284	    return rename(tmp, path);
   285	}
/* mk20-kbd core: glue between the GD32 link, the host link and the screens.
 * Pure functions over fds so tests can drive it with socketpairs/temp dirs. */
#ifndef MK20_KBD_H
#define MK20_KBD_H
#include "gd32.h"
#include "gd32io.h"
#include "hid.h"
#include "host.h"
#include "screen.h"
#include <stdint.h>

#define KBD_EVENT_ID 0xFFFFFFFFu   /* KD: device-originated events use id 0xFFFFFFFF */

typedef struct {
    int host_fd;          /* -1 = no host link (local mode) */
    int local_ui;         /* 1 = draw key feedback locally (no-host mode) */
    screen_t scr;
    host_parser hp;
    uint16_t *canvas;     /* CANVAS_W x CANVAS_H */
    char bl_dir[128];     /* dispdbg dir; "" = backlight disabled */
    const char *version;
    int backlight;        /* last level 0..100, -1 unknown */
    gd32_knob_status knob;
    int gd32_rw;
    hid_t *hid;           /* NULL = no HID output */
    int ptt_col, ptt_row; /* firmware coords (0-based) of the push-to-talk key; default doc (1,4) */          /* 1 if the tty was opened for writing (knob init allowed) */
    struct {
        uint32_t jpg_ok, jpg_bad, jpg_size, tiles, json_in, json_unsupported, json_bad,
                 key_events, knob_events, echo_frames, other_frames, keycode_nonzero,
                 host_tx, host_tx_errors, flush_errors, panel_writes;
    } st;
} kbd_t;

int kbd_init(kbd_t *k, const char *fbdir, const char *bl_dir, const char *version);
void kbd_free(kbd_t *k);
/* One parsed GD32 payload (key event, echo, other). */
void kbd_on_gd32(kbd_t *k, const uint8_t *pl, int len);
void kbd_gd32_cb(void *ctx, const uint8_t *pl, int len);   /* adapter for gd32_knob_init */
/* Raw bytes from the host link. */
void kbd_host_feed(kbd_t *k, const uint8_t *d, size_t n);
void kbd_on_host_frame(kbd_t *k, const host_frame *f);
int kbd_host_send(kbd_t *k, uint32_t id, uint32_t cmd, const void *pl, size_t n);
/* Backlight 0..100 via dispdbg (name=lcd0, command=setbl, param, start). */
int kbd_set_backlight(kbd_t *k, int level);
int kbd_bl_param(int level);
/* Flush both buses. Returns panels written or -1. */
int kbd_flush(kbd_t *k);
/* Boot pattern on all 21 panels (selftest: 21/21 written). */
void kbd_draw_idle(kbd_t *k);
void kbd_draw_key(kbd_t *k, int row, int col, int pressed);
/* JSON helpers (tiny, tolerant). */
int kbd_json_str(const char *s, size_t n, const char *key, char *out, size_t cap);
int kbd_json_int(const char *s, size_t n, const char *key, long *v);
int kbd_write_status(kbd_t *k, const char *path);
#endif

