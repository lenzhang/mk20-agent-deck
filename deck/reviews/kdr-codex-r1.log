    27	{
    28	    if (k->host_fd < 0) return -1;
    29	    size_t cap = n + HOST_HDR + 4;
    30	    uint8_t stackbuf[4096], *out = cap <= sizeof stackbuf ? stackbuf : malloc(cap);
    31	    if (!out) return -1;
    32	    int len = host_encode(id, cmd, pl, n, out, cap), rc = 0;
    33	    if (len < 0) rc = -1;
    34	    for (int off = 0; rc == 0 && off < len;) {
    35	        ssize_t w = write(k->host_fd, out + off, (size_t)(len - off));
    36	        if (w < 0) { if (errno == EINTR) continue; rc = -1; break; }
    37	        off += (int)w;
    38	    }
    39	    if (out != stackbuf) free(out);
    40	    if (rc) k->st.host_tx_errors++; else k->st.host_tx++;
    41	    return rc;
    42	}
