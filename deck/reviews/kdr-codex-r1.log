   106	/* ------------------------------------------------------------------ JSON */
   107	static const char *find_key(const char *s, size_t n, const char *key)
   108	{
   109	    size_t kl = strlen(key);
   110	    for (size_t i = 0; i + kl + 2 <= n; i++) {
   111	        if (s[i] != '"' || memcmp(s + i + 1, key, kl) || s[i + 1 + kl] != '"') continue;
   112	        size_t j = i + kl + 2;
   113	        while (j < n && (s[j] == ' ' || s[j] == '\t' || s[j] == '\r' || s[j] == '\n')) j++;
   114	        if (j < n && s[j] == ':') {
   115	            j++;
   116	            while (j < n && (s[j] == ' ' || s[j] == '\t' || s[j] == '\r' || s[j] == '\n')) j++;
   117	            return j < n ? s + j : NULL;
   118	        }
   119	    }
   120	    return NULL;
   121	}
   122	
   123	int kbd_json_str(const char *s, size_t n, const char *key, char *out, size_t cap)
   124	{
   125	    const char *v = find_key(s, n, key), *end = s + n;
   126	    if (!v || *v != '"' || cap == 0) return -1;
   127	    size_t o = 0;
   128	    for (v++; v < end && *v != '"'; v++) {
   129	        if (*v == '\\' || o + 1 >= cap) return -1;   /* method names never need escapes */
   130	        out[o++] = *v;
   131	    }
   132	    if (v >= end) return -1;
   133	    out[o] = 0; return (int)o;
   134	}
   135	
   136	int kbd_json_int(const char *s, size_t n, const char *key, long *val)
   137	{
   138	    const char *v = find_key(s, n, key), *end = s + n;
   139	    if (!v) return -1;
   140	    int neg = 0; long x = 0; int digits = 0;
   141	    if (v < end && *v == '-') { neg = 1; v++; }
   142	    for (; v < end && *v >= '0' && *v <= '9' && digits < 9; v++, digits++) x = x * 10 + (*v - '0');
   143	    if (!digits) return -1;
   144	    if (v < end && *v == '.') { v++; while (v < end && *v >= '0' && *v <= '9') v++; }  /* truncate */
   145	    *val = neg ? -x : x; return 0;
   146	}
   147	
   148	/* ------------------------------------------------------------------ backlight */
   149	int kbd_bl_param(int level)
   150	{
   151	    /* KD V2.32 exactly: BacklightAdjuster = Adjuster(min 0, max 100, ctrlMin 10, ctrlMax 255)
   152	     * (@0xd16b8); Adjuster::mapToControl (@0xd1228):
   153	     *   ctrl = ctrlMin + (int)((double)(v - min) / (max - min) * (ctrlMax - ctrlMin)), clamped.
   154	     * v is clamped to [min,max] first by Adjuster::setValue (@0xd1284). Floor 10 = never dark. */
   155	    if (level < 0) level = 0;
   156	    if (level > 100) level = 100;
   157	    int c = 10 + (int)((double)level / 100.0 * 245.0);
   158	    return c < 10 ? 10 : c > 255 ? 255 : c;
   159	}
