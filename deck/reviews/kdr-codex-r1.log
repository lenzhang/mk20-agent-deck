   118	  kh=$(kbd_hid_holders); [ -n "$kh" ] || return 0
   119	  log "mk20-kbd ignored SIGTERM -> SIGKILL $kh"; for kp in $kh; do kill -9 "$kp" 2>/dev/null; done
   120	  ki=0; while [ -n "$(kbd_hid_holders)" ] && [ $ki -lt 10 ]; do sleep 0.1; ki=$((ki+1)); done
   121	  [ -n "$(kbd_hid_holders)" ] && log "WARN mk20-kbd still holds hidg0 after SIGKILL"
