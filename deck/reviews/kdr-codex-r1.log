    41	/* try to deliver the desired keyboard state, then queued pointer reports */
    42	static void flush(hid_t *h)
    43	{
    44	    uint8_t r[HID_KBD_LEN]; kbd_report(h, r);
    45	    if (h->dirty || memcmp(r, h->sent, sizeof r)) {
    46	        h->dirty = 1;
    47	        if (wr(h, r, sizeof r) == 0) { memcpy(h->sent, r, sizeof r); h->dirty = 0; }
    48	        else return;   /* keep order: keyboard first */
    49	    }
    50	    while (h->ptr_n) {
    51	        if (wr(h, h->ptrq[h->ptr_head], HID_PTR_LEN)) return;
    52	        h->ptr_head = (h->ptr_head + 1) % 16; h->ptr_n--;
    53	    }
    54	}
