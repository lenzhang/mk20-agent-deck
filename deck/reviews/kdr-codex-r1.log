/* HID output on /dev/hidg0 (merged from deck/router/mk20_router.c, r120 fixes kept).
 * Gadget descriptor (gadget.sh): report 1 = keyboard (mods, reserved, 6 keys; 9 B with id),
 * report 2 = absolute pointer (3 buttons, X/Y 0..32767; 6 B with id), report_length 9.
 * Rules (r120):
 *  - all-keys-up on open (a crashed predecessor may have left RAlt held), on exit/EOF/signal;
 *  - state changes only on a fully accepted write; undelivered state is re-sent (dirty);
 *  - non-EAGAIN errors throttle retries to a 100 ms tick (no spin on an unbound gadget);
 *  - NEVER hold the fd across gadget teardown: when the stop file exists (gadget.sh router_stop
 *    touches it before any UDC/configfs change) or hid_request_close() was called (SIGUSR1),
 *    send a bounded all-up and close; reopen only after the stop file is gone.
 * Node replacement (fw 1.2.0 field finding): ~13 s after gadget setup the kernel tears /dev/hidg0 down and
 * recreates it (USB link drop / re-bind), leaving an early fd on "/dev/hidg0 (deleted)"; fresh opens fail ENXIO
 * until the link is up. Tina's hidg_bind() re-runs cdev_init() on the SAME embedded cdev, so CLOSING the stale fd
 * after the re-bind drops the new registration's count and later opens fail ENXIO for good (codex r121, router
 * 1.2.1). Therefore a stale fd is PARKED: kept open, never closed while the gadget lives (up to HID_MAX_PARKED
 * tracked; beyond that leaked, still never closed). Staleness = fstat vs stat (st_dev/st_ino/st_rdev), nlink 0 or
 * path gone, checked every ~1 s and immediately after a fatal write error (ENXIO/ESHUTDOWN/ENODEV/EPIPE/EBADF).
 * A fatal error on a node that is NOT stale closes/reopens nothing: retries stay on the 100 ms hard-error tick.
 * The new node is opened by path with back-off 100 ms doubling to 1 s (reset only after a delivered report), then
 * all-keys-up + the held state. Teardown (stop file / SIGUSR1, i.e. before any UDC/configfs change) closes the
 * current AND all parked fds - same as the router's SIGTERM at teardown. Limitation: if mk20-kbd dies while the
 * gadget stays up with a parked fd, hidg0 stays unopenable until the next re-bind or reboot (it keeps retrying). */
#ifndef MK20_HID_H
#define MK20_HID_H
#include <stdint.h>

#define HID_DEFAULT_PATH "/dev/hidg0"
#define HID_DEFAULT_STOP_FILE "/tmp/mk20-router-stop"
#define HID_MOD_RALT 0x40
#define HID_KBD_LEN 9
#define HID_PTR_LEN 6
#define HID_MAX_PARKED 64

typedef struct {
    char path[128], stop_file[128];
    int fd;
    uint8_t mods, keys[6];        /* desired keyboard state */
    uint8_t sent[HID_KBD_LEN];    /* last report the gadget accepted */
    int dirty, hard_fail;
    uint8_t ptrq[16][HID_PTR_LEN]; int ptr_head, ptr_n;   /* pointer reports, FIFO (button edges never dropped) */
    volatile int close_req;
    long next_open_ms, last_hard_ms;
    int parked[HID_MAX_PARKED]; unsigned nparked;   /* stale fds kept open (never closed while the gadget lives) */
    int watch, reopen_req, keep;         /* keep: reopen after replacement keeps held state; watch: fd came from open(path) -> identity is checked */
    unsigned long long dev, ino, rdev;   /* identity of the open node */
    long next_check_ms, backoff_ms;
    unsigned opens, closes, writes, eagain, errors, ptr_dropped, replaced, reopens;
} hid_t;

void hid_init(hid_t *h, const char *path, const char *stop_file);
/* Housekeeping: honours stop file / close request, (re)opens when allowed, re-sends dirty state.
 * Call on every loop tick and when the fd polls writable. */
void hid_service(hid_t *h, long now_ms);
int hid_attach_fd(hid_t *h, int fd);   /* tests: use an existing non-blocking fd (sends all-up) */
void hid_set_mod(hid_t *h, uint8_t mod, int on);
int hid_key(hid_t *h, uint8_t usage, int down);         /* -1 if 6 keys already down */
int hid_pointer_abs(hid_t *h, uint8_t buttons, uint16_t x, uint16_t y);
/* Bounded all-keys-up (default ~1.5 s, under gadget.sh's SIGTERM->SIGKILL window). 0 = delivered. */
int hid_release_all(hid_t *h, int timeout_ms);
void hid_close(hid_t *h, int release);   /* closes the current fd only */
void hid_close_parked(hid_t *h);          /* teardown only: close every parked fd */
void hid_request_close(hid_t *h);       /* async-signal-safe */
int hid_wants_pollout(const hid_t *h);  /* dirty and no hard failure */
int hid_node_replaced(const hid_t *h);  /* 1 if the open fd no longer is the node at h->path */
#endif
     1	#!/bin/sh
     2	# shellcheck disable=SC3043
     3	# MK20 Agent firmware single entry point (release tier). Launched by the rescue loader with
     4	#   MK20_REL (verified tmpfs copy of this release), MK20_VERSION, MK20_HOME (/data/mk20).
     5	#   mk20d boot      gates (kernel features, vendor hashes, config) -> composite ECM+HID+ADB+KD-bridge or stock
     6	#                   ACM+KD(+adb) -> self-test (3 samples) -> confirm with the loader (or restore stock on failure)
     7	#   mk20d health    JSON health report (stdout; also written to /tmp/mk20/health.json)
     8	#   mk20d selftest  host-independent checks, PASS/FAIL/WARN lines, rc 0 = pass
     9	#   mk20d config    effective configuration (mk20.conf + flag overrides) and warnings
    10	#   mk20d maint     detached housekeeping loop started by boot (single instance: flock): log rotation
    11	#                   (/data/mk20/logs), tmpfs bridge-log trim, periodic /tmp/mk20/health.json (MK20_MAINT_S=300 s)
    12	#   mk20d router    supervised on-board router loop started by boot (1.2.0; single instance: flock): runs
    13	#                   bin/mk20-router on the bridge tap (/tmp/mk20/kd-tap.sock) -> /dev/hidg0, restart with backoff
    14	#                   (1..30 s), ends on /tmp/mk20-router-stop, composite down, or FEATURE_ROUTER=0
    15	#                   (mk20.conf, FAT flag mk20-no-router, env MK20_ROUTER=0). Reported in selftest (INFO only, never
    16	#                   gates confirm) and health.json "router". Log: /tmp/mk20/router.log (tmpfs, trimmed by maint)
    17	#   mk20d kbd       (KD replacement, option D; opt-in FEATURE_KBD=1) supervised bin/mk20-kbd started by boot
    18	#                   instead of stock KD on a clean composite: stops stock KD via procd (/etc/init.d/qt_app2 stop,
    19	#                   retried; KD that will not stop -> mk20-kbd not started, "degraded"), runs mk20-kbd on ttyGS0 +
    20	#                   hidg0 and restarts it with backoff (1..30 s) - NEVER falls back to stock KD (OTA needs only the
    21	#                   composite + mk20d). Crash loop (3 exits in 300 s) on probation -> selftest FAIL -> loader A/B
    22	#                   rollback; after confirm -> WARN + health flags, restarts continue. Ends on /tmp/mk20-kbd-stop
    23	#                   (gadget.sh) or composite down. Status /run/mk20/kbd.status, log /tmp/mk20/kbd.log.
    24	#                   Debug/rescue-only manual overrides: /data/mk20/use-kd or FAT mk20-use-kd -> stock KD.
    25	#   mk20d version
    26	# Gate policy: kernel not in kernel/ALLOWLIST -> NO USB changes at all (KD's stock ACM stays); kernel without ecm or
    27	# vendor hash mismatch or config/flag -> stock ACM+KD+adb (adb with restore-to-serial on failure, like legacy adb.sh).
    28	R=${MK20_ROOT:-}
    29	REL=${MK20_REL:-$(cd "$(dirname "$0")/.." && pwd)}
    30	V=${MK20_VERSION:-$(sed -n 's/^version=//p' "$REL/MANIFEST" 2>/dev/null)}
    31	. "$REL/share/mk20lib.sh"
    32	TM=$R/tmp/mk20; G=$R/sys/kernel/config/usb_gadget/g1; C=$G/configs/c.1
    33	MOUNTS=${MK20_MOUNTS:-/proc/mounts}
    34	mkdir -p "$TM" "$LOGDIR" "$MK20_HOME/state" 2>/dev/null
    35	log() { mk20log "$1" mk20d "$2" "v=$V" "$3"; }
    36	
    37	p4sha() { [ -n "${MK20_P4_SHA:-}" ] && { echo "$MK20_P4_SHA"; return; }; [ -s "$TM/p4.sha" ] || sha256sum "$R/dev/by-name/boot" 2>/dev/null | cut -d' ' -f1 > "$TM/p4.sha"; cat "$TM/p4.sha"; }
    38	kernel_line() { local p; p=$(p4sha); echo "$p" | grep -Eq '^[0-9a-f]{64}$' && awk -v p="$p" '$1==p && NF>=3 {print; exit}' "$MK20_HOME/kernel/ALLOWLIST" 2>/dev/null; }   # "<sha> <name> <features>"
    39	kernel_has() { case ",$(kernel_line | cut -d' ' -f3)," in *",$1,"*) return 0;; esac; return 1; }
    40	shim_mounted() { # $1=path: our KD shim (a tmpfs file bind-mounted exactly on a known vendor path)
    41	  case "$1" in /data/appLunch.sh|/data/setusbconfig) ;; *) return 1;; esac
    42	  awk -v f="$1" '$2==f && $3=="tmpfs" {ok=1} END{exit !ok}' "$MOUNTS" 2>/dev/null; }
    43	vendor_check() { # prints "ok" or the first mismatch; all 4 vendor entries must be present and checked
    44	  local h f n; n=0
    45	  while read -r h f || [ -n "$h" ]; do
    46	    [ -n "$h" ] || continue
    47	    n=$((n+1))
    48	    shim_mounted "$f" && continue
    49	    [ "$(sha256sum "$R$f" 2>/dev/null | cut -d' ' -f1)" = "$h" ] || { echo "mismatch:$f"; return 1; }
    50	  done < "$REL/share/vendor.sha256"
    51	  [ "$n" -ge 4 ] || { echo "vendor list incomplete ($n)"; return 1; }
    52	  echo ok
    53	}
    54	num() { case "$1" in ''|*[!0-9]*) echo 0;; *) echo "$1";; esac; }
    55	kd_count() { pgrep -f '^/data/KeyboardDevice' | wc -l | tr -d ' '; }   # not -x: BusyBox 1.27 -x never matches KD (1.0.3 field failure)
    56	composite_up() { [ -e "$C/ecm.usb0" ]; }
    57	listening() { netstat -ltn 2>/dev/null | awk -v a="$1" '$4==a {ok=1} END{exit !ok}'; }   # exact local address
    58	lock_held() { ( exec 5>"$1"; ! flock -n 5 ) 2>/dev/null; }   # a live instance holds the lock
    59	router_running() { pgrep -f 'bin/mk20-router --src' >/dev/null; }
    60	kbd_running() { pgrep -f 'bin/mk20-kbd --run' >/dev/null; }
    61	KDSVC=${MK20_KDSVC:-/etc/init.d/qt_app2}   # procd service: `stop` also stops the respawn (plain kill -> respawned)
    62	KST=$R/run/mk20/kbd.status
    63	kbd_wanted() { [ "$FEATURE_KBD" = 1 ] && [ -x "$REL/bin/mk20-kbd" ]; }
    64	probation() { [ -n "$V" ] && [ "$(cat "$MK20_HOME/state/pending" 2>/dev/null)" = "$V" ]; }
    65	kbd_recent() { # mk20-kbd exits within the crash window (uptimes in $TM/kbd-crash.times)
    66	  local now; now=$(cut -d. -f1 /proc/uptime)
    67	  awk -v n="$now" -v w="${MK20_KBD_CRASH_WINDOW:-300}" '$1 ~ /^[0-9]+$/ && n - $1 < w {c++} END{print c+0}' "$TM/kbd-crash.times" 2>/dev/null || echo 0; }
    68	kbd_total() { num "$(sed -n 's/^total=\([0-9]*\).*/\1/p' "$TM/kbd.crashes" 2>/dev/null)"; }
    69	jnum() { num "$(sed -n "s/.*\"$1\": *\([0-9]*\).*/\1/p" "$KST" 2>/dev/null | head -n 1)"; }
    70	# mk20-kbd problems: FAIL on probation (no confirm -> loader rolls back to the previous release), WARN once confirmed
    71	# (a confirmed release keeps its composite/OTA path; a FAIL there would trigger the stock rollback-now)
    72	kbd_bad() { if probation; then echo "FAIL $1"; else echo "WARN $1"; fi; }
    73	kbd_status_check() { # PASS/FAIL|WARN lines for the mk20-kbd status file; rc 0 = healthy
    74	  local age kn fr pw rc; rc=0
    75	  [ -f "$KST" ] || { kbd_bad "kbd status missing ($KST)"; return 1; }
    76	  age=$(( $(date +%s) - $(num "$(stat -c %Y "$KST" 2>/dev/null)") ))
    77	  [ $age -le "${MK20_KBD_STATUS_MAX_AGE:-10}" ] && echo "PASS kbd status fresh (${age}s)" || { kbd_bad "kbd status stale (${age}s)"; rc=1; }
    78	  kn=$(jnum knob_ok); fr=$(( $(jnum key_events) + $(jnum knob_events) + $(jnum echo_frames) + $(jnum other_frames) ))
    79	  if [ "$kn" = 6 ] || [ $fr -gt 0 ]; then echo "PASS kbd gd32 knob_ok=$kn frames=$fr"; else kbd_bad "kbd gd32 silent (knob_ok=$kn frames=$fr)"; rc=1; fi
    80	  pw=$(jnum panels_written)
    81	  [ "$pw" = 21 ] && echo "PASS kbd panels 21/21" || { kbd_bad "kbd panels $pw/21"; rc=1; }
    82	  return $rc; }
    83	kd_svc() { if [ -x "$KDSVC" ]; then "$KDSVC" "$1" >>"$TM/kbd.log" 2>&1 5>&-; else log WARN kbd "no $KDSVC for $1"; return 1; fi; }
    84	wdt_armed() { ${MK20_UBUS:-ubus} call system watchdog 2>/dev/null | grep -q '"running"'; }
    85	
    86	selftest() { # FAIL = host-independent breakage. Composite rollback to stock is "degraded" (WARN): flapmon rolls back on
    87	  # host-side USB flaps, and stock ACM+KD(+adb) stays reachable. With the composite up, the link-local rescue listener is
    88	  # mandatory (1.1.0): it is the subnet-independent path, so a release that loses it must not be confirmed.
    89	  local f n; f=0
    90	  if [ -f "$TM/kbd.mode" ]; then   # mk20-kbd replaces stock KD: KD must be gone, mk20-kbd alive and healthy
    91	    local kr kt kl
    92	    n=$(kd_count); [ "$n" = 0 ] && echo "PASS kd=0 (mk20-kbd mode)" || { echo "FAIL kd=$n beside mk20-kbd"; f=1; }   # double writer: always FAIL
    93	    kl=$( { kbd_running && echo "PASS mk20-kbd running" || kbd_bad "mk20-kbd not running"; kbd_status_check
    94	      kr=$(kbd_recent); kt=$(kbd_total)
    95	      if [ "$kr" -ge "${MK20_KBD_CRASHES:-3}" ]; then kbd_bad "mk20-kbd crash loop: $kr exits in ${MK20_KBD_CRASH_WINDOW:-300}s ($kt total)"
    96	      elif [ "$kt" -gt 0 ]; then echo "INFO mk20-kbd restarted $kt times"; fi; } )
    97	    echo "$kl"; echo "$kl" | grep -q '^FAIL' && f=1
    98	  else
    99	    [ -f "$TM/kbd-degraded" ] && echo "WARN mk20-kbd not active: $(head -n 1 "$TM/kbd-degraded")"
   100	    n=$(kd_count); [ "$n" = 1 ] && echo "PASS kd=1" || { echo "FAIL kd=$n"; f=1; }
   101	  fi
   102	  [ -n "$(cat "$G/UDC" 2>/dev/null)" ] && echo "PASS udc bound" || { echo "FAIL udc unbound"; f=1; }
   103	  [ -e "$R/dev/ttyGS0" ] && echo "PASS ttyGS0" || { echo "FAIL no ttyGS0"; f=1; }
   104	  wdt_armed && echo "PASS watchdog armed" || { echo "FAIL watchdog not armed"; f=1; }
   105	  if composite_up; then
   106	    listening "$ECM_IP:$BRIDGE_PORT" && echo "PASS bridge $ECM_IP:$BRIDGE_PORT" || { echo "FAIL bridge not on $ECM_IP:$BRIDGE_PORT"; f=1; }
   107	    listening "${MK20_LL_IP:-169.254.7.2}:$BRIDGE_PORT" && echo "PASS bridge link-local" || { echo "FAIL bridge not on link-local"; f=1; }
   108	    listening "0.0.0.0:$BRIDGE_PORT" && { echo "FAIL bridge on 0.0.0.0"; f=1; }
   109	    if [ -e "$C/hid.usb0" ]; then [ -e "$R/dev/hidg0" ] && echo "PASS hid" || { echo "FAIL no hidg0"; f=1; }; fi
   110	  else echo "WARN composite down (stock ACM+KD$([ -e "$C/ffs.adb" ] && echo +adb))"
   111	    for n in /data/appLunch.sh /data/setusbconfig; do shim_mounted "$n" && { echo "FAIL shim still mounted on $n with composite down"; f=1; }; done; fi
   112	  n=$(df -Pk "$S" 2>/dev/null | awk 'END{print $4}'); case "$n" in ''|*[!0-9]*) ;; *) [ "$n" -lt 1024 ] && echo "WARN FAT free ${n} KiB";; esac
   113	  # on-board router (1.2.0): reported only (INFO), never FAIL/WARN, so it can neither block confirm nor degrade status
   114	  if [ "${FEATURE_ROUTER:-1}" != 1 ]; then echo "INFO router disabled"
   115	  elif composite_up; then router_running && echo "INFO router running" || echo "INFO router not running"; fi
   116	  return $f
   117	}
   118	
   119	jstr() { # JSON string: drop control bytes, escape backslash and quote
   120	  printf '"%s"' "$(printf '%s' "$1" | tr '\n\t' '  ' | LC_ALL=C tr -cd ' -~' | sed 's/\\/\\\\/g; s/"/\\"/g')"; }
   121	jbool() { if "$@" >/dev/null 2>&1; then echo true; else echo false; fi; }
   122	health() {
   123	  local kl up fat dat mem links l st rc mounts
   124	  cfg_load
   125	  kl=$(kernel_line); up=$(cut -d. -f1 /proc/uptime)
   126	  fat=$(df -Pk "$S" 2>/dev/null | awk 'END{print $4}'); dat=$(df -Pk "$MK20_HOME" 2>/dev/null | awk 'END{print $4}')
   127	  mem=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
   128	  links=""; for l in "$C"/*usb0 "$C"/*adb; do [ -e "$l" ] && links="$links${l##*/} "; done
   129	  st=$(selftest 2>/dev/null); rc=$?
   130	  mounts=0; for l in /data/appLunch.sh /data/setusbconfig; do shim_mounted "$l" && mounts=$((mounts+1)); done
   131	  {
   132	    printf '{'
   133	    printf '"version":%s,"uptime_s":%s,' "$(jstr "$V")" "$(num "$up")"
   134	    printf '"kernel":{"p4":%s,"name":%s,"features":%s},' "$(jstr "$(p4sha)")" "$(jstr "$(echo "$kl" | cut -d' ' -f2)")" "$(jstr "$(echo "$kl" | cut -d' ' -f3)")"
   135	    printf '"vendor":%s,' "$(jstr "$(vendor_check)")"
   136	    printf '"usb":{"udc":%s,"state":%s,"functions":%s,"composite":%s},' "$(jstr "$(cat "$G/UDC" 2>/dev/null)")" \
   137	      "$(jstr "$(cat "$R"/sys/class/udc/*/state 2>/dev/null | head -n 1)")" "$(jstr "$links")" "$(jbool composite_up)"
   138	    printf '"net":{"usb0":%s,"mtu":%s,"subnet":%s,"bridge":%s,"hidg0_writable":%s},' "$(jstr "$(ifconfig usb0 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')")" \
   139	      "$(num "$(cat "$R/sys/class/net/usb0/mtu" 2>/dev/null)")" "$(jstr "$ECM_SUBNET")" "$(jbool listening "$ECM_IP:$BRIDGE_PORT")" "$(jbool test -w "$R/dev/hidg0")"
   140	    printf '"kd":%s,"adbd":%s,"flapmon":%s,"maint":%s,"shim_mounts":%s,' "$(num "$(kd_count)")" "$(jbool pidof adbd)" \
   141	      "$(jbool pgrep -f mk20-flapmon.sh)" "$(jbool lock_held "$TM/mk20d-maint.lock")" "$mounts"
   142	    printf '"router":{"enabled":%s,"running":%s,"loop":%s,"tap":%s},' "$([ "${FEATURE_ROUTER:-1}" = 1 ] && echo true || echo false)" \
   143	      "$(jbool router_running)" "$(jbool lock_held "$TM/router.lock")" "$(jbool test -S "$TM/kd-tap.sock")"
   144	    printf '"kbd":{"enabled":%s,"mode":%s,"running":%s,"restarts":%s,"recent_crashes":%s,"degraded":%s,"status":%s},' \
   145	      "$([ "${FEATURE_KBD:-0}" = 1 ] && echo true || echo false)" "$(jbool test -f "$TM/kbd.mode")" "$(jbool kbd_running)" \
   146	      "$(kbd_total)" "$(num "$(kbd_recent)")" "$(jstr "$(head -n 1 "$TM/kbd-degraded" 2>/dev/null)")" "$(jstr "$(head -c 700 "$KST" 2>/dev/null)")"
   147	    printf '"watchdog":%s,"mem_avail_kb":%s,"fat_free_kb":%s,"data_free_kb":%s,' "$(jbool wdt_armed)" "$(num "$mem")" "$(num "$fat")" "$(num "$dat")"
   148	    printf '"release":{"good":%s,"pending":%s,"last_rollback":%s},' "$(jstr "$(head -n 1 "$MK20_HOME/state/good" 2>/dev/null)")" \
   149	      "$(jstr "$(head -n 1 "$MK20_HOME/state/pending" 2>/dev/null)")" "$(jstr "$(head -n 1 "$MK20_HOME/state/last-rollback" 2>/dev/null)")"
   150	    printf '"config":{"src":%s,"warnings":%s},' "$(jstr "$CFG_SRC")" "$(jstr "$CFG_WARN")"
   151	    printf '"selftest":{"pass":%s,"detail":%s},' "$([ "$rc" = 0 ] && echo true || echo false)" "$(jstr "$st")"
   152	    printf '"status":%s' "$(jstr "$(if [ "$rc" != 0 ]; then echo fail; elif echo "$st" | grep -q '^WARN'; then echo degraded; else echo ok; fi)")"
   153	    printf '}\n'
   154	  } > "$TM/health.json.tmp.$$" && mv -f "$TM/health.json.tmp.$$" "$TM/health.json" || { rm -f "$TM/health.json" "$TM/health.json.tmp.$$"; return 1; }
   155	  cat "$TM/health.json"
   156	}
   157	
   158	stock_adb() { # legacy adb.sh semantics: add adb beside ACM; on failure or lost ACM restore serial; bounded keepalive
   159	  local rc
   160	  sh "$REL/share/mk20-add-adb.sh" >> "$LOGDIR/gadget.log" 2>&1; rc=$?
   161	  [ $rc = 0 ] || log WARN adb "add-adb rc=$rc -> restore serial"
   162	  if [ $rc != 0 ] || [ ! -e "$R/dev/ttyGS0" ] || [ ! -e "$C/acm.usb0" ]; then
   163	    killall adbd 2>/dev/null; [ -x "$R/data/setusbconfig" ] && "$R/data/setusbconfig" serial >> "$LOGDIR/gadget.log" 2>&1; fi
   164	  [ "${MK20_ADB_KEEPALIVE:-1}" = 1 ] || return 0
   165	  ( trap '' HUP INT; exec 5>"$TM/adb-keepalive.lock"; flock -n 5 || exit 0; n=0
   166	    while [ $n -lt 5 ]; do sleep 30
   167	      [ -f "$S/mk20-no-adb" ] && exit 0
   168	      if [ ! -e "$C/ffs.adb" ] && pgrep -f KeyboardDevice >/dev/null; then sleep 10; n=$((n+1)); log INFO adb "keepalive re-add #$n"
   169	        sh "$REL/share/mk20-add-adb.sh" >> "$LOGDIR/gadget.log" 2>&1 || { killall adbd 2>/dev/null; [ -x "$R/data/setusbconfig" ] && "$R/data/setusbconfig" serial; }; fi
   170	    done ) </dev/null >/dev/null 2>&1 6>&- 7>&- 8>&- 9>&- &
   171	}
   172	
   173	case "${1:-}" in
   174	boot)
   175	  cfg_load
   176	  log_rotate "$LOGDIR/gadget.log"
   177	  log INFO boot "rel=$REL cfg=$CFG_SRC subnet=$ECM_SUBNET composite=$FEATURE_COMPOSITE hid=$FEATURE_HID adb=$FEATURE_ADB warn=$CFG_WARN"
   178	  i=0; until [ -n "$(cat "$G/UDC" 2>/dev/null)" ] && [ -e "$C/acm.usb0" ] && [ -e "$R/dev/ttyGS0" ] && pgrep -f KeyboardDevice >/dev/null; do
   179	    i=$((i+1)); [ $i -gt 120 ] && { log WARN boot "KD/g1 not up after 120 s"; break; }; sleep 1; done
   180	  sleep "${MK20_SETTLE:-20}"
   181	  MODE=composite; why=""
   182	  NOHID=0; [ "$FEATURE_HID" = 1 ] && kernel_has hid || NOHID=1
   183	  NOADB=0; [ "$FEATURE_ADB" = 1 ] || NOADB=1   # composite only; the stock fallback always adds adb (FAT flag aside)
   184	  [ "$FEATURE_COMPOSITE" = 1 ] || { MODE=stock; why="config/flag"; }
   185	  kernel_has ecm || { MODE=stock; why="${why:+$why,}kernel '$(kernel_line | cut -d' ' -f2)' lacks ecm"; }
   186	  vc=$(vendor_check) || { MODE=stock; why="${why:+$why,}vendor $vc"; }
   187	  [ -n "$(kernel_line)" ] || { MODE=none; why="kernel $(p4sha) not in kernel/ALLOWLIST"; }
   188	  rm -f "$TM/gadget.env" "$TM/kbd.mode" "$TM/kbd-degraded" "$TM/kbd.crashes" "$TM/kbd-crash.times"
