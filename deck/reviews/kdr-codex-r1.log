    23	static int gone_errno(int e) { return e == ENXIO || e == ESHUTDOWN || e == ENODEV || e == EPIPE || e == EBADF; }
    24	
    25	static void kbd_report(const hid_t *h, uint8_t *r)
    26	{
    27	    r[0] = 1; r[1] = h->mods; r[2] = 0; memcpy(r + 3, h->keys, 6);
    28	}
    29	
    30	static int wr(hid_t *h, const uint8_t *rep, size_t n)
    31	{
    32	    if (h->fd < 0) { errno = EBADF; return -1; }
    33	    ssize_t w;
    34	    do w = write(h->fd, rep, n); while (w < 0 && errno == EINTR && !h->close_req);
    35	    if (w == (ssize_t)n) { h->writes++; h->hard_fail = 0; h->backoff_ms = 100; return 0; }
    36	    if (w >= 0) errno = EIO;
    37	    if (errno == EAGAIN) h->eagain++; else { h->errors++; h->hard_fail++; if (gone_errno(errno)) h->reopen_req = 1; }   /* -> identity check now, nothing closed */
    38	    return -1;
    39	}
