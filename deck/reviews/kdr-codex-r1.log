    30	static int monitor(const char *dev)
    31	{
    32	    int fd = open_gd32_ro(dev);
    33	    if (fd < 0) { perror(dev); return 1; }
    34	    gd32_parser p; gd32_parser_init(&p);
    35	    uint8_t buf[256];
    36	    for (;;) {
    37	        ssize_t n = read(fd, buf, sizeof buf);
    38	        if (n <= 0) { perror("read"); return 1; }
    39	        for (ssize_t i = 0; i < n; i++) {
    40	            int len = gd32_feed(&p, buf[i]);
    41	            if (len <= 0) continue;
    42	            struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
    43	            gd32_key_event ev;
    44	            if (gd32_decode_key(p.buf, len, &ev) == 0)
    45	                { printf("%ld.%06ld key col=%u row=%u pressed=%u keycode=0x%04x hex=", (long)ts.tv_sec, ts.tv_nsec / 1000,
    46	                       ev.col, ev.row, ev.pressed, ev.keycode); for (int k = 0; k < len; k++) printf("%02x", p.buf[k]); printf("\n"); }
    47	            else {
    48	                printf("%ld.%06ld frame id=0x%02x len=%d hex=", (long)ts.tv_sec, ts.tv_nsec / 1000, p.buf[0], len); for (int k = 0; k < len; k++) printf("%02x", p.buf[k]); printf("\n");
    49	            }
    50	            fflush(stdout);
    51	        }
    52	    }
    53	}
