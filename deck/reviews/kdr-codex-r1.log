   124	# Full stop (every cleanup/setup path, after router_stop): stock KD is restarted by these paths, so mk20-kbd must not
   125	# keep running beside it. Stop file (the mk20d kbd supervisor will not relaunch), validated supervisor kill, bounded
   126	# SIGTERM (mk20-kbd sends all-keys-up), then SIGKILL. The next boot decides again.
   127	kbd_stop() {
   128	  touch /tmp/mk20-kbd-stop
   129	  kl=$(cat /tmp/mk20/kbd-loop.pid 2>/dev/null)
   130	  case "$kl" in ''|*[!0-9]*|0|1) ;; *) tr '\000' ' ' < "/proc/$kl/cmdline" 2>/dev/null | grep -q 'mk20d kbd' && kill "$kl" 2>/dev/null;; esac
   131	  ki=0; kps=$(kbd_pids)
   132	  while [ -n "$kps" ] && [ $ki -lt "${MK20_KBD_TERM_TICKS:-15}" ]; do
   133	    for kp in $kps; do kill "$kp" 2>/dev/null; done; sleep 0.2; ki=$((ki+1)); kps=$(kbd_pids); done
   134	  if [ -n "$kps" ]; then log "mk20-kbd did not exit on SIGTERM -> SIGKILL $kps"; for kp in $kps; do kill -9 "$kp" 2>/dev/null; done
   135	    ki=0; while [ -n "$(kbd_pids)" ] && [ $ki -lt 10 ]; do sleep 0.1; ki=$((ki+1)); done; fi
   136	  rm -f /tmp/mk20/kbd.mode
   137	  return 0
   138	}
	if (!IS_ERR(f)) {
