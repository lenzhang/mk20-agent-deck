    58	int hid_attach_fd(hid_t *h, int fd)
    59	{
    60	    h->fd = fd; h->opens++; h->hard_fail = 0;
    61	    memset(h->keys, 0, sizeof h->keys); h->mods = 0; h->dirty = 1;   /* startup all-keys-up */
    62	    flush(h);
    63	    return 0;
    64	}
