    99	void kbd_host_feed(kbd_t *k, const uint8_t *d, size_t n)
   100	{
   101	    host_push(&k->hp, d, n);
   102	    host_frame f;
   103	    while (host_next(&k->hp, &f)) kbd_on_host_frame(k, &f);
   104	}
