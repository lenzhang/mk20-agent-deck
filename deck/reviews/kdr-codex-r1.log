    74	void hid_close_parked(hid_t *h)
    75	{
    76	    unsigned n = h->nparked < HID_MAX_PARKED ? h->nparked : HID_MAX_PARKED;
    77	    for (unsigned i = 0; i < n; i++) close(h->parked[i]);
    78	    h->nparked = 0;
