    81	int hid_node_replaced(const hid_t *h)
    82	{
    83	    struct stat a, b;
    84	    if (h->fd < 0 || fstat(h->fd, &a)) return 1;
    85	    if (a.st_nlink == 0) return 1;                       /* "/dev/hidg0 (deleted)" */
    86	    if (stat(h->path, &b)) return 1;                     /* node gone (link down, re-creating) */
    87	    return a.st_dev != b.st_dev || a.st_ino != b.st_ino || a.st_rdev != b.st_rdev;
