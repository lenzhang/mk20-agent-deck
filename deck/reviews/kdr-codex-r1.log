    10	int kbd_init(kbd_t *k, const char *fbdir, const char *bl_dir, const char *version)
    11	{
    12	    memset(k, 0, sizeof *k);
    13	    k->host_fd = -1; k->backlight = -1; k->ptt_col = 0; k->ptt_row = 3; k->version = version ? version : "mk20-kbd";
    14	    snprintf(k->bl_dir, sizeof k->bl_dir, "%s", bl_dir ? bl_dir : "");
    15	    if (screen_init(&k->scr, fbdir)) return -1;
    16	    if (host_parser_init(&k->hp, 2u << 20)) return -1;   /* full-canvas JPEG is << 1 MiB */
    17	    k->canvas = calloc((size_t)CANVAS_W * CANVAS_H, 2);
    18	    return k->canvas ? 0 : -1;
    19	}
    20	
    21	void kbd_free(kbd_t *k)
    22	{
    23	    screen_free(&k->scr); host_parser_free(&k->hp); free(k->canvas); k->canvas = NULL;
    24	}
    25	
    26	int kbd_host_send(kbd_t *k, uint32_t id, uint32_t cmd, const void *pl, size_t n)
    27	{
    28	    if (k->host_fd < 0) return -1;
    29	    size_t cap = n + HOST_HDR + 4;
    30	    uint8_t stackbuf[4096], *out = cap <= sizeof stackbuf ? stackbuf : malloc(cap);
    31	    if (!out) return -1;
    32	    int len = host_encode(id, cmd, pl, n, out, cap), rc = 0;
    33	    if (len < 0) rc = -1;
    34	    for (int off = 0; rc == 0 && off < len;) {
    35	        ssize_t w = write(k->host_fd, out + off, (size_t)(len - off));
    36	        if (w < 0) { if (errno == EINTR) continue; rc = -1; break; }
    37	        off += (int)w;
    38	    }
    39	    if (out != stackbuf) free(out);
    40	    if (rc) k->st.host_tx_errors++; else k->st.host_tx++;
    41	    return rc;
    42	}
    43	
    44	int kbd_flush(kbd_t *k)
    45	{
    46	    if (k->scr.threaded) return 0;   /* writer threads pick dirty panels up themselves */
    47	    int a = screen_flush_bus(&k->scr, 0), b = screen_flush_bus(&k->scr, 1);
    48	    if (a < 0 || b < 0) { k->st.flush_errors++; return -1; }
    49	    k->st.panel_writes += (uint32_t)(a + b);
    50	    return a + b;
    51	}
    52	
    53	static void fill_panel(kbd_t *k, int fb, uint16_t bg, uint16_t fg, int bars)
    54	{
    55	    const panel_t *p = &PANELS[fb - 1];
    56	    uint16_t *px = malloc((size_t)p->w * p->h * 2);
    57	    if (!px) return;
    58	    for (int y = 0; y < p->h; y++) for (int x = 0; x < p->w; x++) {
    59	        int bar = bars ? (x * (bars * 2 + 1)) / p->w : 0;
    60	        int edge = y < 4 && bars;  /* small top marker */
    61	        px[y * p->w + x] = ((bar & 1) || edge) ? fg : bg;
    62	    }
    63	    screen_set_tile565(&k->scr, fb, 0, 0, p->w, p->h, px);
    64	    free(px);
    65	}
    66	
    67	void kbd_draw_idle(kbd_t *k)
    68	{
    69	    for (int i = 0; i < PANEL_COUNT; i++) fill_panel(k, PANELS[i].fb, 0x0841, 0x4208, PANELS[i].is_key ? 1 : 0);
    70	}
    71	
    72	void kbd_draw_key(kbd_t *k, int row, int col, int pressed)
    73	{
    74	    if (row < 0 || row > 3 || col < 0 || col > 4) return;
    75	    int fb = row * 5 + col + 1;
    76	    if (pressed) fill_panel(k, fb, 0xFFFF, 0xFFFF, 0); else fill_panel(k, fb, 0x0841, 0x4208, 1);
    77	}
