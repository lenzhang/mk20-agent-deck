   302	    [ $bw = 2 ] && stuck "rollback cleanup tree $CP unkillable (D state)" rollback-STUCK   # flapmon: rc 3 = no retry
   303	    rm -f /tmp/mk20/gadget.busy   # always, still under the mutex (a killed cleanup never reached its own rm)
   304	    i=0; while ! stock_ok && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done   # KD's own setusbconfig reset can lag
   305	    if stock_ok; then log "rollback verified"; rb_status rollback-verified; exit 0; fi
   306	    rb_status rollback-NOT-verified
   307	    log "rollback NOT verified, attempt $a/$RBA (acm=$([ -e $C/acm.usb0 ] && echo y || echo n) udc=$(udc_now) ttyGS0=$([ -L /dev/ttyGS0 ] && echo link || echo dev))"
   308	    [ $a -ge $RBA ] && break
   309	    sleep "$RBRETRY"
   310	  done
   311	  [ $RBA = 1 ] && exit 1   # the caller retries / escalates
   312	  stuck "queued/manual rollback not verified after $RBA attempts" rollback-NOT-verified-ESCALATED
   313	fi
   314	# <<< rollback-block
   315	
   316	# ---- preflight (nothing touched yet) ----
   317	UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
   318	[ -n "$UDC" ] || { log "ABORT no udc"; exit 1; }
   319	[ -d $G ] && [ -d $C ] || { log "ABORT no g1 (KD has not configured USB yet)"; exit 1; }
   320	[ "${1:-}" = --rollback-now ] || [ -x $BR ] || { log "ABORT $BR missing: KD would lose ttyGS0 (black screens)"; exit 1; }
   321	[ -x /bin/adbd ] || { log "ABORT no /bin/adbd"; exit 1; }
   322	grep -q '^usb_f_ecm ' /proc/modules || [ -f $ECMKO ] || { log "ABORT no $ECMKO"; exit 1; }
   323	[ -n "${MK20_REL:-}" ] && [ -f "$MK20_REL/share/flapmon.sh" ] || { log "ABORT no flapmon.sh (MK20_REL unset?)"; exit 1; }
   324	supervise_setup() {
   325	# >>> setup-supervisor (r6): the owner holds fd 7 and runs the mutating setup (and its own EXIT failsafe) in a
   326	# child bounded by MK20_SETUP_TIMEOUT. A hung service script / setusbconfig / add-adb can no longer wedge the mutex:
   327	# on timeout the owner kills+reaps ITS OWN setup tree, runs a cleanup bounded by MK20_RB_TIMEOUT (killed+reaped
   328	# too if it hangs), clears gadget.busy and only then releases fd 7 (exit). The child inherits fd 7 on purpose, so
   329	# the mutex also stays held if the owner itself dies while the child is still mutating.
   330	tl_lock "$SUTRIES" || { log "ABORT transition in progress (mutex busy) or lock error"; exit 1; }   # held until exit
   331	trap '' HUP
   332	( setup_main ) </dev/null &
   333	SP=$!
   334	bounded_wait $SP "$SUT"; bw=$?
   335	if [ $bw = 0 ]; then
   336	  src=$BW_RC; [ "$src" = 0 ] && exit 0   # r8 BLOCKER: saved before escalate() can run another bounded_wait
   337	  # setup failed and ran its own failsafe: verify stock, else escalate (flapmon is stopped at this point)
   338	  i=0; while ! stock_ok && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done
   339	  stock_ok || escalate "setup failed (rc $src) and its failsafe did not reach stock" setup-failsafe-NOT-verified
   340	  rm -f /tmp/mk20/gadget.busy; exit "$src"
   341	fi
   342	[ $bw = 2 ] && stuck "setup tree $SP unkillable after ${SUT}s (D state)" setup-STUCK
   343	log "SETUP TIMEOUT: exceeded ${SUT}s -> killed+reaped own setup tree $SP; bounded cleanup"
   344	( trap - EXIT INT TERM; OK=0; cleanup ) </dev/null &
   345	SC=$!
   346	bounded_wait $SC "$RBT"; bw=$?
   347	[ $bw = 0 ] || log "cleanup after setup timeout exceeded ${RBT}s -> killed+reaped own cleanup tree $SC"
   348	[ $bw = 2 ] && stuck "cleanup tree $SC unkillable (D state)" setup-STUCK
   349	rm -f /tmp/mk20/gadget.busy
   350	i=0; while ! stock_ok && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done
   351	if stock_ok; then rb_status setup-timeout; else escalate "setup timeout and cleanup did not reach stock" setup-timeout-NOT-verified; fi
   352	exit 1
   353	# <<< setup-supervisor
   354	}
