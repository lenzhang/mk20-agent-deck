#include "gd32.h"
#include <string.h>

_Static_assert(GD32_OUT_SET_KEYCODE != GD32_FORBIDDEN_BOOTLOADER_JUMP && GD32_OUT_SET_KEYCODE != 0x02,
               "forbidden GD32 command in allow-list");
_Static_assert(GD32_KNOB_SLOT_FIRST == 100 && GD32_KNOB_SLOT_LAST == 105,
               "0x05 rows <100 write the QMK EEPROM keymap; only encoder slots 100..105 are RAM");

static const uint8_t forbidden_clear[4] = {0x02, 0xAA, 0xE2, 0x78};

enum { S_AA, S_55, S_SUM, S_LEN, S_NLEN, S_DATA, S_F5, S_5F };

void gd32_parser_init(gd32_parser *p) { memset(p, 0, sizeof *p); }
static int feed1(gd32_parser *p, uint8_t b);

/* Wrapper with re-scan: when a candidate frame fails (bad ~LEN, tail or sum),
 * the bytes after its AA are fed again, so a truncated frame cannot swallow the
 * start of the next valid one. */
int gd32_feed(gd32_parser *p, uint8_t b)
{
    int was_idle = (p->state == 0);
    uint32_t fails_before = p->bad_len + p->bad_tail + p->bad_sum;
    if (!was_idle || b == 0xAA) {
        if (p->rawn < (int)sizeof p->raw) p->raw[p->rawn++] = b;
    }
    int r = feed1(p, b);
    if (r > 0 || p->state == 0) {
        int failed = (p->bad_len + p->bad_tail + p->bad_sum) != fails_before;
        if (failed && p->depth < 4 && p->rawn > 1) {
            uint8_t tmp[sizeof p->raw]; int n = p->rawn - 1;
            memcpy(tmp, p->raw + 1, (size_t)n);
            p->rawn = 0; p->state = 0; p->depth++;
            int got = 0; uint8_t stash[GD32_MAX_PAYLOAD];
            for (int i = 0; i < n; i++) { int g = gd32_feed(p, tmp[i]); if (g > 0) { got = g; memcpy(stash, p->buf, (size_t)g); } }
            p->depth--;
            if (got > 0) memcpy(p->buf, stash, (size_t)got); /* later partial candidate may have reused buf */
            return got;
        }
        if (p->state == 0) p->rawn = 0;
    } else if (p->state == 1 && p->rawn > 1 && b == 0xAA) {
        p->raw[0] = 0xAA; p->rawn = 1; /* restarted on a new AA */
    }
    return r;
}

static int feed1(gd32_parser *p, uint8_t b)
{
    switch (p->state) {
    case S_AA: if (b == 0xAA) p->state = S_55; else p->resync_bytes++; return 0;
    case S_55:
        if (b == 0x55) p->state = S_SUM;
        else { p->resync_bytes++; p->state = (b == 0xAA) ? S_55 : S_AA; }
        return 0;
    case S_SUM: p->sum = b; p->state = S_LEN; return 0;
    case S_LEN: p->len = b; p->state = S_NLEN; return 0;
    case S_NLEN:
        if ((uint8_t)~p->len != b || p->len == 0 || p->len > GD32_MAX_IN_PAYLOAD) { p->bad_len++; p->state = (b == 0xAA) ? S_55 : S_AA; return 0; }
        p->n = 0; p->state = S_DATA; return 0;
    case S_DATA:
        p->buf[p->n++] = b;
        if (p->n == p->len) p->state = S_F5;
        return 0;
    case S_F5:
        if (b != 0xF5) { p->bad_tail++; p->state = (b == 0xAA) ? S_55 : S_AA; return 0; }
        p->state = S_5F; return 0;
    case S_5F: {
        p->state = S_AA;
        if (b != 0x5F) { p->bad_tail++; if (b == 0xAA) p->state = S_55; return 0; }
        uint8_t s = 0;
        for (int i = 0; i < p->len; i++) s += p->buf[i];
        if (s != p->sum) { p->bad_sum++; return 0; }
        p->frames_ok++;
        return p->len;
    }
    }
    p->state = S_AA;
    return 0;
}

int gd32_decode_key(const uint8_t *pl, int len, gd32_key_event *ev)
{
    if (len < 4 || pl[0] != GD32_IN_KEY_EVENT) return -1;
    ev->pressed = pl[1] ? 1 : 0;
    ev->row = pl[2];
    ev->col = pl[3];
    ev->keycode = (len >= 6) ? (uint16_t)((pl[4] << 8) | pl[5]) : 0;
    ev->knob = 0; ev->knob_action = KNOB_NONE;
    if (ev->row == ev->col && ev->row >= 100 && ev->row <= 105) {
        int i = ev->row - 100;
        ev->knob = (uint8_t)(1 + i / 3);
        ev->knob_action = (uint8_t)(KNOB_PRESS + i % 3);
    }
    return 0;
}

int gd32_raw_is_forbidden(const uint8_t *raw, size_t len)
{
    for (size_t i = 0; i + 4 <= len; i++)
        if (!memcmp(raw + i, forbidden_clear, 4)) return 1;
    /* any frame whose first payload byte is 0x19 */
    for (size_t i = 0; i + 6 <= len; i++)
        if (raw[i] == 0xAA && raw[i + 1] == 0x55 && (uint8_t)~raw[i + 3] == raw[i + 4] &&
            raw[i + 5] == GD32_FORBIDDEN_BOOTLOADER_JUMP)
            return 1;
    return 0;
}

int gd32_knob_payload(int slot, uint8_t out[GD32_KNOB_PAYLOAD_LEN])
{
    if (slot < GD32_KNOB_SLOT_FIRST || slot > GD32_KNOB_SLOT_LAST) return -1;
    out[0] = GD32_OUT_SET_KEYCODE; out[1] = 0; out[2] = (uint8_t)slot; out[3] = (uint8_t)slot; out[4] = 0; out[5] = 0;
    return GD32_KNOB_PAYLOAD_LEN;
}

int gd32_out_allowed(const uint8_t *pl, size_t len)
{
    if (!pl || len != GD32_KNOB_PAYLOAD_LEN) return 0;
    if (pl[0] != GD32_OUT_SET_KEYCODE) return 0;          /* also excludes 0x19, 0x02, 0x0A, 0x0B, ... */
    if (pl[1] != 0) return 0;                               /* layer 0 */
    if (pl[2] < GD32_KNOB_SLOT_FIRST || pl[2] > GD32_KNOB_SLOT_LAST) return 0; /* <100 = EEPROM keymap */
    if (pl[3] != pl[2]) return 0;                           /* col == row, as KD writes it */
    if (pl[4] != 0 || pl[5] != 0) return 0;                 /* KC_NO only: report over serial */
    if (gd32_raw_is_forbidden(pl, len)) return 0;
    return 1;
}

static int build(const uint8_t *pl, size_t len, uint8_t *out, size_t cap)
{
    if (len == 0 || len > GD32_MAX_PAYLOAD || cap < len + GD32_FRAME_OVERHEAD) return -1;
    uint8_t s = 0;
    for (size_t i = 0; i < len; i++) s += pl[i];
    out[0] = 0xAA; out[1] = 0x55; out[2] = s; out[3] = (uint8_t)len; out[4] = (uint8_t)~len;
    memcpy(out + 5, pl, len);
    out[5 + len] = 0xF5; out[6 + len] = 0x5F;
    return (int)(len + GD32_FRAME_OVERHEAD);
}

int gd32_encode(const uint8_t *pl, size_t len, uint8_t *out, size_t cap)
{
    if (!gd32_out_allowed(pl, len)) return -1;
    int n = build(pl, len, out, cap);
    if (n < 0 || gd32_raw_is_forbidden(out, (size_t)n)) return -1;
    return n;
}

int gd32_build_test_frame(const uint8_t *pl, size_t len, uint8_t *out, size_t cap)
{
    return build(pl, len, out, cap);
}
#include "gd32io.h"
#include <errno.h>
#include <fcntl.h>
#include <poll.h>
#include <string.h>
#include <termios.h>
#include <time.h>
#include <unistd.h>

int gd32_open(const char *dev, int rw)
{
    int fd = open(dev, (rw ? O_RDWR : O_RDONLY) | O_NOCTTY | O_CLOEXEC);
    if (fd < 0) return -1;
    struct termios t;
    if (tcgetattr(fd, &t) == 0) {
        cfmakeraw(&t); cfsetispeed(&t, B115200); cfsetospeed(&t, B115200);
        t.c_cflag |= CLOCAL | CREAD; t.c_cflag &= ~(CSTOPB | PARENB | CRTSCTS);
        t.c_cc[VMIN] = 1; t.c_cc[VTIME] = 0;
        tcsetattr(fd, TCSANOW, &t);
    }
    return fd;
}

int gd32_tx(int fd, const uint8_t *pl, size_t len)
{
    uint8_t fr[GD32_MAX_PAYLOAD + GD32_FRAME_OVERHEAD];
    int n = gd32_encode(pl, len, fr, sizeof fr);
    if (n < 0 || gd32_raw_is_forbidden(fr, (size_t)n)) { errno = EPERM; return -1; }
    const uint8_t *b = fr; size_t left = (size_t)n;
    while (left) {
        ssize_t w = write(fd, b, left);
        if (w < 0) { if (errno == EINTR) continue; return -1; }
        b += w; left -= (size_t)w;
    }
    return 0;
}

const char *gd32_knob_state_name(int s)
{
    static const char *n[] = {"not_run", "ok", "partial", "failed", "disabled"};
    return (s >= 0 && s <= 4) ? n[s] : "?";
}

static long now_ms(void)
{
    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1000L + ts.tv_nsec / 1000000L;
}

/* wait for the echo of want[] for up to timeout_ms; 1 = got it, 0 = timeout, -1 = read error */
static int wait_echo(int fd, gd32_parser *p, const uint8_t *want, int timeout_ms, gd32_knob_status *st, gd32_frame_cb cb, void *ctx)
{
    long deadline = now_ms() + timeout_ms;
    for (;;) {
        long left = deadline - now_ms();
        if (left <= 0) return 0;
        struct pollfd pf = {fd, POLLIN, 0};
        int r = poll(&pf, 1, (int)left);
        if (r < 0) { if (errno == EINTR) continue; return -1; }
        if (r == 0) return 0;
        uint8_t buf[256];
        ssize_t n = read(fd, buf, sizeof buf);
        if (n < 0) { if (errno == EINTR || errno == EAGAIN) continue; return -1; }
        if (n == 0) return -1;
        int got = 0;
        for (ssize_t i = 0; i < n; i++) {
            int len = gd32_feed(p, buf[i]);
            if (len <= 0) continue;
            if (len == GD32_KNOB_PAYLOAD_LEN && !memcmp(p->buf, want, GD32_KNOB_PAYLOAD_LEN)) { got = 1; continue; }
            if (p->buf[0] == GD32_IN_ECHO) { st->stale_echoes++; continue; }  /* e.g. KD leftovers */
            st->foreign_frames++;
            if (cb) cb(ctx, p->buf, len);
        }
        if (got) return 1; /* rest of this read was already dispatched */
    }
}

int gd32_knob_init(int fd, gd32_parser *p, const gd32_knob_opts *o, gd32_knob_status *st, gd32_frame_cb cb, void *ctx)
{
    int to = (o && o->timeout_ms > 0) ? o->timeout_ms : 1000;
    int att = (o && o->attempts > 0) ? o->attempts : 3;
    memset(st, 0, sizeof *st);
    for (int i = 0; i < 6; i++) {
        uint8_t pl[GD32_KNOB_PAYLOAD_LEN];
        gd32_knob_payload(GD32_KNOB_SLOT_FIRST + i, pl);
        for (int a = 0; a < att && !st->slot_ok[i]; a++) {
            st->slot_attempts[i]++;
            if (gd32_tx(fd, pl, sizeof pl)) { st->tx_errors++; continue; }
            int r = wait_echo(fd, p, pl, to, st, cb, ctx);
            if (r == 1) st->slot_ok[i] = 1;
            else if (r == 0) st->timeouts++;
            else st->tx_errors++;
        }
        st->ok_count += st->slot_ok[i];
    }
    st->state = st->ok_count == 6 ? 1 : st->ok_count ? 2 : 3;
    return st->ok_count;
}
/* mk20-kbd: GD32 <-> T113 link on /dev/ttyS1 (115200 8N1).
 * Frame (from KD V2.32 STM32CommunicationObject::packFrame/parseByte):
 *   AA 55 SUM LEN ~LEN payload[LEN] F5 5F      SUM = 8-bit sum of payload
 * SAFETY: outbound frames are restricted to an allow-list. 0x19
 * (request_bootloader_jump) and the raw clearState bytes 02 AA E2 78 can
 * never be emitted by this module (compile-time + runtime + tests). */
#ifndef MK20_GD32_H
#define MK20_GD32_H
#include <stddef.h>
#include <stdint.h>

#define GD32_MAX_PAYLOAD 255
#define GD32_FRAME_OVERHEAD 7
/* Longest inbound payload we accept. GD32 replies are VIA-sized (<= 32 B); capping
 * LEN makes a false header (e.g. a truncated frame followed by AA 55 ...) fail fast
 * instead of swallowing up to 255 following bytes. */
#define GD32_MAX_IN_PAYLOAD 64

/* inbound payload[0] ids observed in KD processData() */
enum gd32_in_id {
    GD32_IN_KEYCODE_ACK = 0x05,
    GD32_IN_MACRO_SIZE  = 0x0D,
    GD32_IN_MACRO_ACK   = 0x0F,
    GD32_IN_MACRO_RESET = 0x10,
    GD32_IN_KEY_EVENT   = 0x16,
};

/* Forbidden outbound ids: never listed in the allow-list. */
#define GD32_FORBIDDEN_BOOTLOADER_JUMP 0x19

/* Outbound allow-list (K2-KNOB-CONFIG.md). EXACTLY ONE frame shape may ever be
 * sent: the 6-byte payload  05 00 r r 00 00  with r in 100..105, i.e. "set GD32
 * encoder slot r to KC_NO" (GD32 RAM only, .bss, cleared at GD32 reset). Every
 * other payload is refused, in particular:
 *   - id 0x19 (bootloader jump) and any buffer containing 02 AA E2 78,
 *   - id 0x05 with row < 100 (dynamic_keymap_set_keycode -> QMK EEPROM write),
 *   - id 0x05 with row > 105, non-zero layer/keycode, col != row, other lengths. */
#define GD32_OUT_SET_KEYCODE 0x05
#define GD32_KNOB_SLOT_FIRST 100
#define GD32_KNOB_SLOT_LAST  105
#define GD32_KNOB_PAYLOAD_LEN 6
#define GD32_IN_ECHO GD32_IN_KEYCODE_ACK  /* GD32 echoes each 0x05 frame identically */

typedef struct {
    int state;
    uint8_t sum, len, n;
    uint8_t buf[GD32_MAX_PAYLOAD];
    uint8_t raw[GD32_MAX_PAYLOAD + GD32_FRAME_OVERHEAD]; /* bytes of the current candidate, for re-scan */
    int rawn, depth;
    /* stats */
    uint32_t frames_ok, bad_sum, bad_len, bad_tail, resync_bytes;
} gd32_parser;

/* Event 16 P R C KH KL. Measured 2026-10-19 (K2-RESULTS.md): byte 2 is the
 * physical row 0..3, byte 3 the column 0..4; stock KD forwarded them to the host
 * as keyStateChanged{col=C,row=R} (0-based, no transposition: NOTES-device-
 * 2026-10-17.md; KD signature VideoPlayer::keyStateChanged(pressed,row,col)).
 * Knobs: R == C in 100..105 (K1 100 press/101 ccw/102 cw, K2 103/104/105). */
enum { KNOB_NONE = 0, KNOB_PRESS = 1, KNOB_CCW = 2, KNOB_CW = 3 };
typedef struct {
    uint8_t pressed;   /* payload[1] (!=0 => pressed) */
    uint8_t row;       /* payload[2]; knobs use row==col >= 100 */
    uint8_t col;       /* payload[3] */
    uint8_t knob;      /* 0 = matrix key, 1 = K1, 2 = K2 */
    uint8_t knob_action; /* KNOB_PRESS/CCW/CW when knob != 0 */
    uint16_t keycode;  /* payload[4]<<8 | payload[5]: QMK keycode at (row,col),
                          0 == KC_NO. KD's VideoPlayer::keyStateChanged only runs
                          its local action when both bytes are 0 (keyCodeH/L). */
} gd32_key_event;

void gd32_parser_init(gd32_parser *p);
/* Feed one byte. Returns payload length (>0) when a full valid frame is in
 * p->buf, else 0. */
int gd32_feed(gd32_parser *p, uint8_t b);
/* Decode a 0x16 payload. Returns 0 on success, -1 if not a key event. */
int gd32_decode_key(const uint8_t *payload, int len, gd32_key_event *ev);

/* Build the one allow-listed payload for slot r (100..105). Returns 6 or -1. */
int gd32_knob_payload(int slot, uint8_t out[GD32_KNOB_PAYLOAD_LEN]);
/* Is this outbound payload allowed? (runtime check) */
int gd32_out_allowed(const uint8_t *payload, size_t len);
/* Encode an outbound frame into out (cap bytes). Returns frame length or
 * -1 if refused (not allow-listed / forbidden / too long). */
int gd32_encode(const uint8_t *payload, size_t len, uint8_t *out, size_t cap);
/* Inbound-style frame builder for tests/simulators ONLY (no allow-list,
 * never linked to a tty writer). */
int gd32_build_test_frame(const uint8_t *payload, size_t len, uint8_t *out, size_t cap);
/* Final gate used by the tty writer: scans the raw bytes for the forbidden
 * clearState sequence and for a 0x19 command frame. */
int gd32_raw_is_forbidden(const uint8_t *raw, size_t len);
