     9	uint32_t host_crc32(const uint8_t *p, size_t n)
    10	{
    11	    static uint32_t t[256]; static int init;
    12	    if (!init) {
    13	        for (uint32_t i = 0; i < 256; i++) { uint32_t c = i; for (int k = 0; k < 8; k++) c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1; t[i] = c; }
