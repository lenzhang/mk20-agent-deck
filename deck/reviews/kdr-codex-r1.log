    79	void kbd_gd32_cb(void *ctx, const uint8_t *pl, int len) { kbd_on_gd32((kbd_t *)ctx, pl, len); }
    80	
    81	void kbd_on_gd32(kbd_t *k, const uint8_t *pl, int len)
    82	{
    83	    if (len <= 0) return;
    84	    if (pl[0] == GD32_IN_ECHO) { k->st.echo_frames++; return; }   /* 0x05 echo: never an event */
    85	    gd32_key_event ev;
    86	    if (gd32_decode_key(pl, len, &ev)) { k->st.other_frames++; return; }
    87	    if (ev.knob) k->st.knob_events++;
    88	    else if (ev.row > 3 || ev.col > 4) { k->st.other_frames++; return; }
    89	    else k->st.key_events++;
    90	    if (ev.keycode) k->st.keycode_nonzero++;   /* GD32 already sent HID itself; still report the state */
    91	    char j[160];
    92	    int n = host_json_key_state(j, sizeof j, ev.col, ev.row, ev.pressed);
    93	    if (n > 0 && k->host_fd >= 0) kbd_host_send(k, KBD_EVENT_ID, HOST_CMD_JSON, j, (size_t)n);
    94	    /* router (r120): PTT key holds Right Alt/Option while pressed; every other key and the knobs are local */
    95	    if (k->hid && !ev.knob && ev.col == k->ptt_col && ev.row == k->ptt_row) hid_set_mod(k->hid, HID_MOD_RALT, ev.pressed);
    96	    if (k->local_ui && !ev.knob) { kbd_draw_key(k, ev.row, ev.col, ev.pressed); kbd_flush(k); }
    97	}
