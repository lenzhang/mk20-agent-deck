   161	static int put_file(const char *dir, const char *name, const char *val)
   162	{
   163	    char path[200]; snprintf(path, sizeof path, "%s/%s", dir, name);
   164	    int fd = open(path, O_WRONLY | O_CLOEXEC | O_TRUNC);
   165	    if (fd < 0) return -1;
   166	    size_t l = strlen(val);
   167	    ssize_t w = write(fd, val, l);
   168	    close(fd);
   169	    return w == (ssize_t)l ? 0 : -1;
   170	}
   171	
   172	int kbd_set_backlight(kbd_t *k, int level)
   173	{
   174	    if (level < 0 || level > 100) return -1;
   175	    k->backlight = level;
   176	    if (!k->bl_dir[0]) return 0;
   177	    char p[16]; snprintf(p, sizeof p, "%d", kbd_bl_param(level));
   178	    if (put_file(k->bl_dir, "name", "lcd0") || put_file(k->bl_dir, "command", "setbl") ||
   179	        put_file(k->bl_dir, "param", p) || put_file(k->bl_dir, "start", "1"))
   180	        return -2;
   181	    return 0;
   182	}
