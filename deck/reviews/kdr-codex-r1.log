    66	void hid_close(hid_t *h, int release)
    67	{
    68	    if (h->fd < 0) return;
    69	    if (release) hid_release_all(h, 300);   /* short: teardown is waiting */
    70	    close(h->fd); h->fd = -1; h->closes++;
    71	    h->ptr_n = 0; h->watch = 0; h->reopen_req = 0; h->keep = 0;
    72	}
