    21	static uint8_t *dec(const uint8_t *jpg, size_t n, int w, int h, int *err)
    22	{
    23	    int iw, ih, comp;
    24	    if (!jpg || n < 4 || n > (64u << 20)) { *err = -1; return NULL; }
    25	    if (!stbi_info_from_memory(jpg, (int)n, &iw, &ih, &comp)) { *err = -1; return NULL; }
    26	    if (iw != w || ih != h) { *err = -2; return NULL; }   /* check before allocating */
    27	    uint8_t *px = stbi_load_from_memory(jpg, (int)n, &iw, &ih, &comp, 3);
    28	    if (!px) { *err = -1; return NULL; }
    29	    if (iw != w || ih != h) { stbi_image_free(px); *err = -2; return NULL; }
    30	    *err = 0; return px;
    31	}
