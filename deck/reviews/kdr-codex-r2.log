    78	int gd32_knob_init(int fd, gd32_parser *p, const gd32_knob_opts *o, gd32_knob_status *st, gd32_frame_cb cb, void *ctx)
    79	{
    80	    int to = (o && o->timeout_ms > 0) ? o->timeout_ms : 1000;
    81	    int att = (o && o->attempts > 0) ? o->attempts : 3;
    82	    memset(st, 0, sizeof *st);
    83	    for (int i = 0; i < 6; i++) {
    84	        uint8_t pl[GD32_KNOB_PAYLOAD_LEN];
    85	        gd32_knob_payload(GD32_KNOB_SLOT_FIRST + i, pl);
    86	        for (int a = 0; a < att && !st->slot_ok[i]; a++) {
    87	            st->slot_attempts[i]++;
    88	            if (gd32_tx(fd, pl, sizeof pl)) { st->tx_errors++; continue; }
    89	            int r = wait_echo(fd, p, pl, to, st, cb, ctx);
    90	            if (r == 1) st->slot_ok[i] = 1;
    91	            else if (r == 0) st->timeouts++;
    92	            else st->tx_errors++;
    93	        }
    94	        st->ok_count += st->slot_ok[i];
    95	    }
    96	    st->state = st->ok_count == 6 ? 1 : st->ok_count ? 2 : 3;
    97	    return st->ok_count;
    98	}
