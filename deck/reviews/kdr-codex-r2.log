    23	int host_parser_init(host_parser *p, size_t cap)
    24	{ memset(p, 0, sizeof *p); p->buf = malloc(cap); p->cap = cap; return p->buf ? 0 : -1; }
    25	void host_parser_free(host_parser *p) { free(p->buf); p->buf = NULL; }
    26	
    27	static void drop(host_parser *p, size_t n)
    28	{ if (n > p->len) n = p->len; memmove(p->buf, p->buf + n, p->len - n); p->len -= n; }
    29	
    30	int host_push(host_parser *p, const uint8_t *d, size_t n)
    31	{
    32	    if (n > p->cap - p->len) { /* overflow: keep newest data, resync later */
    33	        p->dropped_bytes += p->len; p->len = 0;
    34	        if (n > p->cap) { p->dropped_bytes += n - p->cap; d += n - p->cap; n = p->cap; }
    35	    }
    36	    memcpy(p->buf + p->len, d, n); p->len += n; return 0;
    37	}
    38	
    39	int host_next(host_parser *p, host_frame *f)
    40	{
    41	    if (p->consumed) { drop(p, p->consumed); p->consumed = 0; }
    42	    for (;;) {
    43	        size_t i = 0;
    44	        while (i + 4 <= p->len && memcmp(p->buf + i, HDR, 4)) i++;
    45	        if (i + 4 > p->len) { size_t keep = p->len < 3 ? p->len : 3; p->dropped_bytes += p->len - keep; drop(p, p->len - keep); return 0; }
    46	        if (i) { p->dropped_bytes += i; drop(p, i); }
    47	        if (p->len < HOST_HDR) return 0;
    48	        uint32_t size = get32(p->buf + 12);
    49	        uint8_t sz[4]; put32(sz, size);
    50	        if (get32(p->buf + 16) != host_crc32(sz, 4)) { p->bad_size_crc++; drop(p, 1); continue; }
    51	        if (size > HOST_MAX_PAYLOAD || size + HOST_HDR + 4 > p->cap) { p->oversize++; drop(p, 1); continue; }
    52	        if (p->len < HOST_HDR + size + 4) return 0;
    53	        if (get32(p->buf + HOST_HDR + size) != host_crc32(p->buf + HOST_HDR, size)) { p->bad_data_crc++; drop(p, 1); continue; }
    54	        f->id = get32(p->buf + 4); f->cmd = get32(p->buf + 8); f->size = size; f->data = p->buf + HOST_HDR;
    55	        p->consumed = HOST_HDR + size + 4; p->frames_ok++;
    56	        return 1;
    57	    }
    58	}
