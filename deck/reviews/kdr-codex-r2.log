    87	static int write_buf(screen_t *s, int i, const uint16_t *buf)
    88	{
    89	    char path[160];
    90	    snprintf(path, sizeof path, "%s/fb%d", s->fbdir, PANELS[i].fb);
    91	    int fd = open(path, O_WRONLY | O_CLOEXEC);
    92	    if (fd < 0) return -1;
    93	    const uint8_t *b = (const uint8_t *)buf;
    94	    size_t left = px_count(i) * 2;
    95	    while (left) {
    96	        ssize_t w = write(fd, b, left);
    97	        if (w < 0) { if (errno == EINTR) continue; close(fd); return -1; }
    98	        b += w; left -= (size_t)w;
    99	    }
   100	    fsync(fd); /* fbtft: forces the deferred-io flush now (KD does the same) */
   101	    close(fd);
   102	    unsigned d = __atomic_load_n(&s->write_delay_us, __ATOMIC_RELAXED);
   103	    if (d) usleep(d);
   104	    return 0;
   105	}
   106	
   107	int screen_flush_bus(screen_t *s, int bus)
   108	{
   109	    int n = 0;
   110	    for (int i = 0; i < PANEL_COUNT; i++) {
   111	        if (PANELS[i].bus != bus || !s->dirty[i]) continue;
   112	        if (write_buf(s, i, s->pending[i])) { s->write_errors++; return -1; }
   113	        memcpy(s->shadow[i], s->pending[i], px_count(i) * 2);
   114	        s->dirty[i] = 0; s->writes[i]++; n++;
   115	    }
   116	    return n;
   117	}
   118	
   119	static int next_dirty(screen_t *s, int bus, int *rr)
   120	{
   121	    for (int k = 0; k < PANEL_COUNT; k++) {
   122	        int i = (*rr + k) % PANEL_COUNT;
   123	        if (PANELS[i].bus == bus && s->dirty[i]) { *rr = i + 1; return i; }
   124	    }
   125	    return -1;
   126	}
