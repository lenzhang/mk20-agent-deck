    13	        for (uint32_t i = 0; i < 256; i++) { uint32_t c = i; for (int k = 0; k < 8; k++) c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1; t[i] = c; }
    14	        init = 1;
    15	    }
    16	    uint32_t c = 0xFFFFFFFFu;
    17	    for (size_t i = 0; i < n; i++) c = t[(c ^ p[i]) & 0xFF] ^ (c >> 8);
    18	    return c ^ 0xFFFFFFFFu;
    19	}
    20	static void put32(uint8_t *o, uint32_t v) { o[0] = v; o[1] = v >> 8; o[2] = v >> 16; o[3] = v >> 24; }
    21	static uint32_t get32(const uint8_t *o) { return o[0] | o[1] << 8 | o[2] << 16 | (uint32_t)o[3] << 24; }
