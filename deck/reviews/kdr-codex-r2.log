   208	static void ack_json(kbd_t *k, uint32_t id, const char *method, int ok, const char *err)
   209	{
   210	    char j[256]; int n;
   211	    if (ok) n = snprintf(j, sizeof j, "{\"ack_method\":\"%s\",\"success\":true,\"result\":{}}", method);
   212	    else n = snprintf(j, sizeof j, "{\"ack_method\":\"%s\",\"success\":false,\"errorString\":\"%s\"}", method, err);
   213	    if (n > 0 && (size_t)n < sizeof j) kbd_host_send(k, id, HOST_CMD_JSON, j, (size_t)n);
