    12	LOG_MAX_KB=${LOG_MAX_KB:-256}; LOG_KEEP=${LOG_KEEP:-3}
    13	log_rotate() { # $1=file
    14	  local _f _i _j; _f=$1; [ -f "$_f" ] || return 0
    15	  [ "$(wc -c < "$_f")" -gt $((LOG_MAX_KB * 1024)) ] || return 0
    16	  _i=$LOG_KEEP; while [ "$_i" -gt 1 ]; do _j=$((_i-1)); [ -f "$_f.$_j" ] && mv -f "$_f.$_j" "$_f.$_i"; _i=$_j; done
    17	  mv -f "$_f" "$_f.1"
