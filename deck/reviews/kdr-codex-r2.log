   122	/* ------------------------------------------------------------------ JSON */
   123	static const char *find_key(const char *s, size_t n, const char *key)
   124	{
   125	    size_t kl = strlen(key);
   126	    for (size_t i = 0; i + kl + 2 <= n; i++) {
   127	        if (s[i] != '"' || memcmp(s + i + 1, key, kl) || s[i + 1 + kl] != '"') continue;
   128	        size_t j = i + kl + 2;
   129	        while (j < n && (s[j] == ' ' || s[j] == '\t' || s[j] == '\r' || s[j] == '\n')) j++;
   130	        if (j < n && s[j] == ':') {
   131	            j++;
   132	            while (j < n && (s[j] == ' ' || s[j] == '\t' || s[j] == '\r' || s[j] == '\n')) j++;
   133	            return j < n ? s + j : NULL;
   134	        }
   135	    }
   136	    return NULL;
   137	}
   138	
   139	int kbd_json_str(const char *s, size_t n, const char *key, char *out, size_t cap)
   140	{
   141	    const char *v = find_key(s, n, key), *end = s + n;
   142	    if (!v || *v != '"' || cap == 0) return -1;
   143	    size_t o = 0;
   144	    for (v++; v < end && *v != '"'; v++) {
   145	        if (*v == '\\' || o + 1 >= cap) return -1;   /* method names never need escapes */
   146	        out[o++] = *v;
   147	    }
   148	    if (v >= end) return -1;
   149	    out[o] = 0; return (int)o;
   150	}
   151	
   152	int kbd_json_int(const char *s, size_t n, const char *key, long *val)
   153	{
   154	    const char *v = find_key(s, n, key), *end = s + n;
   155	    if (!v) return -1;
   156	    int neg = 0; long x = 0; int digits = 0;
   157	    if (v < end && *v == '-') { neg = 1; v++; }
   158	    for (; v < end && *v >= '0' && *v <= '9' && digits < 9; v++, digits++) x = x * 10 + (*v - '0');
   159	    if (!digits) return -1;
   160	    if (v < end && *v == '.') { v++; while (v < end && *v >= '0' && *v <= '9') v++; }  /* truncate */
   161	    *val = neg ? -x : x; return 0;
   162	}
