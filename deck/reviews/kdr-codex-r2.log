    14	def _bbdir(tmp):
    15	    """PATH dir of busybox applet symlinks so scripts run against busybox tools, not GNU coreutils."""
    16	    d = tmp / "bb"
    17	    d.mkdir()
    18	    bb = BB
    19	    (d / "busybox").symlink_to(bb)
    20	    for a in subprocess.run([bb, "--list"], capture_output=True, text=True).stdout.split():
    21	        if a in ("flock", "mount", "pgrep", "ubus", "busybox"):
    22	            continue
    23	        (d / a).symlink_to(bb)
    24	    return d
