    60	def _kill_strays(tmp):
    61	    """Kill every process still running a script from this test's tmp dir (e.g. the detached loader-deadline.sh
    62	    poller, which loops forever under the fixed test uptime). Test artifacts only: matched by the tmp path."""
    63	    import signal
    64	    key = str(tmp).encode()
    65	    for d in pathlib.Path("/proc").glob("[0-9]*"):
    66	        try:
    67	            if key in (d / "cmdline").read_bytes() and int(d.name) != os.getpid():
    68	                os.kill(int(d.name), signal.SIGKILL)
    69	        except (OSError, ValueError):
    70	            pass
