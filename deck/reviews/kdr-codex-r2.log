    60	int host_encode(uint32_t id, uint32_t cmd, const uint8_t *pl, size_t n, uint8_t *out, size_t cap)
    61	{
    62	    if (n > HOST_MAX_PAYLOAD || cap < n + HOST_HDR + 4) return -1;
    63	    memcpy(out, HDR, 4); put32(out + 4, id); put32(out + 8, cmd); put32(out + 12, (uint32_t)n);
    64	    uint8_t sz[4]; put32(sz, (uint32_t)n); put32(out + 16, host_crc32(sz, 4));
    65	    if (n) memcpy(out + HOST_HDR, pl, n);
    66	    put32(out + HOST_HDR + n, host_crc32(pl, n));
    67	    return (int)(n + HOST_HDR + 4);
    68	}
