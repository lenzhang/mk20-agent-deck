     1	#!/bin/sh
     2	# shellcheck disable=SC3043
     3	# MK20 Agent firmware single entry point (release tier). Launched by the rescue loader with
     4	#   MK20_REL (verified tmpfs copy of this release), MK20_VERSION, MK20_HOME (/data/mk20).
     5	#   mk20d boot      gates (kernel features, vendor hashes, config) -> composite ECM+HID+ADB+KD-bridge or stock
     6	#                   ACM+KD(+adb) -> self-test (3 samples) -> confirm with the loader (or restore stock on failure)
     7	#   mk20d health    JSON health report (stdout; also written to /tmp/mk20/health.json)
     8	#   mk20d selftest  host-independent checks, PASS/FAIL/WARN lines, rc 0 = pass
     9	#   mk20d config    effective configuration (mk20.conf + flag overrides) and warnings
    10	#   mk20d maint     detached housekeeping loop started by boot (single instance: flock): log rotation
    11	#                   (/data/mk20/logs), tmpfs bridge-log trim, periodic /tmp/mk20/health.json (MK20_MAINT_S=300 s)
    12	#   mk20d router    supervised on-board router loop started by boot (1.2.0; single instance: flock): runs
    13	#                   bin/mk20-router on the bridge tap (/tmp/mk20/kd-tap.sock) -> /dev/hidg0, restart with backoff
    14	#                   (1..30 s), ends on /tmp/mk20-router-stop, composite down, or FEATURE_ROUTER=0
    15	#                   (mk20.conf, FAT flag mk20-no-router, env MK20_ROUTER=0). Reported in selftest (INFO only, never
    16	#                   gates confirm) and health.json "router". Log: /tmp/mk20/router.log (tmpfs, trimmed by maint)
    17	#   mk20d kbd       (KD replacement, option D; opt-in FEATURE_KBD=1) supervised bin/mk20-kbd started by boot
    18	#                   instead of stock KD on a clean composite: stops stock KD via procd (/etc/init.d/qt_app2 stop,
    19	#                   retried; KD that will not stop -> mk20-kbd not started, "degraded"), runs mk20-kbd on ttyGS0 +
    20	#                   hidg0 and restarts it with backoff (1..30 s) - NEVER falls back to stock KD (OTA needs only the
    21	#                   composite + mk20d). Crash loop (3 exits in 300 s) on probation -> selftest FAIL -> loader A/B
    22	#                   rollback; after confirm -> WARN + health flags, restarts continue. Ends on /tmp/mk20-kbd-stop
    23	#                   (gadget.sh) or composite down. Status /run/mk20/kbd.status, log /tmp/mk20/kbd.log.
    24	#                   Debug/rescue-only manual overrides: /data/mk20/use-kd or FAT mk20-use-kd -> stock KD.
    25	#                   HID: mk20-kbd recovers hidg0 IN-PROCESS (stale node parked, never closed; reopen with back-off)
    26	#                   and never exits for HID reasons. A RESTART after the ~74 s USB re-bind closes the parked fd and
    27	#                   (Tina f_hid cdev_init quirk) leaves /dev/hidg0 ENXIO until reboot: panels/keys/host still work,
    28	#                   selftest WARNs "hidg0 not open after restart" (reboot clears it). Never restart it for HID.
    29	#   mk20d version
    30	# Gate policy: kernel not in kernel/ALLOWLIST -> NO USB changes at all (KD's stock ACM stays); kernel without ecm or
    31	# vendor hash mismatch or config/flag -> stock ACM+KD+adb (adb with restore-to-serial on failure, like legacy adb.sh).
    32	R=${MK20_ROOT:-}
    33	REL=${MK20_REL:-$(cd "$(dirname "$0")/.." && pwd)}
    34	V=${MK20_VERSION:-$(sed -n 's/^version=//p' "$REL/MANIFEST" 2>/dev/null)}
    35	. "$REL/share/mk20lib.sh"
    36	TM=$R/tmp/mk20; G=$R/sys/kernel/config/usb_gadget/g1; C=$G/configs/c.1
    37	MOUNTS=${MK20_MOUNTS:-/proc/mounts}
    38	mkdir -p "$TM" "$LOGDIR" "$MK20_HOME/state" 2>/dev/null
    39	log() { mk20log "$1" mk20d "$2" "v=$V" "$3"; }
    40	
    41	p4sha() { [ -n "${MK20_P4_SHA:-}" ] && { echo "$MK20_P4_SHA"; return; }; [ -s "$TM/p4.sha" ] || sha256sum "$R/dev/by-name/boot" 2>/dev/null | cut -d' ' -f1 > "$TM/p4.sha"; cat "$TM/p4.sha"; }
    42	kernel_line() { local p; p=$(p4sha); echo "$p" | grep -Eq '^[0-9a-f]{64}$' && awk -v p="$p" '$1==p && NF>=3 {print; exit}' "$MK20_HOME/kernel/ALLOWLIST" 2>/dev/null; }   # "<sha> <name> <features>"
    43	kernel_has() { case ",$(kernel_line | cut -d' ' -f3)," in *",$1,"*) return 0;; esac; return 1; }
    44	shim_mounted() { # $1=path: our KD shim (a tmpfs file bind-mounted exactly on a known vendor path)
    45	  case "$1" in /data/appLunch.sh|/data/setusbconfig) ;; *) return 1;; esac
    46	  awk -v f="$1" '$2==f && $3=="tmpfs" {ok=1} END{exit !ok}' "$MOUNTS" 2>/dev/null; }
    47	vendor_check() { # prints "ok" or the first mismatch; all 4 vendor entries must be present and checked
    48	  local h f n; n=0
    49	  while read -r h f || [ -n "$h" ]; do
    50	    [ -n "$h" ] || continue
    51	    n=$((n+1))
    52	    shim_mounted "$f" && continue
    53	    [ "$(sha256sum "$R$f" 2>/dev/null | cut -d' ' -f1)" = "$h" ] || { echo "mismatch:$f"; return 1; }
    54	  done < "$REL/share/vendor.sha256"
    55	  [ "$n" -ge 4 ] || { echo "vendor list incomplete ($n)"; return 1; }
    56	  echo ok
    57	}
    58	num() { case "$1" in ''|*[!0-9]*) echo 0;; *) echo "$1";; esac; }
    59	kd_count() { pgrep -f '^/data/KeyboardDevice' | wc -l | tr -d ' '; }   # not -x: BusyBox 1.27 -x never matches KD (1.0.3 field failure)
    60	composite_up() { [ -e "$C/ecm.usb0" ]; }
    61	listening() { netstat -ltn 2>/dev/null | awk -v a="$1" '$4==a {ok=1} END{exit !ok}'; }   # exact local address
    62	lock_held() { ( exec 5>"$1"; ! flock -n 5 ) 2>/dev/null; }   # a live instance holds the lock
    63	router_running() { pgrep -f 'bin/mk20-router --src' >/dev/null; }
    64	kbd_running() { pgrep -f 'bin/mk20-kbd --run' >/dev/null; }
    65	KDSVC=${MK20_KDSVC:-/etc/init.d/qt_app2}   # procd service: `stop` also stops the respawn (plain kill -> respawned)
    66	KST=$R/run/mk20/kbd.status
    67	kbd_wanted() { [ "$FEATURE_KBD" = 1 ] && [ -x "$REL/bin/mk20-kbd" ]; }
    68	probation() { [ -n "$V" ] && [ "$(cat "$MK20_HOME/state/pending" 2>/dev/null)" = "$V" ]; }
    69	kbd_recent() { # mk20-kbd exits within the crash window (uptimes in $TM/kbd-crash.times)
    70	  local now; now=$(cut -d. -f1 /proc/uptime)
    71	  awk -v n="$now" -v w="${MK20_KBD_CRASH_WINDOW:-300}" '$1 ~ /^[0-9]+$/ && n - $1 < w {c++} END{print c+0}' "$TM/kbd-crash.times" 2>/dev/null || echo 0; }
    72	kbd_total() { num "$(sed -n 's/^total=\([0-9]*\).*/\1/p' "$TM/kbd.crashes" 2>/dev/null)"; }
    73	jnum() { num "$(sed -n "s/.*\"$1\": *\([0-9]*\).*/\1/p" "$KST" 2>/dev/null | head -n 1)"; }
    74	# mk20-kbd problems: FAIL on probation (no confirm -> loader rolls back to the previous release), WARN once confirmed
    75	# (a confirmed release keeps its composite/OTA path; a FAIL there would trigger the stock rollback-now)
    76	kbd_bad() { if probation; then echo "FAIL $1"; else echo "WARN $1"; fi; }
    77	kbd_status_check() { # PASS/FAIL|WARN lines for the mk20-kbd status file; rc 0 = healthy
    78	  local age kn fr pw rc; rc=0
    79	  [ -f "$KST" ] || { kbd_bad "kbd status missing ($KST)"; return 1; }
    80	  age=$(( $(date +%s) - $(num "$(stat -c %Y "$KST" 2>/dev/null)") ))
    81	  [ $age -le "${MK20_KBD_STATUS_MAX_AGE:-10}" ] && echo "PASS kbd status fresh (${age}s)" || { kbd_bad "kbd status stale (${age}s)"; rc=1; }
    82	  kn=$(jnum knob_ok); fr=$(( $(jnum key_events) + $(jnum knob_events) + $(jnum echo_frames) + $(jnum other_frames) ))
    83	  if [ "$kn" = 6 ] || [ $fr -gt 0 ]; then echo "PASS kbd gd32 knob_ok=$kn frames=$fr"; else kbd_bad "kbd gd32 silent (knob_ok=$kn frames=$fr)"; rc=1; fi
    84	  pw=$(jnum panels_written)
    85	  [ "$pw" = 21 ] && echo "PASS kbd panels 21/21" || { kbd_bad "kbd panels $pw/21"; rc=1; }
    86	  return $rc; }
    87	kd_svc() { if [ -x "$KDSVC" ]; then "$KDSVC" "$1" >>"$TM/kbd.log" 2>&1 5>&-; else log WARN kbd "no $KDSVC for $1"; return 1; fi; }
    88	wdt_armed() { ${MK20_UBUS:-ubus} call system watchdog 2>/dev/null | grep -q '"running"'; }
    89	
    90	selftest() { # FAIL = host-independent breakage. Composite rollback to stock is "degraded" (WARN): flapmon rolls back on
    91	  # host-side USB flaps, and stock ACM+KD(+adb) stays reachable. With the composite up, the link-local rescue listener is
    92	  # mandatory (1.1.0): it is the subnet-independent path, so a release that loses it must not be confirmed.
    93	  local f n; f=0
    94	  if [ -f "$TM/kbd.mode" ]; then   # mk20-kbd replaces stock KD: KD must be gone, mk20-kbd alive and healthy
    95	    local kr kt kl
    96	    n=$(kd_count); [ "$n" = 0 ] && echo "PASS kd=0 (mk20-kbd mode)" || { echo "FAIL kd=$n beside mk20-kbd"; f=1; }   # double writer: always FAIL
    97	    kl=$( { kbd_running && echo "PASS mk20-kbd running" || kbd_bad "mk20-kbd not running"; kbd_status_check
    98	      kr=$(kbd_recent); kt=$(kbd_total)
    99	      if [ "$kr" -ge "${MK20_KBD_CRASHES:-3}" ]; then kbd_bad "mk20-kbd crash loop: $kr exits in ${MK20_KBD_CRASH_WINDOW:-300}s ($kt total)"
   100	      elif [ "$kt" -gt 0 ]; then echo "INFO mk20-kbd restarted $kt times"; fi
   101	      [ "$kt" -gt 0 ] && grep -q '"hid_open": *0[,}]' "$KST" 2>/dev/null && echo "WARN hidg0 not open after mk20-kbd restart (f_hid re-bind quirk: reboot clears it)"; } )
   102	    echo "$kl"; echo "$kl" | grep -q '^FAIL' && f=1
   103	  else
   104	    [ -f "$TM/kbd-degraded" ] && echo "WARN mk20-kbd not active: $(head -n 1 "$TM/kbd-degraded")"
   105	    n=$(kd_count); [ "$n" = 1 ] && echo "PASS kd=1" || { echo "FAIL kd=$n"; f=1; }
   106	  fi
   107	  [ -n "$(cat "$G/UDC" 2>/dev/null)" ] && echo "PASS udc bound" || { echo "FAIL udc unbound"; f=1; }
   108	  [ -e "$R/dev/ttyGS0" ] && echo "PASS ttyGS0" || { echo "FAIL no ttyGS0"; f=1; }
   109	  wdt_armed && echo "PASS watchdog armed" || { echo "FAIL watchdog not armed"; f=1; }
   110	  if composite_up; then
   111	    listening "$ECM_IP:$BRIDGE_PORT" && echo "PASS bridge $ECM_IP:$BRIDGE_PORT" || { echo "FAIL bridge not on $ECM_IP:$BRIDGE_PORT"; f=1; }
   112	    listening "${MK20_LL_IP:-169.254.7.2}:$BRIDGE_PORT" && echo "PASS bridge link-local" || { echo "FAIL bridge not on link-local"; f=1; }
   113	    listening "0.0.0.0:$BRIDGE_PORT" && { echo "FAIL bridge on 0.0.0.0"; f=1; }
   114	    if [ -e "$C/hid.usb0" ]; then [ -e "$R/dev/hidg0" ] && echo "PASS hid" || { echo "FAIL no hidg0"; f=1; }; fi
   115	  else echo "WARN composite down (stock ACM+KD$([ -e "$C/ffs.adb" ] && echo +adb))"
   116	    for n in /data/appLunch.sh /data/setusbconfig; do shim_mounted "$n" && { echo "FAIL shim still mounted on $n with composite down"; f=1; }; done; fi
   117	  n=$(df -Pk "$S" 2>/dev/null | awk 'END{print $4}'); case "$n" in ''|*[!0-9]*) ;; *) [ "$n" -lt 1024 ] && echo "WARN FAT free ${n} KiB";; esac
   118	  # on-board router (1.2.0): reported only (INFO), never FAIL/WARN, so it can neither block confirm nor degrade status
   119	  if [ "${FEATURE_ROUTER:-1}" != 1 ]; then echo "INFO router disabled"
   120	  elif composite_up; then router_running && echo "INFO router running" || echo "INFO router not running"; fi
   121	  return $f
   122	}
   123	
   124	jstr() { # JSON string: drop control bytes, escape backslash and quote
   125	  printf '"%s"' "$(printf '%s' "$1" | tr '\n\t' '  ' | LC_ALL=C tr -cd ' -~' | sed 's/\\/\\\\/g; s/"/\\"/g')"; }
   126	jbool() { if "$@" >/dev/null 2>&1; then echo true; else echo false; fi; }
   127	health() {
   128	  local kl up fat dat mem links l st rc mounts
   129	  cfg_load
   130	  kl=$(kernel_line); up=$(cut -d. -f1 /proc/uptime)
   131	  fat=$(df -Pk "$S" 2>/dev/null | awk 'END{print $4}'); dat=$(df -Pk "$MK20_HOME" 2>/dev/null | awk 'END{print $4}')
   132	  mem=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
   133	  links=""; for l in "$C"/*usb0 "$C"/*adb; do [ -e "$l" ] && links="$links${l##*/} "; done
   134	  st=$(selftest 2>/dev/null); rc=$?
   135	  mounts=0; for l in /data/appLunch.sh /data/setusbconfig; do shim_mounted "$l" && mounts=$((mounts+1)); done
   136	  {
   137	    printf '{'
   138	    printf '"version":%s,"uptime_s":%s,' "$(jstr "$V")" "$(num "$up")"
   139	    printf '"kernel":{"p4":%s,"name":%s,"features":%s},' "$(jstr "$(p4sha)")" "$(jstr "$(echo "$kl" | cut -d' ' -f2)")" "$(jstr "$(echo "$kl" | cut -d' ' -f3)")"
   140	    printf '"vendor":%s,' "$(jstr "$(vendor_check)")"
   141	    printf '"usb":{"udc":%s,"state":%s,"functions":%s,"composite":%s},' "$(jstr "$(cat "$G/UDC" 2>/dev/null)")" \
   142	      "$(jstr "$(cat "$R"/sys/class/udc/*/state 2>/dev/null | head -n 1)")" "$(jstr "$links")" "$(jbool composite_up)"
   143	    printf '"net":{"usb0":%s,"mtu":%s,"subnet":%s,"bridge":%s,"hidg0_writable":%s},' "$(jstr "$(ifconfig usb0 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]*\).*/\1/p')")" \
   144	      "$(num "$(cat "$R/sys/class/net/usb0/mtu" 2>/dev/null)")" "$(jstr "$ECM_SUBNET")" "$(jbool listening "$ECM_IP:$BRIDGE_PORT")" "$(jbool test -w "$R/dev/hidg0")"
   145	    printf '"kd":%s,"adbd":%s,"flapmon":%s,"maint":%s,"shim_mounts":%s,' "$(num "$(kd_count)")" "$(jbool pidof adbd)" \
   146	      "$(jbool pgrep -f mk20-flapmon.sh)" "$(jbool lock_held "$TM/mk20d-maint.lock")" "$mounts"
   147	    printf '"router":{"enabled":%s,"running":%s,"loop":%s,"tap":%s},' "$([ "${FEATURE_ROUTER:-1}" = 1 ] && echo true || echo false)" \
   148	      "$(jbool router_running)" "$(jbool lock_held "$TM/router.lock")" "$(jbool test -S "$TM/kd-tap.sock")"
   149	    printf '"kbd":{"enabled":%s,"mode":%s,"running":%s,"restarts":%s,"recent_crashes":%s,"degraded":%s,"status":%s},' \
   150	      "$([ "${FEATURE_KBD:-0}" = 1 ] && echo true || echo false)" "$(jbool test -f "$TM/kbd.mode")" "$(jbool kbd_running)" \
   151	      "$(kbd_total)" "$(num "$(kbd_recent)")" "$(jstr "$(head -n 1 "$TM/kbd-degraded" 2>/dev/null)")" "$(jstr "$(head -c 700 "$KST" 2>/dev/null)")"
   152	    printf '"watchdog":%s,"mem_avail_kb":%s,"fat_free_kb":%s,"data_free_kb":%s,' "$(jbool wdt_armed)" "$(num "$mem")" "$(num "$fat")" "$(num "$dat")"
   153	    printf '"release":{"good":%s,"pending":%s,"last_rollback":%s},' "$(jstr "$(head -n 1 "$MK20_HOME/state/good" 2>/dev/null)")" \
   154	      "$(jstr "$(head -n 1 "$MK20_HOME/state/pending" 2>/dev/null)")" "$(jstr "$(head -n 1 "$MK20_HOME/state/last-rollback" 2>/dev/null)")"
   155	    printf '"config":{"src":%s,"warnings":%s},' "$(jstr "$CFG_SRC")" "$(jstr "$CFG_WARN")"
   156	    printf '"selftest":{"pass":%s,"detail":%s},' "$([ "$rc" = 0 ] && echo true || echo false)" "$(jstr "$st")"
   157	    printf '"status":%s' "$(jstr "$(if [ "$rc" != 0 ]; then echo fail; elif echo "$st" | grep -q '^WARN'; then echo degraded; else echo ok; fi)")"
   158	    printf '}\n'
   159	  } > "$TM/health.json.tmp.$$" && mv -f "$TM/health.json.tmp.$$" "$TM/health.json" || { rm -f "$TM/health.json" "$TM/health.json.tmp.$$"; return 1; }
   160	  cat "$TM/health.json"
   161	}
   162	
   163	stock_adb() { # legacy adb.sh semantics: add adb beside ACM; on failure or lost ACM restore serial; bounded keepalive
   164	  local rc
   165	  sh "$REL/share/mk20-add-adb.sh" >> "$LOGDIR/gadget.log" 2>&1; rc=$?
   166	  [ $rc = 0 ] || log WARN adb "add-adb rc=$rc -> restore serial"
   167	  if [ $rc != 0 ] || [ ! -e "$R/dev/ttyGS0" ] || [ ! -e "$C/acm.usb0" ]; then
   168	    killall adbd 2>/dev/null; [ -x "$R/data/setusbconfig" ] && "$R/data/setusbconfig" serial >> "$LOGDIR/gadget.log" 2>&1; fi
   169	  [ "${MK20_ADB_KEEPALIVE:-1}" = 1 ] || return 0
   170	  ( trap '' HUP INT; exec 5>"$TM/adb-keepalive.lock"; flock -n 5 || exit 0; n=0
   171	    while [ $n -lt 5 ]; do sleep 30
   172	      [ -f "$S/mk20-no-adb" ] && exit 0
   173	      if [ ! -e "$C/ffs.adb" ] && pgrep -f KeyboardDevice >/dev/null; then sleep 10; n=$((n+1)); log INFO adb "keepalive re-add #$n"
   174	        sh "$REL/share/mk20-add-adb.sh" >> "$LOGDIR/gadget.log" 2>&1 || { killall adbd 2>/dev/null; [ -x "$R/data/setusbconfig" ] && "$R/data/setusbconfig" serial; }; fi
   175	    done ) </dev/null >/dev/null 2>&1 6>&- 7>&- 8>&- 9>&- &
   176	}
   177	
   178	case "${1:-}" in
   179	boot)
   180	  cfg_load
