    31	static int monitor(const char *dev)
    32	{
    33	    int fd = open_gd32_ro(dev);
    34	    if (fd < 0) { perror(dev); return 1; }
    35	    gd32_parser p; gd32_parser_init(&p);
    36	    uint8_t buf[256];
    37	    for (;;) {
    38	        ssize_t n = read(fd, buf, sizeof buf);
    39	        if (n <= 0) { perror("read"); return 1; }
    40	        for (ssize_t i = 0; i < n; i++) {
    41	            int len = gd32_feed(&p, buf[i]);
    42	            if (len <= 0) continue;
    43	            struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
    44	            gd32_key_event ev;
    45	            if (gd32_decode_key(p.buf, len, &ev) == 0)
    46	                { printf("%ld.%06ld key col=%u row=%u pressed=%u keycode=0x%04x hex=", (long)ts.tv_sec, ts.tv_nsec / 1000,
    47	                       ev.col, ev.row, ev.pressed, ev.keycode); for (int k = 0; k < len; k++) printf("%02x", p.buf[k]); printf("\n"); }
    48	            else {
    49	                printf("%ld.%06ld frame id=0x%02x len=%d hex=", (long)ts.tv_sec, ts.tv_nsec / 1000, p.buf[0], len); for (int k = 0; k < len; k++) printf("%02x", p.buf[k]); printf("\n");
    50	            }
    51	            fflush(stdout);
    52	        }
    53	    }
    54	}
