   336	trap '' HUP
   337	( setup_main ) </dev/null &
   338	SP=$!
   339	bounded_wait $SP "$SUT"; bw=$?
   340	if [ $bw = 0 ]; then
   341	  src=$BW_RC; [ "$src" = 0 ] && exit 0   # r8 BLOCKER: saved before escalate() can run another bounded_wait
   342	  # setup failed and ran its own failsafe: verify stock, else escalate (flapmon is stopped at this point)
