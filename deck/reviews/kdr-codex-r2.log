    50	/* wait for the echo of want[] for up to timeout_ms; 1 = got it, 0 = timeout, -1 = read error */
    51	static int wait_echo(int fd, gd32_parser *p, const uint8_t *want, int timeout_ms, gd32_knob_status *st, gd32_frame_cb cb, void *ctx)
    52	{
    53	    long deadline = now_ms() + timeout_ms;
    54	    for (;;) {
    55	        long left = deadline - now_ms();
    56	        if (left <= 0) return 0;
    57	        struct pollfd pf = {fd, POLLIN, 0};
    58	        int r = poll(&pf, 1, (int)left);
    59	        if (r < 0) { if (errno == EINTR) continue; return -1; }
    60	        if (r == 0) return 0;
    61	        uint8_t buf[256];
    62	        ssize_t n = read(fd, buf, sizeof buf);
    63	        if (n < 0) { if (errno == EINTR || errno == EAGAIN) continue; return -1; }
    64	        if (n == 0) return -1;
    65	        int got = 0;
    66	        for (ssize_t i = 0; i < n; i++) {
    67	            int len = gd32_feed(p, buf[i]);
    68	            if (len <= 0) continue;
    69	            if (len == GD32_KNOB_PAYLOAD_LEN && !memcmp(p->buf, want, GD32_KNOB_PAYLOAD_LEN)) { got = 1; continue; }
    70	            if (p->buf[0] == GD32_IN_ECHO) { st->stale_echoes++; continue; }  /* e.g. KD leftovers */
    71	            st->foreign_frames++;
    72	            if (cb) cb(ctx, p->buf, len);
    73	        }
    74	        if (got) return 1; /* rest of this read was already dispatched */
    75	    }
    76	}
