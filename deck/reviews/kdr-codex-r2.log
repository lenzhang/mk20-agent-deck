   294	            k->version, k->gd32_rw, gd32_knob_state_name(ks->state), ks->ok_count, ks->timeouts, ks->tx_errors,
   295	            panels_written, dirty, werr, k->st.key_events, k->st.knob_events, k->st.echo_frames,
   296	            k->st.other_frames, k->st.jpg_ok, k->st.jpg_bad, k->st.jpg_size, k->st.json_in, k->host_fd >= 0,
   297	            k->st.host_tx_errors, k->st.host_tx_timeouts, k->backlight, k->hid ? k->hid->fd >= 0 : -1, k->hid ? k->hid->reopens : 0u,
