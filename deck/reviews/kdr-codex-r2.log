   103	            raw[i + 5] == GD32_FORBIDDEN_BOOTLOADER_JUMP)
   104	            return 1;
   105	    return 0;
   106	}
   107	
   108	int gd32_knob_payload(int slot, uint8_t out[GD32_KNOB_PAYLOAD_LEN])
   109	{
   110	    if (slot < GD32_KNOB_SLOT_FIRST || slot > GD32_KNOB_SLOT_LAST) return -1;
   111	    out[0] = GD32_OUT_SET_KEYCODE; out[1] = 0; out[2] = (uint8_t)slot; out[3] = (uint8_t)slot; out[4] = 0; out[5] = 0;
   112	    return GD32_KNOB_PAYLOAD_LEN;
   113	}
   114	
   115	int gd32_out_allowed(const uint8_t *pl, size_t len)
   116	{
   117	    if (!pl || len != GD32_KNOB_PAYLOAD_LEN) return 0;
   118	    if (pl[0] != GD32_OUT_SET_KEYCODE) return 0;          /* also excludes 0x19, 0x02, 0x0A, 0x0B, ... */
   119	    if (pl[1] != 0) return 0;                               /* layer 0 */
   120	    if (pl[2] < GD32_KNOB_SLOT_FIRST || pl[2] > GD32_KNOB_SLOT_LAST) return 0; /* <100 = EEPROM keymap */
   121	    if (pl[3] != pl[2]) return 0;                           /* col == row, as KD writes it */
   122	    if (pl[4] != 0 || pl[5] != 0) return 0;                 /* KC_NO only: report over serial */
   123	    if (gd32_raw_is_forbidden(pl, len)) return 0;
   124	    return 1;
   125	}
   126	
   127	static int build(const uint8_t *pl, size_t len, uint8_t *out, size_t cap)
   128	{
   129	    if (len == 0 || len > GD32_MAX_PAYLOAD || cap < len + GD32_FRAME_OVERHEAD) return -1;
   130	    uint8_t s = 0;
   131	    for (size_t i = 0; i < len; i++) s += pl[i];
   132	    out[0] = 0xAA; out[1] = 0x55; out[2] = s; out[3] = (uint8_t)len; out[4] = (uint8_t)~len;
   133	    memcpy(out + 5, pl, len);
   134	    out[5 + len] = 0xF5; out[6 + len] = 0x5F;
   135	    return (int)(len + GD32_FRAME_OVERHEAD);
   136	}
   137	
   138	int gd32_encode(const uint8_t *pl, size_t len, uint8_t *out, size_t cap)
   139	{
   140	    if (!gd32_out_allowed(pl, len)) return -1;
   141	    int n = build(pl, len, out, cap);
   142	    if (n < 0 || gd32_raw_is_forbidden(out, (size_t)n)) return -1;
   143	    return n;
   144	}
   145	
   146	int gd32_build_test_frame(const uint8_t *pl, size_t len, uint8_t *out, size_t cap)
   147	{
   148	    return build(pl, len, out, cap);
   149	}
