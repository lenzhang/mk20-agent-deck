   241	static uint16_t rd16(const uint8_t *p) { return (uint16_t)(p[0] | p[1] << 8); }
   242	
   243	static void on_tile(kbd_t *k, const host_frame *f)
   244	{
   245	    /* u8 fb, u16 x, y, w, h, w*h RGB565 LE */
   246	    int ok = 0;
   247	    if (f->size >= 9) {
   248	        int fb = f->data[0], x = rd16(f->data + 1), y = rd16(f->data + 3), w = rd16(f->data + 5), h = rd16(f->data + 7);
   249	        if (w > 0 && h > 0 && (size_t)w * h * 2 + 9 == f->size) {
   250	            uint16_t *px = malloc((size_t)w * h * 2);
   251	            if (px) {
   252	                memcpy(px, f->data + 9, (size_t)w * h * 2);   /* alignment */
   253	                ok = screen_set_tile565(&k->scr, fb, x, y, w, h, px) >= 0;
   254	                free(px);
   255	            }
   256	        }
   257	    }
   258	    if (ok) { k->st.tiles++; kbd_flush(k); }
   259	    kbd_host_send(k, f->id, HOST_CMD_TILE565, ok ? "" : "E", ok ? 0 : 1);
   260	}
   261	
   262	void kbd_on_host_frame(kbd_t *k, const host_frame *f)
   263	{
   264	    switch (f->cmd) {
   265	    case HOST_CMD_JPG: {
   266	        int r = jpeg_decode565(f->data, f->size, k->canvas, CANVAS_W, CANVAS_H);
   267	        if (r == 0) { k->st.jpg_ok++; screen_set_canvas565(&k->scr, k->canvas); kbd_flush(k); }
   268	        else if (r == -2) k->st.jpg_size++;
   269	        else k->st.jpg_bad++;
   270	        /* KD semantics: empty cmd-100 frame with the same id once handled; always ack so the
   271	         * host's one-frame-in-flight pacing never stalls on a bad frame. */
   272	        kbd_host_send(k, f->id, HOST_CMD_JPG, "", 0);
   273	        break;
   274	    }
   275	    case HOST_CMD_JSON: on_json(k, f); break;
   276	    case HOST_CMD_TILE565: on_tile(k, f); break;
   277	    default: break;
   278	    }
   279	}
