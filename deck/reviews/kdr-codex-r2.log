   201	static void ack_json_result(kbd_t *k, uint32_t id, const char *method, const char *result)
   202	{
   203	    char j[256];
   204	    int n = snprintf(j, sizeof j, "{\"ack_method\":\"%s\",\"success\":true,\"result\":%s}", method, result);
