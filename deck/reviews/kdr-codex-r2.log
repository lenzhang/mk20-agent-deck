     1	/* mk20-kbd: GD32 <-> T113 link on /dev/ttyS1 (115200 8N1).
     2	 * Frame (from KD V2.32 STM32CommunicationObject::packFrame/parseByte):
     3	 *   AA 55 SUM LEN ~LEN payload[LEN] F5 5F      SUM = 8-bit sum of payload
     4	 * SAFETY: outbound frames are restricted to an allow-list. 0x19
     5	 * (request_bootloader_jump) and the raw clearState bytes 02 AA E2 78 can
     6	 * never be emitted by this module (compile-time + runtime + tests). */
     7	#ifndef MK20_GD32_H
     8	#define MK20_GD32_H
     9	#include <stddef.h>
    10	#include <stdint.h>
    11	
    12	#define GD32_MAX_PAYLOAD 255
    13	#define GD32_FRAME_OVERHEAD 7
    14	/* Longest inbound payload we accept. GD32 replies are VIA-sized (<= 32 B); capping
    15	 * LEN makes a false header (e.g. a truncated frame followed by AA 55 ...) fail fast
    16	 * instead of swallowing up to 255 following bytes. */
    17	#define GD32_MAX_IN_PAYLOAD 64
    18	
    19	/* inbound payload[0] ids observed in KD processData() */
    20	enum gd32_in_id {
    21	    GD32_IN_KEYCODE_ACK = 0x05,
    22	    GD32_IN_MACRO_SIZE  = 0x0D,
    23	    GD32_IN_MACRO_ACK   = 0x0F,
    24	    GD32_IN_MACRO_RESET = 0x10,
    25	    GD32_IN_KEY_EVENT   = 0x16,
    26	};
    27	
    28	/* Forbidden outbound ids: never listed in the allow-list. */
    29	#define GD32_FORBIDDEN_BOOTLOADER_JUMP 0x19
    30	
    31	/* Outbound allow-list (K2-KNOB-CONFIG.md). EXACTLY ONE frame shape may ever be
    32	 * sent: the 6-byte payload  05 00 r r 00 00  with r in 100..105, i.e. "set GD32
    33	 * encoder slot r to KC_NO" (GD32 RAM only, .bss, cleared at GD32 reset). Every
    34	 * other payload is refused, in particular:
    35	 *   - id 0x19 (bootloader jump) and any buffer containing 02 AA E2 78,
    36	 *   - id 0x05 with row < 100 (dynamic_keymap_set_keycode -> QMK EEPROM write),
    37	 *   - id 0x05 with row > 105, non-zero layer/keycode, col != row, other lengths. */
    38	#define GD32_OUT_SET_KEYCODE 0x05
    39	#define GD32_KNOB_SLOT_FIRST 100
    40	#define GD32_KNOB_SLOT_LAST  105
    41	#define GD32_KNOB_PAYLOAD_LEN 6
    42	#define GD32_IN_ECHO GD32_IN_KEYCODE_ACK  /* GD32 echoes each 0x05 frame identically */
    43	
    44	typedef struct {
    45	    int state;
    46	    uint8_t sum, len, n;
    47	    uint8_t buf[GD32_MAX_PAYLOAD];
    48	    uint8_t raw[GD32_MAX_PAYLOAD + GD32_FRAME_OVERHEAD]; /* bytes of the current candidate, for re-scan */
    49	    int rawn, depth;
    50	    /* stats */
    51	    uint32_t frames_ok, bad_sum, bad_len, bad_tail, resync_bytes;
    52	} gd32_parser;
    53	
    54	/* Event 16 P R C KH KL. Measured 2026-10-19 (K2-RESULTS.md): byte 2 is the
    55	 * physical row 0..3, byte 3 the column 0..4; stock KD forwarded them to the host
    56	 * as keyStateChanged{col=C,row=R} (0-based, no transposition: NOTES-device-
    57	 * 2026-10-17.md; KD signature VideoPlayer::keyStateChanged(pressed,row,col)).
    58	 * Knobs: R == C in 100..105 (K1 100 press/101 ccw/102 cw, K2 103/104/105). */
    59	enum { KNOB_NONE = 0, KNOB_PRESS = 1, KNOB_CCW = 2, KNOB_CW = 3 };
    60	typedef struct {
    61	    uint8_t pressed;   /* payload[1] (!=0 => pressed) */
    62	    uint8_t row;       /* payload[2]; knobs use row==col >= 100 */
    63	    uint8_t col;       /* payload[3] */
    64	    uint8_t knob;      /* 0 = matrix key, 1 = K1, 2 = K2 */
    65	    uint8_t knob_action; /* KNOB_PRESS/CCW/CW when knob != 0 */
    66	    uint16_t keycode;  /* payload[4]<<8 | payload[5]: QMK keycode at (row,col),
    67	                          0 == KC_NO. KD's VideoPlayer::keyStateChanged only runs
    68	                          its local action when both bytes are 0 (keyCodeH/L). */
    69	} gd32_key_event;
