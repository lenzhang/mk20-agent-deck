   196	                    "                      [--no-hid | --hid PATH] [--hid-stop-file PATH] [--ptt COL,ROW (1-based)]\n"
   197	                    "                      [--lock FILE (default /tmp/mk20-kbd.lock; '' = none)] [--exit-file FILE]\n"
   198	                    "       mk20-kbd --monitor [tty] | --pattern [fbdir] | --getinfo\n"
   199	                    "  kill file " GD32_NO_WRITE_FILE " = same as --no-gd32-write\n");
   200	}
