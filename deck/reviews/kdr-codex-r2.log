    56	static int pattern(const char *fbdir)
    57	{
    58	    screen_t s;
    59	    if (screen_init(&s, fbdir)) return 1;
    60	    for (int i = 0; i < PANEL_COUNT; i++) {
    61	        int w = PANELS[i].w, h = PANELS[i].h;
    62	        uint16_t *px = malloc((size_t)w * h * 2);
    63	        /* stripes: count of white bars == fb number, on a bus-coloured background */
    64	        for (int y = 0; y < h; y++) for (int x = 0; x < w; x++) {
    65	            int bar = (x * (PANELS[i].fb * 2 + 1)) / w;
    66	            px[y * w + x] = (bar & 1) ? 0xFFFF : (PANELS[i].bus ? 0x001F : 0xF800);
    67	        }
    68	        screen_set_tile565(&s, PANELS[i].fb, 0, 0, w, h, px);
    69	        free(px);
    70	    }
    71	    int a = screen_flush_bus(&s, 0), b = screen_flush_bus(&s, 1);
    72	    printf("pattern written bus0=%d bus1=%d errors=%u\n", a, b, s.write_errors);
    73	    screen_free(&s);
    74	    return (a < 0 || b < 0) ? 1 : 0;
    75	}
