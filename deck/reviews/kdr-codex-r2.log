   245	# 5, add-adb ~4 x7, 6x15 re-add window) ~= 260 s -> 330 s so a healthy rollback incl. add-adb is never cut off.
   246	RBRETRY=$(uint_cap "${MK20_RB_RETRY_S:-}" 20 0 300)       # queued/manual rollback: pause before its one retry (s)
   247	RBT=$(uint_cap "${MK20_RB_TIMEOUT:-}" 330 1 900)          # rollback / post-timeout cleanup bound (s)
   248	RBTRIES=$(uint_cap "${MK20_RB_LOCK_TRIES:-}" 4400 1 4800)  # rollback mutex wait (x0.25 s = 1100 s) > worst owner hold:
   249	# setup supervisor SUT+RBT+30 verify+2x10 kill checks+20 escalate (~850 s) + fork/poll overhead (r8 #4)
   250	SUTRIES=$(uint_cap "${MK20_SETUP_LOCK_TRIES:-}" 40 1 4800) # setup mutex wait (x0.25 s)
   251	SUT=$(uint_cap "${MK20_SETUP_TIMEOUT:-}" 450 1 1800)       # whole setup incl. its own failsafe (~60 s + cleanup <=330 s)
   252	# bounded_wait <pid> <s>: 0 = the child exited in time (rc in BW_RC); 1 = timed out: its whole tree was stopped,
   253	# SIGKILLed and the child reaped; 2 = timed out AND still alive 10 s after SIGKILL (D state, e.g. a stuck UDC write):
   254	# not waited for (an unbounded wait would wedge us). "Alive" covers EVERY process of the tree snapshotted by
   255	# kill_tree, not just the root (r6). Only ever used on OUR OWN children.
   256	bounded_wait() {
   257	  bst=$(pstart "$1"); bi=0; BW_RC=1
   258	  while [ -n "$bst" ] && [ "$(pstart "$1")" = "$bst" ] && [ $bi -lt $(($2*4)) ]; do sleep 0.25; bi=$((bi+1)); done
   259	  if [ -n "$bst" ] && [ "$(pstart "$1")" = "$bst" ]; then
   260	    bsnap="$1:$bst $(kill_tree "$1")"; bi=0
   261	    while any_alive "$bsnap" && [ $bi -lt 40 ]; do sleep 0.25; bi=$((bi+1)); done
   262	    any_alive "$bsnap" && return 2
   263	    wait "$1" 2>/dev/null; return 1
   264	  fi
   265	  wait "$1" 2>/dev/null; BW_RC=$?; return 0
   266	}
   267	# escalate <why>: no transition can complete (an unkillable child holds fd 7, or stock is not reached): persist
   268	# stock mode (flag read at boot) and hard-reset via the rescue watcher (cmd-reboot) - same path as flapmon's.
   269	# r6: the writes run in a bounded child WITHOUT fd 7 (a hung FAT write cannot wedge the mutex); success = both files
   270	# exist afterwards (sync cannot mask a failed touch). 0 = escalated, 1 = could not persist (caller exits 1, not 3).
   271	# r8: BW_RC is saved/restored (callers still need their own child's rc); the writer marks success on tmpfs BEFORE
   272	# sync (a slow sync or the watcher consuming cmd-reboot is not a failure); the STUCK/ESCALATED status is written last.
   273	escalate() {
   274	  ebrc=${BW_RC:-1}; EF=${MK20_FLAP_FLAG:-/mnt/SDCARD/mk20-no-composite}; ER=${MK20_FLAP_REBOOT:-/mnt/SDCARD/cmd-reboot}
   275	  EOKF=/tmp/mk20/escalate.ok; rm -f "$EOKF"
   276	  log "ESCALATE: $1 -> $EF + reboot"
   277	  ( touch "$EF" && touch "$ER" && [ -e "$EF" ] && [ -e "$ER" ] && touch "$EOKF"; sync ) </dev/null 7>&- &
   278	  bounded_wait $! 20; ebw=$?; BW_RC=$ebrc
   279	  if [ -e "$EOKF" ]; then rm -f "$EOKF"; rb_status "$2"; return 0; fi
   280	  log "ESCALATE FAILED (bw=$ebw): $EF / $ER not persisted"; rb_status "$2-ESCALATE-FAILED"; return 1
   281	}
   282	# stuck <why> <status>: rc-3 exit (escalated; flapmon/confirm waiter do not retry). Clears gadget.busy like every
   283	# other exit under the mutex; rc 1 if the escalation itself could not be persisted.
   284	stuck() { rm -f /tmp/mk20/gadget.busy; escalate "$1" "$2" && exit 3; exit 1; }
   285	# Exit codes of --rollback-now: 0 stock verified | 1 not verified | 3 stuck+escalated | 4 refused (mutex busy: another
   286	# owner is mid-transition and owns gadget.busy) | 5 stale (r5 #7: MK20_GEN names an older composite than the current
   287	# generation in $GENF -> a queued rollback from a dead composite must not tear down a newer one; nothing touched).
   288	GENF=/tmp/mk20/composite.gen
   289	# stale only when a DIFFERENT current generation is published (GPT r7: a missing/empty token is not "stale")
   290	gen_stale() { gcur=$(cat "$GENF" 2>/dev/null); [ -n "${MK20_GEN:-}" ] && [ -n "$gcur" ] && [ "$gcur" != "$MK20_GEN" ]; }
   291	if [ "${1:-}" = --rollback-now ]; then
   292	  # GPT r7: a stale request that could not get the mutex is rc 5 (no-op), never rc 4 (callers would retry/escalate)
   293	  tl_lock "$RBTRIES" || { gen_stale && { log "rollback: mutex busy and request stale ($MK20_GEN) -> ignored"; exit 5; }
   294	    log "rollback: transition mutex not acquired (busy or lock error) -> refused"; exit 4; }
   295	  if gen_stale; then
   296	    log "rollback: stale request for generation $MK20_GEN (current $(cat "$GENF" 2>/dev/null || echo none)) -> ignored"; exit 5; fi
   297	  if stock_ok; then log "rollback already done (stock verified)"; exit 0; fi
   298	  log "rollback requested"
   299	  # r6: flapmon, the confirm waiter and mk20d retry/escalate themselves (MK20_RB_CALLER_RETRIES=1: one attempt, rc 1).
   300	  # A queued/manual run has nobody behind it: it retries once (still under the mutex) and then escalates (rc 3).
   301	  RBA=2; [ "${MK20_RB_CALLER_RETRIES:-0}" = 1 ] && RBA=1; a=0
