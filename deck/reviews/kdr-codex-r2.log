   216	static void on_json(kbd_t *k, const host_frame *f)
   217	{
   218	    const char *s = (const char *)f->data; size_t n = f->size;
   219	    char m[64];
   220	    k->st.json_in++;
   221	    if (kbd_json_str(s, n, "method", m, sizeof m) < 0) { k->st.json_bad++; return; }
   222	    if (!strcmp(m, "getInfo")) {
   223	        char j[8192]; int l = host_json_getinfo_ack(j, sizeof j, k->version);
   224	        if (l > 0) kbd_host_send(k, f->id, HOST_CMD_JSON, j, (size_t)l);
   225	    } else if (!strcmp(m, "setBacklight") || !strcmp(m, "setDeviceBl")) {
   226	        /* KD handleSetBacklight (@0x60eb0): needs "level" (JSON number), 0..100, then
   227	         * replies {"success":true,"result":<level>} */
   228	        long lv; char eb[96];
   229	        if (kbd_json_int(s, n, "level", &lv)) ack_json(k, f->id, m, 0, "Missing or invalid level");
   230	        else if (lv < 0 || lv > 100) {
   231	            snprintf(eb, sizeof eb, "Backlight level must be between 0 and 100, got %ld", lv);
   232	            ack_json(k, f->id, m, 0, eb);
   233	        } else if (kbd_set_backlight(k, (int)lv)) ack_json(k, f->id, m, 0, "backlight write failed");
   234	        else { char r[16]; snprintf(r, sizeof r, "%ld", lv); ack_json_result(k, f->id, m, r); }
   235	    } else {
   236	        k->st.json_unsupported++;
   237	        ack_json(k, f->id, m, 0, "unsupported");
   238	    }
   239	}
