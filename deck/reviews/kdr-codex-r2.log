   329	supervise_setup() {
   330	# >>> setup-supervisor (r6): the owner holds fd 7 and runs the mutating setup (and its own EXIT failsafe) in a
   331	# child bounded by MK20_SETUP_TIMEOUT. A hung service script / setusbconfig / add-adb can no longer wedge the mutex:
   332	# on timeout the owner kills+reaps ITS OWN setup tree, runs a cleanup bounded by MK20_RB_TIMEOUT (killed+reaped
   333	# too if it hangs), clears gadget.busy and only then releases fd 7 (exit). The child inherits fd 7 on purpose, so
   334	# the mutex also stays held if the owner itself dies while the child is still mutating.
   335	tl_lock "$SUTRIES" || { log "ABORT transition in progress (mutex busy) or lock error"; exit 1; }   # held until exit
   336	trap '' HUP
   337	( setup_main ) </dev/null &
   338	SP=$!
   339	bounded_wait $SP "$SUT"; bw=$?
   340	if [ $bw = 0 ]; then
   341	  src=$BW_RC; [ "$src" = 0 ] && exit 0   # r8 BLOCKER: saved before escalate() can run another bounded_wait
   342	  # setup failed and ran its own failsafe: verify stock, else escalate (flapmon is stopped at this point)
   343	  i=0; while ! stock_ok && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done
   344	  stock_ok || escalate "setup failed (rc $src) and its failsafe did not reach stock" setup-failsafe-NOT-verified
   345	  rm -f /tmp/mk20/gadget.busy; exit "$src"
   346	fi
   347	[ $bw = 2 ] && stuck "setup tree $SP unkillable after ${SUT}s (D state)" setup-STUCK
   348	log "SETUP TIMEOUT: exceeded ${SUT}s -> killed+reaped own setup tree $SP; bounded cleanup"
   349	( trap - EXIT INT TERM; OK=0; cleanup ) </dev/null &
   350	SC=$!
   351	bounded_wait $SC "$RBT"; bw=$?
   352	[ $bw = 0 ] || log "cleanup after setup timeout exceeded ${RBT}s -> killed+reaped own cleanup tree $SC"
   353	[ $bw = 2 ] && stuck "cleanup tree $SC unkillable (D state)" setup-STUCK
   354	rm -f /tmp/mk20/gadget.busy
   355	i=0; while ! stock_ok && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done
   356	if stock_ok; then rb_status setup-timeout; else escalate "setup timeout and cleanup did not reach stock" setup-timeout-NOT-verified; fi
   357	exit 1
   358	# <<< setup-supervisor
   359	}
