    19	    }
    20	    for (int i = 0; i < PANEL_COUNT; i++) {
    21	        s->shadow[i] = calloc(px_count(i), 2);
    22	        s->pending[i] = calloc(px_count(i), 2);
    23	        if (!s->shadow[i] || !s->pending[i]) return -1;
    24	        s->dirty[i] = 1;
    25	    }
    26	    return 0;
    27	}
