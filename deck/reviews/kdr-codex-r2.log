    10	int gd32_open(const char *dev, int rw)
    11	{
    12	    int fd = open(dev, (rw ? O_RDWR : O_RDONLY) | O_NOCTTY | O_CLOEXEC);
    13	    if (fd < 0) return -1;
    14	    struct termios t;
    15	    if (tcgetattr(fd, &t) == 0) {
    16	        cfmakeraw(&t); cfsetispeed(&t, B115200); cfsetospeed(&t, B115200);
    17	        t.c_cflag |= CLOCAL | CREAD; t.c_cflag &= ~(CSTOPB | PARENB | CRTSCTS);
    18	        t.c_cc[VMIN] = 1; t.c_cc[VTIME] = 0;
    19	        tcsetattr(fd, TCSANOW, &t);
    20	    }
    21	    return fd;
    22	}
    23	
    24	int gd32_tx(int fd, const uint8_t *pl, size_t len)
    25	{
    26	    uint8_t fr[GD32_MAX_PAYLOAD + GD32_FRAME_OVERHEAD];
    27	    int n = gd32_encode(pl, len, fr, sizeof fr);
    28	    if (n < 0 || gd32_raw_is_forbidden(fr, (size_t)n)) { errno = EPERM; return -1; }
    29	    const uint8_t *b = fr; size_t left = (size_t)n;
    30	    while (left) {
    31	        ssize_t w = write(fd, b, left);
    32	        if (w < 0) { if (errno == EINTR) continue; return -1; }
    33	        b += w; left -= (size_t)w;
    34	    }
    35	    return 0;
    36	}
