    33	int jpeg_decode565(const uint8_t *jpg, size_t n, uint16_t *canvas, int w, int h)
    34	{
    35	    int err; uint8_t *px = dec(jpg, n, w, h, &err);
    36	    if (!px) return err;
    37	    size_t cnt = (size_t)w * h;
    38	    for (size_t i = 0; i < cnt; i++) canvas[i] = rgb565(px[3 * i], px[3 * i + 1], px[3 * i + 2]);
    39	    stbi_image_free(px);
    40	    return 0;
    41	}
