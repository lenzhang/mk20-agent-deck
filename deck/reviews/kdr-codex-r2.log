    12	int kbd_init(kbd_t *k, const char *fbdir, const char *bl_dir, const char *version)
    13	{
    14	    memset(k, 0, sizeof *k);
    15	    k->host_fd = -1; k->backlight = -1; k->ptt_col = 0; k->ptt_row = 3; k->version = version ? version : "mk20-kbd";
    16	    snprintf(k->bl_dir, sizeof k->bl_dir, "%s", bl_dir ? bl_dir : "");
    17	    if (screen_init(&k->scr, fbdir)) return -1;
    18	    if (host_parser_init(&k->hp, 2u << 20)) return -1;   /* full-canvas JPEG is << 1 MiB */
    19	    k->canvas = calloc((size_t)CANVAS_W * CANVAS_H, 2);
    20	    return k->canvas ? 0 : -1;
    21	}
    22	
    23	void kbd_free(kbd_t *k)
    24	{
    25	    screen_free(&k->scr); host_parser_free(&k->hp); free(k->canvas); k->canvas = NULL;
    26	}
    27	
    28	int kbd_host_send(kbd_t *k, uint32_t id, uint32_t cmd, const void *pl, size_t n)
    29	{
    30	    if (k->host_fd < 0) return -1;
    31	    size_t cap = n + HOST_HDR + 4;
    32	    uint8_t stackbuf[4096], *out = cap <= sizeof stackbuf ? stackbuf : malloc(cap);
    33	    if (!out) return -1;
    34	    int len = host_encode(id, cmd, pl, n, out, cap), rc = 0;
    35	    if (len < 0) rc = -1;
    36	    /* non-blocking fd, bounded wait (KBD_HOST_TX_MS): a host/bridge that stops reading must never stall the GD32 /
    37	     * HID / teardown loop (the bridge may itself be blocked writing requests to us). A frame cut short is counted
    38	     * as an error; the host parser resyncs on the next A1A55A5E magic. */
    39	    long deadline = 0;
    40	    for (int off = 0; rc == 0 && off < len;) {
    41	        ssize_t w = write(k->host_fd, out + off, (size_t)(len - off));
    42	        if (w > 0) { off += (int)w; continue; }
    43	        if (w < 0 && errno == EINTR) continue;
    44	        if (w < 0 && errno == EAGAIN) {
    45	            struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
    46	            long now = ts.tv_sec * 1000L + ts.tv_nsec / 1000000L;
    47	            if (!deadline) deadline = now + (k->host_tx_stuck ? 0 : KBD_HOST_TX_MS);   /* stuck: fail fast */
    48	            if (now >= deadline) { rc = -1; k->st.host_tx_timeouts++; k->host_tx_stuck = 1; break; }
    49	            struct pollfd pf = {k->host_fd, POLLOUT, 0};
    50	            poll(&pf, 1, (int)(deadline - now));
    51	            continue;
    52	        }
    53	        rc = -1;
    54	    }
    55	    if (out != stackbuf) free(out);
    56	    if (rc) k->st.host_tx_errors++; else { k->st.host_tx++; k->host_tx_stuck = 0; }
    57	    return rc;
    58	}
    59	
    60	int kbd_flush(kbd_t *k)
    61	{
    62	    if (k->scr.threaded) return 0;   /* writer threads pick dirty panels up themselves */
    63	    int a = screen_flush_bus(&k->scr, 0), b = screen_flush_bus(&k->scr, 1);
    64	    if (a < 0 || b < 0) { k->st.flush_errors++; return -1; }
    65	    k->st.panel_writes += (uint32_t)(a + b);
    66	    return a + b;
    67	}
    68	
    69	static void fill_panel(kbd_t *k, int fb, uint16_t bg, uint16_t fg, int bars)
    70	{
    71	    const panel_t *p = &PANELS[fb - 1];
    72	    uint16_t *px = malloc((size_t)p->w * p->h * 2);
    73	    if (!px) return;
    74	    for (int y = 0; y < p->h; y++) for (int x = 0; x < p->w; x++) {
    75	        int bar = bars ? (x * (bars * 2 + 1)) / p->w : 0;
    76	        int edge = y < 4 && bars;  /* small top marker */
    77	        px[y * p->w + x] = ((bar & 1) || edge) ? fg : bg;
    78	    }
    79	    screen_set_tile565(&k->scr, fb, 0, 0, p->w, p->h, px);
    80	    free(px);
    81	}
    82	
    83	void kbd_draw_idle(kbd_t *k)
    84	{
    85	    for (int i = 0; i < PANEL_COUNT; i++) fill_panel(k, PANELS[i].fb, 0x0841, 0x4208, PANELS[i].is_key ? 1 : 0);
    86	}
    87	
    88	void kbd_draw_key(kbd_t *k, int row, int col, int pressed)
    89	{
    90	    if (row < 0 || row > 3 || col < 0 || col > 4) return;
    91	    int fb = row * 5 + col + 1;
    92	    if (pressed) fill_panel(k, fb, 0xFFFF, 0xFFFF, 0); else fill_panel(k, fb, 0x0841, 0x4208, 1);
    93	}
    94	
    95	void kbd_gd32_cb(void *ctx, const uint8_t *pl, int len) { kbd_on_gd32((kbd_t *)ctx, pl, len); }
    96	
    97	void kbd_on_gd32(kbd_t *k, const uint8_t *pl, int len)
    98	{
    99	    if (len <= 0) return;
   100	    if (pl[0] == GD32_IN_ECHO) { k->st.echo_frames++; return; }   /* 0x05 echo: never an event */
   101	    gd32_key_event ev;
   102	    if (gd32_decode_key(pl, len, &ev)) { k->st.other_frames++; return; }
   103	    if (ev.knob) k->st.knob_events++;
   104	    else if (ev.row > 3 || ev.col > 4) { k->st.other_frames++; return; }
   105	    else k->st.key_events++;
   106	    if (ev.keycode) k->st.keycode_nonzero++;   /* GD32 already sent HID itself; still report the state */
   107	    char j[160];
   108	    int n = host_json_key_state(j, sizeof j, ev.col, ev.row, ev.pressed);
   109	    if (n > 0 && k->host_fd >= 0) kbd_host_send(k, KBD_EVENT_ID, HOST_CMD_JSON, j, (size_t)n);
   110	    /* router (r120): PTT key holds Right Alt/Option while pressed; every other key and the knobs are local */
   111	    if (k->hid && !ev.knob && ev.col == k->ptt_col && ev.row == k->ptt_row) hid_set_mod(k->hid, HID_MOD_RALT, ev.pressed);
   112	    if (k->local_ui && !ev.knob) { kbd_draw_key(k, ev.row, ev.col, ev.pressed); kbd_flush(k); }
   113	}
   114	
   115	void kbd_host_feed(kbd_t *k, const uint8_t *d, size_t n)
   116	{
   117	    host_push(&k->hp, d, n);
   118	    host_frame f;
   119	    while (host_next(&k->hp, &f)) kbd_on_host_frame(k, &f);
   120	}
