   168	int screen_start_writers(screen_t *s)
   169	{
   170	    if (s->threaded) return 0;
   171	    for (int b = 0; b < 2; b++) {
   172	        s->wbuf[b] = malloc(428 * 142 * 2);   /* largest panel */
   173	        if (!s->wbuf[b]) return -1;
   174	        s->stop[b] = 0;
   175	    }
   176	    for (int b = 0; b < 2; b++) {
   177	        s->warg[b].s = s; s->warg[b].bus = b;
   178	        if (pthread_create(&s->th[b], NULL, writer, &s->warg[b])) {
   179	            if (b == 1) { pthread_mutex_lock(&s->mu[0]); s->stop[0] = 2; pthread_cond_signal(&s->cv[0]); pthread_mutex_unlock(&s->mu[0]); pthread_join(s->th[0], NULL); }
   180	            return -1;
   181	        }
   182	    }
   183	    s->threaded = 1;
   184	    return 0;
   185	}
