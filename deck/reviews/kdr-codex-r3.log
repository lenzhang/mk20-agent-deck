   110	    for (int i = 0; i < PANEL_COUNT; i++) {
   111	        if (PANELS[i].bus != bus || !s->dirty[i]) continue;
   112	        if (write_buf(s, i, s->pending[i])) { s->write_errors++; return -1; }
   113	        memcpy(s->shadow[i], s->pending[i], px_count(i) * 2);
   114	        s->dirty[i] = 0; s->writes[i]++; n++;
   115	    }
   116	    return n;
   117	}
   118	
   119	static int next_dirty(screen_t *s, int bus, int *rr)
   120	{
   121	    for (int k = 0; k < PANEL_COUNT; k++) {
   122	        int i = (*rr + k) % PANEL_COUNT;
   123	        if (PANELS[i].bus == bus && s->dirty[i]) { *rr = i + 1; return i; }
   124	    }
   125	    return -1;
   126	}
   127	
   128	
   129	static void *writer(void *arg)
   130	{
   131	    struct screen_warg *wa = arg; screen_t *s = wa->s; int bus = wa->bus, rr = 0;
   132	    pthread_mutex_lock(&s->mu[bus]);
   133	    for (;;) {
   134	        int i;
   135	        while ((i = next_dirty(s, bus, &rr)) < 0 && !s->stop[bus]) {
   136	            pthread_cond_broadcast(&s->idle[bus]);
   137	            pthread_cond_wait(&s->cv[bus], &s->mu[bus]);
   138	        }
   139	        if (s->stop[bus] == 2 || (s->stop[bus] && i < 0)) break;   /* 2 = stop now, 1 = drain */
   140	        memcpy(s->wbuf[bus], s->pending[i], px_count(i) * 2);     /* snapshot: latest content wins */
   141	        s->dirty[i] = 0; s->busy[bus] = 1;
   142	        pthread_mutex_unlock(&s->mu[bus]);
   143	        int rc = write_buf(s, i, s->wbuf[bus]);
   144	        pthread_mutex_lock(&s->mu[bus]);
   145	        s->busy[bus] = 0;
   146	        if (rc == 0) {
   147	            memcpy(s->shadow[i], s->wbuf[bus], px_count(i) * 2);
   148	            s->writes[i]++;
   149	            /* re-dirtied meanwhile but back to what we just wrote? then it is clean */
   150	            if (s->dirty[i] && !memcmp(s->pending[i], s->shadow[i], px_count(i) * 2)) s->dirty[i] = 0;
   151	        } else {
   152	            s->write_errors++;
   153	            s->dirty[i] = 1;   /* retry later, with back-off so a missing fb cannot spin */
   154	            if (s->stop[bus]) break;
   155	            struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts);
   156	            ts.tv_nsec += (long)(s->retry_ms % 1000) * 1000000L; ts.tv_sec += s->retry_ms / 1000 + ts.tv_nsec / 1000000000L;
   157	            ts.tv_nsec %= 1000000000L;
   158	            pthread_cond_broadcast(&s->idle[bus]);
   159	            pthread_cond_timedwait(&s->cv[bus], &s->mu[bus], &ts);
   160	        }
   161	    }
   162	    s->busy[bus] = 0;
   163	    pthread_cond_broadcast(&s->idle[bus]);
   164	    pthread_mutex_unlock(&s->mu[bus]);
   165	    return NULL;
   166	}
   167	
   168	int screen_start_writers(screen_t *s)
   169	{
   170	    if (s->threaded) return 0;
   171	    for (int b = 0; b < 2; b++) {
   172	        s->wbuf[b] = malloc(428 * 142 * 2);   /* largest panel */
   173	        if (!s->wbuf[b]) return -1;
   174	        s->stop[b] = 0;
   175	    }
   176	    for (int b = 0; b < 2; b++) {
   177	        s->warg[b].s = s; s->warg[b].bus = b;
   178	        if (pthread_create(&s->th[b], NULL, writer, &s->warg[b])) {
   179	            if (b == 1) { pthread_mutex_lock(&s->mu[0]); s->stop[0] = 2; pthread_cond_signal(&s->cv[0]); pthread_mutex_unlock(&s->mu[0]); pthread_join(s->th[0], NULL); }
   180	            return -1;
   181	        }
   182	    }
   183	    s->threaded = 1;
   184	    return 0;
   185	}
   186	
   187	static int bus_clean(screen_t *s, int b)
   188	{
   189	    if (s->busy[b]) return 0;
   190	    for (int i = 0; i < PANEL_COUNT; i++) if (PANELS[i].bus == b && s->dirty[i]) return 0;
   191	    return 1;
   192	}
   193	
   194	static void deadline(struct timespec *ts, int ms)
   195	{
   196	    clock_gettime(CLOCK_REALTIME, ts);
   197	    ts->tv_sec += ms / 1000; ts->tv_nsec += (long)(ms % 1000) * 1000000L;
   198	    if (ts->tv_nsec >= 1000000000L) { ts->tv_sec++; ts->tv_nsec -= 1000000000L; }
   199	}
   200	
   201	int screen_wait_idle(screen_t *s, int timeout_ms)
   202	{
   203	    struct timespec ts; deadline(&ts, timeout_ms);
   204	    for (int b = 0; b < 2; b++) {
   205	        pthread_mutex_lock(&s->mu[b]);
   206	        while (!bus_clean(s, b)) {
   207	            if (!s->threaded) break;
   208	            if (pthread_cond_timedwait(&s->idle[b], &s->mu[b], &ts) == ETIMEDOUT) { pthread_mutex_unlock(&s->mu[b]); return -1; }
   209	        }
   210	        int ok = bus_clean(s, b);
   211	        pthread_mutex_unlock(&s->mu[b]);
   212	        if (!ok) return -1;
   213	    }
   214	    return 0;
   215	}
   216	
   217	void screen_stop_writers(screen_t *s, int drain, int timeout_ms)
   218	{
   219	    if (!s->threaded) return;
   220	    if (drain) screen_wait_idle(s, timeout_ms);
   221	    for (int b = 0; b < 2; b++) {
   222	        pthread_mutex_lock(&s->mu[b]); s->stop[b] = 2; pthread_cond_signal(&s->cv[b]); pthread_mutex_unlock(&s->mu[b]);
   223	    }
   224	    for (int b = 0; b < 2; b++) { pthread_join(s->th[b], NULL); free(s->wbuf[b]); s->wbuf[b] = NULL; }
   225	    s->threaded = 0;
   226	}
   227	
   228	void screen_stats(screen_t *s, unsigned writes[PANEL_COUNT], unsigned *errors, int *dirty_count)
   229	{
   230	    lock_all(s);
   231	    if (writes) memcpy(writes, s->writes, sizeof s->writes);
   232	    if (errors) *errors = s->write_errors;
   233	    if (dirty_count) { int d = 0; for (int i = 0; i < PANEL_COUNT; i++) d += s->dirty[i]; *dirty_count = d; }
   234	    unlock_all(s);
   235	}
   236	
   237	void screen_set_write_delay(screen_t *s, unsigned us) { __atomic_store_n(&s->write_delay_us, us, __ATOMIC_RELAXED); }

