    17	#include <poll.h>
    18	#include <signal.h>
    19	#include <stdio.h>
    20	#include <stdlib.h>
    21	#include <string.h>
    22	#include <termios.h>
    23	#include <sys/file.h>
    24	#include <time.h>
    25	#include <unistd.h>
    26	
    27	#define KBD_VERSION "mk20-kbd-0.3"
    28	
    29	static int open_gd32_ro(const char *dev) { return gd32_open(dev, 0); }
    30	
    31	static int monitor(const char *dev)
    32	{
    33	    int fd = open_gd32_ro(dev);
    34	    if (fd < 0) { perror(dev); return 1; }
    35	    gd32_parser p; gd32_parser_init(&p);
    36	    uint8_t buf[256];
    37	    for (;;) {
    38	        ssize_t n = read(fd, buf, sizeof buf);
    39	        if (n <= 0) { perror("read"); return 1; }
    40	        for (ssize_t i = 0; i < n; i++) {
    41	            int len = gd32_feed(&p, buf[i]);
    42	            if (len <= 0) continue;
    43	            struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
    44	            gd32_key_event ev;
    45	            if (gd32_decode_key(p.buf, len, &ev) == 0)
    46	                { printf("%ld.%06ld key col=%u row=%u pressed=%u keycode=0x%04x hex=", (long)ts.tv_sec, ts.tv_nsec / 1000,
    47	                       ev.col, ev.row, ev.pressed, ev.keycode); for (int k = 0; k < len; k++) printf("%02x", p.buf[k]); printf("\n"); }
    48	            else {
    49	                printf("%ld.%06ld frame id=0x%02x len=%d hex=", (long)ts.tv_sec, ts.tv_nsec / 1000, p.buf[0], len); for (int k = 0; k < len; k++) printf("%02x", p.buf[k]); printf("\n");
    50	            }
    51	            fflush(stdout);
    52	        }
    53	    }
    54	}
    55	
    56	static int pattern(const char *fbdir)
    57	{
    58	    screen_t s;
    59	    if (screen_init(&s, fbdir)) return 1;
    60	    for (int i = 0; i < PANEL_COUNT; i++) {
    61	        int w = PANELS[i].w, h = PANELS[i].h;
    62	        uint16_t *px = malloc((size_t)w * h * 2);
    63	        /* stripes: count of white bars == fb number, on a bus-coloured background */
    64	        for (int y = 0; y < h; y++) for (int x = 0; x < w; x++) {
    65	            int bar = (x * (PANELS[i].fb * 2 + 1)) / w;
    66	            px[y * w + x] = (bar & 1) ? 0xFFFF : (PANELS[i].bus ? 0x001F : 0xF800);
    67	        }
    68	        screen_set_tile565(&s, PANELS[i].fb, 0, 0, w, h, px);
    69	        free(px);
    70	    }
    71	    int a = screen_flush_bus(&s, 0), b = screen_flush_bus(&s, 1);
    72	    printf("pattern written bus0=%d bus1=%d errors=%u\n", a, b, s.write_errors);
    73	    screen_free(&s);
    74	    return (a < 0 || b < 0) ? 1 : 0;
    75	}
    76	
    77	static volatile sig_atomic_t g_stop;
    78	static hid_t g_hid;
    79	static void on_sig(int s) { (void)s; g_stop = 1; }
    80	static void on_usr1(int s) { (void)s; hid_request_close(&g_hid); }   /* gadget teardown: drop /dev/hidg0 now */
    81	
    82	static long mono_ms(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec * 1000L + t.tv_nsec / 1000000L; }
    83	
    84	static int open_host(const char *path)
    85	{
    86	    int fd = open(path, O_RDWR | O_NOCTTY | O_CLOEXEC | O_NONBLOCK);
    87	    if (fd < 0) return -1;
    88	    struct termios t;
    89	    if (tcgetattr(fd, &t) == 0) { cfmakeraw(&t); tcsetattr(fd, TCSANOW, &t); }
    90	    return fd;   /* stays O_NONBLOCK: replies are written with a bounded wait (kbd_host_send), never block the loop */
    91	}
    92	
    93	struct run_opts { const char *gd32, *host, *fb, *bl, *status, *hid, *hid_stop, *lock, *exit_file; int no_host, no_write, timeout_ms, no_hid, ptt_col, ptt_row; };
    94	
    95	static int run(const struct run_opts *o)
    96	{
    97	    /* single writer: a daemon-lifetime lock taken BEFORE touching ttyS1 / framebuffers (a surviving instance whose
    98	     * supervisor died keeps it; a second one exits 3) */
    99	    if (o->lock && o->lock[0]) {
   100	        int lfd = open(o->lock, O_RDWR | O_CREAT | O_CLOEXEC, 0600);
   101	        if (lfd < 0 || flock(lfd, LOCK_EX | LOCK_NB)) { fprintf(stderr, "mk20-kbd: %s busy: another instance runs\n", o->lock); return 3; }
   102	        /* lfd intentionally kept open for the process lifetime */
   103	    }
   104	    if (o->exit_file && o->exit_file[0] && access(o->exit_file, F_OK) == 0) {   /* teardown fence (gadget.sh kbd_stop) */
   105	        fprintf(stderr, "mk20-kbd: %s present: not starting\n", o->exit_file); return 0;
   106	    }
   107	    signal(SIGPIPE, SIG_IGN);
   108	    struct sigaction sa; memset(&sa, 0, sizeof sa); sa.sa_handler = on_sig;
   109	    sigaction(SIGTERM, &sa, NULL); sigaction(SIGINT, &sa, NULL);
   110	    sa.sa_handler = on_usr1; sigaction(SIGUSR1, &sa, NULL);
   111	    kbd_t k;
   112	    if (kbd_init(&k, o->fb, o->bl, KBD_VERSION)) { fprintf(stderr, "mk20-kbd: init failed\n"); return 1; }
   113	    k.ptt_col = o->ptt_col; k.ptt_row = o->ptt_row;
   114	    hid_init(&g_hid, o->hid, o->hid_stop);
   115	    if (!o->no_hid) { k.hid = &g_hid; hid_service(&g_hid, mono_ms()); }   /* open + startup all-keys-up */
   116	    k.local_ui = o->no_host;
   117	    kbd_draw_idle(&k);
   118	    if (screen_start_writers(&k.scr)) {   /* fall back to synchronous flushes */
   119	        fprintf(stderr, "mk20-kbd: writer threads failed, synchronous panel writes\n");
   120	        if (kbd_flush(&k) < 0) fprintf(stderr, "mk20-kbd: initial panel write failed (errors=%u)\n", k.scr.write_errors);
   121	    }
   122	
   123	    /* kill file: the fixed path, or an extra one from MK20_KBD_NO_WRITE_FILE (tests, TF rescue);
   124	     * either existing keeps the GD32 tty read-only. The env can only ADD a kill file. */
   125	    const char *extra = getenv("MK20_KBD_NO_WRITE_FILE");
   126	    int no_write = o->no_write || access(GD32_NO_WRITE_FILE, F_OK) == 0 || (extra && *extra && access(extra, F_OK) == 0);
   127	    int gfd = gd32_open(o->gd32, !no_write);
   128	    if (gfd < 0) { perror(o->gd32); kbd_free(&k); return 1; }
   129	    k.gd32_rw = !no_write;
   130	    gd32_parser gp; gd32_parser_init(&gp);
   131	    /* host link first, so key events arriving during knob init (<= 18 s worst case if the
   132	     * GD32 never echoes) are still forwarded */
   133	    if (!o->no_host && (k.host_fd = open_host(o->host)) >= 0) fprintf(stderr, "mk20-kbd: host link %s open\n", o->host);
   134	    long next_host_try = mono_ms() + 1000;
   135	    if (no_write) {
   136	        k.knob.state = 4;
   137	        fprintf(stderr, "mk20-kbd: GD32 write disabled (%s); knob K2 stays as configured in the GD32\n",
   138	                o->no_write ? "--no-gd32-write" : "kill file");
   139	    } else {
   140	        gd32_knob_opts ko = {o->timeout_ms, 3};
   141	        gd32_knob_init(gfd, &gp, &ko, &k.knob, kbd_gd32_cb, &k);
   142	        fprintf(stderr, "mk20-kbd: knob init %s (%d/6 slots, timeouts=%d tx_errors=%d)\n",
   143	                gd32_knob_state_name(k.knob.state), k.knob.ok_count, k.knob.timeouts, k.knob.tx_errors);
   144	    }
   145	    if (o->status) kbd_write_status(&k, o->status);
   146	
   147	    long next_status = mono_ms() + 1000;
   148	    uint8_t buf[16384];
   149	    while (!g_stop) {
   150	        long now = mono_ms();
   151	        if (!o->no_host && k.host_fd < 0 && now >= next_host_try) {
   152	            k.host_fd = open_host(o->host);
   153	            next_host_try = now + 1000;
   154	            if (k.host_fd >= 0) fprintf(stderr, "mk20-kbd: host link %s open\n", o->host);
   155	        }
   156	        if (k.hid) hid_service(k.hid, now);
   157	        struct pollfd pf[3] = {{gfd, POLLIN, 0}, {k.host_fd, POLLIN, 0}, {k.hid ? k.hid->fd : -1, POLLOUT, 0}};
   158	        int np = k.host_fd >= 0 ? 2 : 1;
   159	        if (!(k.hid && hid_wants_pollout(k.hid))) pf[2].fd = -1;
   160	        /* 100 ms tick while /dev/hidg0 is open: a stop file must close it well inside gadget.sh's window */
   161	        int r = poll(pf, 3, (k.hid && k.hid->fd >= 0) ? 100 : 250);
   162	        (void)np;
   163	        if (r < 0 && errno != EINTR) { perror("poll"); break; }
   164	        if (r > 0 && (pf[0].revents & (POLLIN | POLLERR | POLLHUP))) {
   165	            ssize_t n = read(gfd, buf, sizeof buf);
   166	            if (n <= 0 && errno != EINTR) { perror("gd32 read"); break; }
   167	            for (ssize_t i = 0; i < n; i++) { int l = gd32_feed(&gp, buf[i]); if (l > 0) kbd_on_gd32(&k, gp.buf, l); }
   168	        }
   169	        if (r > 0 && pf[2].fd >= 0 && (pf[2].revents & (POLLOUT | POLLERR))) hid_service(k.hid, mono_ms());
   170	        if (r > 0 && k.host_fd >= 0 && pf[1].fd >= 0 && (pf[1].revents & (POLLIN | POLLERR | POLLHUP))) {
   171	            ssize_t n = read(k.host_fd, buf, sizeof buf);
   172	            if (n > 0) kbd_host_feed(&k, buf, (size_t)n);
   173	            else if (n == 0 || (errno != EINTR && errno != EAGAIN)) {   /* pty master gone (bridge restart): EIO */
   174	                close(k.host_fd); k.host_fd = -1; next_host_try = mono_ms() + 500;
   175	                fprintf(stderr, "mk20-kbd: host link closed, retrying\n");
   176	            }
   177	        }
   178	        if (o->status && mono_ms() >= next_status) { kbd_write_status(&k, o->status); next_status = mono_ms() + 1000; }
   179	        if (o->exit_file && o->exit_file[0] && access(o->exit_file, F_OK) == 0) {
   180	            fprintf(stderr, "mk20-kbd: %s present: exiting\n", o->exit_file); break;
   181	        }
   182	    }
   183	    if (k.hid) { hid_release_all(k.hid, 1500); hid_close(k.hid, 0); }   /* never leave RAlt stuck (r120) */
   184	    screen_stop_writers(&k.scr, 1, 500);   /* bounded drain of the last frame */
   185	    if (o->status) kbd_write_status(&k, o->status);
   186	    if (k.host_fd >= 0) close(k.host_fd);
   187	    close(gfd);
   188	    kbd_free(&k);
   189	    return 0;
   190	}
   191	
   192	static void usage(void)
   193	{
   194	    fprintf(stderr, "usage: mk20-kbd --run [--no-host] [--no-gd32-write] [--gd32 TTY] [--host TTY] [--fb DIR]\n"
   195	                    "                      [--bl DIR|''] [--status FILE] [--knob-timeout-ms N]\n"
   196	                    "                      [--no-hid | --hid PATH] [--hid-stop-file PATH] [--ptt COL,ROW (1-based)]\n"
   197	                    "                      [--lock FILE (default /tmp/mk20-kbd.lock; '' = none)] [--exit-file FILE]\n"
   198	                    "       mk20-kbd --monitor [tty] | --pattern [fbdir] | --getinfo\n"
   199	                    "  kill file " GD32_NO_WRITE_FILE " = same as --no-gd32-write\n");
   200	}
   201	
   202	int main(int argc, char **argv)
   203	{
   204	    if (argc >= 2 && !strcmp(argv[1], "--monitor")) return monitor(argc > 2 ? argv[2] : "/dev/ttyS1");
   205	    if (argc >= 2 && !strcmp(argv[1], "--pattern")) return pattern(argc > 2 ? argv[2] : "/dev");
   206	    if (argc >= 2 && !strcmp(argv[1], "--getinfo")) {
   207	        char j[8192]; if (host_json_getinfo_ack(j, sizeof j, KBD_VERSION) < 0) return 1; puts(j); return 0;
   208	    }
   209	    if (argc >= 2 && !strcmp(argv[1], "--run")) {
   210	        struct run_opts o = {"/dev/ttyS1", "/dev/ttyGS0", "/dev", "/sys/kernel/debug/dispdbg", "/run/mk20/kbd.status",
   211	                             HID_DEFAULT_PATH, HID_DEFAULT_STOP_FILE, "/tmp/mk20-kbd.lock", NULL, 0, 0, 1000, 0, 0, 3};
   212	        for (int i = 2; i < argc; i++) {
   213	            const char *a = argv[i], *v = i + 1 < argc ? argv[i + 1] : NULL;
   214	            if (!strcmp(a, "--no-host")) o.no_host = 1;
   215	            else if (!strcmp(a, "--no-gd32-write")) o.no_write = 1;
   216	            else if (v && !strcmp(a, "--gd32")) { o.gd32 = v; i++; }
   217	            else if (v && !strcmp(a, "--host")) { o.host = v; i++; }
   218	            else if (v && !strcmp(a, "--fb")) { o.fb = v; i++; }
   219	            else if (v && !strcmp(a, "--bl")) { o.bl = v; i++; }
   220	            else if (v && !strcmp(a, "--status")) { o.status = *v ? v : NULL; i++; }
   221	            else if (v && !strcmp(a, "--knob-timeout-ms")) { o.timeout_ms = atoi(v); i++; }
   222	            else if (!strcmp(a, "--no-hid")) o.no_hid = 1;
   223	            else if (v && !strcmp(a, "--hid")) { o.hid = v; i++; }
   224	            else if (v && !strcmp(a, "--hid-stop-file")) { o.hid_stop = v; i++; }
   225	            else if (v && !strcmp(a, "--lock")) { o.lock = v; i++; }
   226	            else if (v && !strcmp(a, "--exit-file")) { o.exit_file = v; i++; }
   227	            else if (v && !strcmp(a, "--ptt")) {
   228	                int c, r;
   229	                if (sscanf(v, "%d,%d", &c, &r) != 2 || c < 1 || c > 5 || r < 1 || r > 4) { usage(); return 2; }
   230	                o.ptt_col = c - 1; o.ptt_row = r - 1; i++;
   231	            }
   232	            else { usage(); return 2; }
   233	        }
   234	        return run(&o);
   235	    }
   236	    usage();
   237	    return 2;
   238	}
