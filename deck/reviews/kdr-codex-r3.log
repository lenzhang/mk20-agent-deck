   491	def test_router_stop_fails_closed_term_then_kill(gh):
   492	    t, start, run, hid = gh
   493	    p = start("ignore")
   494	    r, dt = run("router_stop", MK20_KBD_HID_TICKS="3")
   495	    assert r.stdout.strip() == "done" and p.wait(2) == -signal.SIGTERM and "SIGTERM" in (t / "log").read_text()
   496	    p2 = start("stubborn")
   497	    os.unlink(t / "log")
   498	    r, dt = run("router_stop", MK20_KBD_HID_TICKS="3")
   499	    assert r.stdout.strip() == "done" and dt < 6 and p2.wait(2) == -signal.SIGKILL
   500	    assert "SIGKILL" in (t / "log").read_text()
