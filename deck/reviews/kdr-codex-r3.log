   429	HOLDER = r'''import os, signal, sys, time
   430	# fake mk20-kbd: holds the "hidg0" file open; mode: close (SIGUSR1 closes fd), ignore (USR1 ignored), stubborn (+TERM)
   431	hid, mode, ready = sys.argv[2], sys.argv[3], sys.argv[4]
   432	fd = [os.open(hid, os.O_WRONLY)]
   433	if mode == "deleted":   # parked stale fd: "/dev/hidg0 (deleted)"; a new node appears at the path
   434	    os.unlink(hid); open(hid, "w").close()
   435	def usr1(*_):
   436	    if mode == "close" and fd[0] >= 0:
   437	        os.close(fd[0]); fd[0] = -1
   438	signal.signal(signal.SIGUSR1, usr1)
   439	if mode == "stubborn":
   440	    signal.signal(signal.SIGTERM, signal.SIG_IGN)
   441	open(ready, "w").close()
   442	while True:
   443	    time.sleep(0.05)
   444	'''
   445	
   446	
   447	@pytest.fixture
   448	def gh(tmp_path):
   449	    (tmp_path / "mk20").mkdir(); (tmp_path / "bin").mkdir()
   450	    body = (FN.replace("/tmp/mk20-router-stop", str(tmp_path / "stop")).replace("/tmp/mk20-kbd-stop", str(tmp_path / "kstop"))
   451	            .replace("/tmp/mk20/", str(tmp_path / "mk20") + "/"))
   452	    (tmp_path / "bin/mk20-kbd").write_text(HOLDER)
   453	    hid = tmp_path / "hidg0"; hid.write_bytes(b"")
   454	    procs = []
   455	
   456	    def start(mode):
   457	        ready = tmp_path / f"ready-{len(procs)}"
   458	        p = subprocess.Popen([sys.executable, str(tmp_path / "bin/mk20-kbd"), "--run", str(hid), mode, str(ready)])
   459	        procs.append(p); assert wait(ready.exists, 10); return p
   460	
   461	    def run(fn, **env):
   462	        s = tmp_path / "g.sh"
   463	        s.write_text(f'log() {{ echo "$*" >> {tmp_path}/log; }}\n{body}\n{fn}\necho done\n')
   464	        t0 = time.time()
   465	        r = subprocess.run([BB, "sh", str(s)], capture_output=True, text=True, timeout=30,
   466	                           env=dict(os.environ, MK20_HIDG=str(hid), **env))
   467	        return r, time.time() - t0
   468	
   469	    yield tmp_path, start, run, hid
   470	    for p in procs:
   471	        if p.poll() is None:
   472	            p.kill(); p.wait()
   473	
   474	
   475	def holds(p, hid):
   476	    try:
   477	        return any(os.readlink(f"/proc/{p.pid}/fd/{f}") == str(hid) for f in os.listdir(f"/proc/{p.pid}/fd"))
   478	    except OSError:
   479	        return False
   480	
   481	
   482	def test_router_stop_quiesces_kbd_hid_via_sigusr1(gh):
   483	    t, start, run, hid = gh
   484	    p = start("close"); assert holds(p, hid)
   485	    r, dt = run("router_stop")
   486	    assert r.stdout.strip() == "done" and dt < 3
   487	    assert p.poll() is None and not holds(p, hid)          # still alive (panels/host keep running), hidg0 closed
   488	    assert (t / "stop").exists() and not (t / "log").exists()
   489	
