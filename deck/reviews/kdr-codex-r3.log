   371	@pytest.mark.parametrize("why", ["off", "use-kd", "fat", "nobin"])
   372	def test_boot_kbd_gated(kb, rel, why):
   373	    dev = kb
   374	    if why != "off":
   375	        conf(dev, "FEATURE_KBD=1\n")
   376	    if why == "use-kd":
   377	        dev.p("data/mk20/use-kd").write_text("")
   378	    elif why == "fat":
   379	        dev.p("mnt/SDCARD/mk20-use-kd").write_text("")
   380	    elif why == "nobin":
   381	        os.unlink(rel / "bin/mk20-kbd")
   382	    try:
   383	        r, log = run_boot(dev, rel)
   384	        assert genv(dev)["MK20_KBD"] == "0" and "INFO mk20d kbd \"supervisor" not in log
   385	        assert "router off" not in log and not dev.p("tmp/mk20/kbd.mode").exists()
   386	        assert "router v=9.9.9 supervisor launched" in log                        # stock path: router as before
   387	        assert ("enabled but not used" in log) == (why == "nobin")
   388	        time.sleep(0.3); assert not (dev.mock / "kbd.args").exists()
   389	    finally:
   390	        subprocess.run(["pkill", "-f", f"{rel}/sbin/mk20d router"])
   391	
