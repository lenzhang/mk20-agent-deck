   749		ptrace_event(PTRACE_EVENT_EXIT, code);
   750	
   751		validate_creds_for_do_exit(tsk);
   752	
   753		/*
   754		 * We're taking recursive faults here in do_exit. Safest is to just
   755		 * leave this task alone and wait for reboot.
   756		 */
   757		if (unlikely(tsk->flags & PF_EXITING)) {
   758			pr_alert("Fixing recursive fault but reboot is needed!\n");
   759			futex_exit_recursive(tsk);
