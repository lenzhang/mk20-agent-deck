"""Command line entry points."""
from __future__ import annotations

import argparse
import json
import logging
import os
import signal
import sys
import threading
import time

from .adapters.codex_desktop import CodexDesktopAdapter
from .adapters.herdr import HerdrAdapter
from .adapters.tmux import TmuxAdapter
from .config import CONFIG_DIR, DeckConfig, load_config, load_state, save_state
from .controller import Controller
from .effects import Effects
from .layout import DeviceLayout
from .model import Mode

log = logging.getLogger("mk20deck")


def build_adapters(cfg: DeckConfig):
    return {
        Mode.DESKTOP: CodexDesktopAdapter(cfg.codex),
        Mode.HERDR: HerdrAdapter(cfg.herdr),
        Mode.TMUX: TmuxAdapter(cfg.tmux),
    }


def build_controller(cfg: DeckConfig, adapters, sim: bool = False) -> Controller:
    state = load_state(cfg.state_path)
    from .agentcfg import AgentConfigApplier
    from .settings import LoggingApplier, SettingsPage, SettingsStore
    settings = (SettingsPage(store=SettingsStore.temp(), applier=LoggingApplier()) if sim
                else SettingsPage(store=SettingsStore(), applier=AgentConfigApplier()))
    return Controller(cfg, adapters, state=state, sim=sim, settings=settings,
                      on_state_change=lambda st: save_state(cfg.state_path, st))


def build_arrange(cfg: DeckConfig, ctl: Controller, rules_path: str | None = None, idle_adapters=None):
    """Slot rules + the loop hand-off of the 会话安排 page (rules apply even when the page is off)."""
    from .rules import RulesStore
    from .webui import ArrangeService, LoopCalls
    calls = LoopCalls()
    svc = ArrangeService(ctl, calls, RulesStore(rules_path), idle_adapters=idle_adapters,
                         poll_interval=cfg.poll_interval_s, bg_poll_s=cfg.background_poll_s)
    return calls, svc


def cmd_run(args) -> int:
    from .hw.power import PowerMonitor
    from .supervisor import Supervisor, default_renderer_factory
    from .transport import find_ports, open_transport
    from .webui import start_arrange_server

    cfg = load_config(args.config)
    if args.port:
        cfg.port = args.port
    ctl = build_controller(cfg, build_adapters(cfg))
    calls, web = None, None
    try:  # the page / rules never stop the deck: any failure here only logs and runs without them
        from .webauth import default_sessions_path, default_socket_path
        calls, svc = build_arrange(cfg, ctl, idle_adapters=build_adapters(cfg))
        web = start_arrange_server(svc, cfg.arrange_port, sessions_path=default_sessions_path(),
                                   socket_path=default_socket_path())  # None when off / port busy
    except Exception:  # noqa: BLE001
        log.exception("会话安排网页 / 固定规则未启动")
    stop = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    signal.signal(signal.SIGINT, lambda *_: stop.set())
    from .hw.gd32watch import TIMEOUT_S as GD32_PROBE_TIMEOUT_S, default_watch
    gd32 = default_watch()  # macOS: read-only ioreg check every 30 s for the GD32 stuck in its DFU bootloader
    gd32_thread = gd32.start(stop) if gd32 is not None else None
    try:
        Supervisor(ctl, find_ports, open_transport, default_renderer_factory(cfg), cfg,
                   power=PowerMonitor.default(), bg_adapters=build_adapters(cfg), calls=calls,
                   arrange=web, gd32=gd32, effects=Effects.from_config(cfg)).run(stop)  # web: the keyboard's 会话安排 key mints its one-time link here
    finally:
        stop.set()  # also when the supervisor raised: the watch thread ends ...
        if gd32_thread is not None:
            gd32_thread.join(GD32_PROBE_TIMEOUT_S + 1.0)  # ... after a running ioreg (bounded by its timeout)
        if web is not None:
            web.stop()
    return 0


def cmd_arrange(args, opener=None) -> int:
    """Open the 会话安排 page of the running daemon: a one-time link (60 s, single use) obtained over the
    daemon's 0600 unix socket, so only this user's processes with filesystem access can open the page.

    The token never goes into an argv (other users can read argv with ``ps``): the daemon writes the link to
    a 0600 file in its 0700 run directory (``.webloc`` on macOS) and only that file path is handed to ``open``;
    the daemon deletes the file once the token is redeemed or expires."""
    from .webauth import default_socket_path, request_link_file, request_url
    from .webui import probe
    cfg = load_config(args.config)
    port = cfg.arrange_port
    if not port:
        print("会话安排网页已关闭：config.toml 里 [web] arrange_port = 0")
        return 1
    sock = getattr(args, "socket", None) or default_socket_path()
    try:
        if args.print_only:
            url = request_url(sock)
        else:
            link, page = request_link_file(sock)
    except (OSError, ValueError) as e:
        st = probe(port)
        why = ("端口被其他程序占用（改 [web] arrange_port）" if st == "other"
               else "mk20deck 网页在运行，但授权通道不可用（见 mk20deck 日志）" if st == "ok"
               else "mk20deck 守护进程没有运行（python -m mk20deck run / LaunchAgent）")
        print(f"http://127.0.0.1:{port}/ 打不开：{why}")
        log.debug("arrange: %s", e)
        return 1
    if args.print_only:
        print(url)  # one-time link on this terminal only: valid for 60 s, works once
        return 0
    print(f"{page or 'http://127.0.0.1:%d/' % port}  （已在浏览器打开；一次性授权链接只经过本机 0600 文件）")
    if opener is None:
        if sys.platform == "darwin":
            from .daemon import open_url as opener  # `open <file>.webloc`: argv holds the path only
        else:
            import webbrowser
            opener = lambda p: webbrowser.open("file://" + p)  # noqa: E731
    opener(link)
    return 0


def cmd_shots(args) -> int:
    from .sim import attention_shots, layout_shots, move_shots, option_shots, scroll_shots, shots
    fn = {"attention": attention_shots, "layout": layout_shots, "move": move_shots, "option": option_shots,
          "scroll": scroll_shots}.get(getattr(args, "scenario", "default"), shots)
    made = fn(args.out, animations=not args.static)
    for n, cap in made:
        print(f"{os.path.join(args.out, n)}  {cap}")
    return 0


def cmd_serve(args) -> int:
    from .daemon import Daemon
    from .render.canvas import Renderer
    from .sim import demo_adapters, serve
    cfg = load_config(args.config)
    bg = None
    if args.source == "real":
        adapters = build_adapters(cfg)
        ctl = build_controller(cfg, adapters)
        bg = build_adapters(cfg)
    else:
        ctl = Controller(cfg, demo_adapters(), sim=True)
    d = Daemon(ctl, Renderer(DeviceLayout.default(), animations=cfg.animations), None,
               cfg.poll_interval_s, cfg.heartbeat_s, bg_poll_s=cfg.background_poll_s, bg_adapters=bg)
    web = None
    if args.arrange_port:  # the 会话安排 page against the simulated deck (demo data: a throw-away rules file)
        import tempfile
        from .webui import start_arrange_server
        rules_path = None if args.source == "real" else os.path.join(tempfile.mkdtemp(prefix="mk20-sim-"),
                                                                       "slot-rules.json")
        from .webauth import default_sessions_path, default_socket_path
        tmp = tempfile.mkdtemp(prefix="mk20-sim-")
        sock = default_socket_path() if args.source == "real" else os.path.join(tmp, "arrange.sock")
        d.calls, svc = build_arrange(cfg, ctl, rules_path)
        web = start_arrange_server(svc, args.arrange_port, socket_path=sock,
                                   sessions_path=default_sessions_path() if args.source == "real" else None)
        d.arrange, d.arrange_port = web, args.arrange_port
        if web is not None:
            print(f"会话安排: python -m mk20deck arrange --socket {sock}   （或一次性链接 {web.mint_url()} ，60 秒内有效）", flush=True)
    try:
        serve(d, args.host, args.http_port, args.source)
    finally:
        if web is not None:
            web.stop()
    return 0


def cmd_probe(args) -> int:
    cfg = load_config(args.config)
    ad = CodexDesktopAdapter(cfg.codex)
    t0 = time.monotonic()
    sessions = ad.poll()
    dt = (time.monotonic() - t0) * 1000
    rows = [{"id": s.sid.native, "title": s.title[:24], "state": s.state.value, "why": s.state_reason,
             "effort": s.effort, "cwd": s.cwd, "src": s.source_note} for s in sessions]
    if args.json:
        print(json.dumps({"poll_ms": round(dt, 1), "limited": ad.status_limited(), "sessions": rows},
                         ensure_ascii=False, indent=1))
    else:
        print(f"poll {dt:.1f} ms · {ad.status_limited()}")
        for r in rows:
            print(f"{r['state']:12} {r['id'][:8]} {r['effort'] or '-':6} {r['title']:24} {r['why']}")
    return 0


def cmd_probe_tmux(args) -> int:
    """Read-only (display-message / list-panes / ps): never sends keys, never reads pane contents."""
    cfg = load_config(args.config)
    ad = TmuxAdapter(cfg.tmux)
    sessions = ad.poll()
    rows = [{"pane": s.sid.native, "tool": s.tool.value, "title": s.title, "state": s.state.value,
             "why": s.state_reason, "src": s.source_note, "where": s.summary} for s in sessions]
    if args.json:
        print(json.dumps({"generation": ad.generation, "socket": ad.socket_path, "limited": ad.status_limited(),
                          "panes": rows}, ensure_ascii=False, indent=1))
    else:
        print(f"tmux {ad.generation} {ad.socket_path} · {ad.status_limited()}")
        for r in rows:
            print(f"{r['pane']:5} {r['tool']:6} {r['state']:14} {r['title'][:20]:20} {r['src']} · {r['where']}")
    return 0


def _port_users(port: str) -> dict:
    """Read-only: who holds the CDC port (lsof) and whether ScreenKey runs (pgrep). Never kills."""
    from .adapters.base import SubprocessRunner
    r = SubprocessRunner()
    pids = [p for p in r.run(["lsof", "-t", port], timeout=5).stdout.split() if p.strip()]
    sk = r.run(["pgrep", "-lif", "screenkey"], timeout=5).stdout.strip().splitlines()
    return {"pids": pids, "screenkey": sk}


