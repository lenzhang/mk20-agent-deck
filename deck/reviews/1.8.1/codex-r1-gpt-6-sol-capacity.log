     def _scroll_for(self, s: Session) -> _Scroll | None:
         """The running scroll-back of ``s``; one of another session / mode ends first."""
         sc = self.scrolling
         if sc is not None and (sc.key != s.sid.key() or sc.mode != self.mode):
             self._end_scroll()
