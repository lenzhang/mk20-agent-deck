      "focus": 1
     }
    }
   }
  ]
 },
 {
  "name": "long_press_mode_80ms_jitter",
  "group": "latency",
  "desc": "80±40 ms 延迟下模式键长按 650 ms 仍进 L4，短按仍切模式",
  "latency": {
   "input_ms": 80,
   "input_jitter_ms": 40,
   "router_ms": 20,
   "router_jitter_ms": 10,
   "frame_ms": 120,
   "frame_jitter_ms": 40,
   "seed": 3
  },
  "steps": [
   {
    "mark": "t"
   },
   {
    "press": "MODE",
    "hold": 100
   },
   {
    "wait": 300
   },
   {
    "expect": {
     "mode_changed": true,
