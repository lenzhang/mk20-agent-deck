   "seed": 7
  },
  "steps": [
   {
    "press": "S1",
    "hold": 40
   },
   {
    "wait": 100
   },
   {
    "press": "S1",
    "hold": 40
   },
   {
    "wait": 200
   },
   {
    "expect": {
