[
 {
  "name": "home_without_mac",
  "group": "onboard",
  "backend": "c",
  "desc": "Offline C compositor, read-only HOME/LS renderer",
  "steps": [
   {
    "expect": {
     "page": "HOME",
     "host_health": "offline",
     "ctl_page": 0,
     "settings.link": "unseen",
     "settings.cfg": "default"
    }
   },
   {
    "press": "5,1"
   },
   {
    "expect": {
     "page": "LS",
     "settings.active": true
    }
   },
   {
    "press": "5,1"
   },
   {
    "expect": {
     "settings.tab": 4
    }
   },
   {
    "wait": 150
   },
   {
    "expect": {
     "key_image_size": [
      128,
      128
     ],
     "sub_image_size": [
      428,
      142
     ]
    }
   }
  ]
 },
 {
  "name": "ls_read_only",
  "group": "onboard",
  "backend": "c",
  "desc": "LS shows values only: former Apply/Undo/edit keys and knobs never change configuration",
  "steps": [
   {
    "press": "5,1"
   },
   {
    "press": "2,1"
   },
   {
    "expect": {
     "page": "LS",
     "settings.tab": 1
    }
   },
   {
    "press": "2,2"
   },
   {
    "expect": {
     "settings.focus": 1
    }
   },
   {
    "press": "2,4"
   },
   {
    "expect": {
     "page": "LS",
     "settings.provider": "qwen",
     "settings.model": "qwen3-max",
     "settings.cfg": "default"
    }
   },
   {
    "knob": "K1",
    "action": "cw"
   },
   {
    "expect": {
     "settings.tab": 2,
     "settings.focus": 0
    }
   },
   {
    "knob": "K2",
    "action": "ccw"
   },
   {
    "expect": {
     "settings.focus": 3
    }
   },
   {
    "knob": "K2",
    "action": "press"
   },
   {
    "expect": {
     "page": "LS",
     "settings.tab": 2
    }
   },
   {
    "press": "1,4"
   },
   {
    "expect": {
     "page": "HOME",
     "settings.active": false
    }
   }
  ]
 },
 {
  "name": "web_key_without_mac",
  "group": "onboard",
  "backend": "c",
  "desc": "网页设置 shows the usb0 URL; nothing is sent while the Mac is not ONLINE",
  "steps": [
   {
    "press": "4,4"
   },
   {
    "expect": {
     "page": "HOME",
     "toast_contains": "Mac 端未运行"
    }
   },
   {
    "press": "5,1"
   },
   {
    "press": "4,4"
   },
   {
    "expect": {
     "page": "LS",
     "toast_contains": "浏览器"
    }
   },
   {
    "press": "3,4"
   },
   {
    "expect": {
     "page": "HOME"
    }
   }
  ]
 },
 {
  "name": "k2_hold_stays_on_host_page",
  "group": "onboard",
  "backend": "c",
  "desc": "K2 hold e-stop latches without leaving L1/L4",
  "steps": [
   {
    "press": "3,2"
   },
   {
    "expect": {
     "page": "L4",
     "host_health": "offline",
     "ctl_page": 2
    }
   },
   {
    "knob": "K2",
    "action": "down"
   },
   {
    "wait": 999
   },
   {
    "expect": {
     "stopped": false
    }
   },
   {
    "wait": 1
   },
   {
    "expect": {
     "stopped": true,
     "page": "L4",
     "ctl_page": 2
    }
   },
   {
    "knob": "K2",
    "action": "up"
   },
   {
    "expect": {
     "stopped": true,
     "page": "L4"
    }
   }
  ]
 },
 {
  "name": "host_hysteresis_no_navigation",
  "group": "onboard",
  "backend": "c",
  "desc": "Offline C compositor, read-only HOME/LS renderer",
  "steps": [
   {
    "press": "5,1"
   },
   {
    "press": "2,2"
   },
   {
    "host": {
     "method": "ui.hello",
     "version": 1
    }
   },
   {
    "host": {
     "method": "ui.heartbeat"
    }
   },
   {
    "wait": 1000
   },
   {
    "host": {
     "method": "ui.heartbeat"
    }
   },
   {
    "expect": {
     "host_health": "probing",
     "page": "LS"
    }
   },
   {
    "wait": 1000
   },
   {
    "host": {
     "method": "ui.heartbeat"
    }
   },
   {
    "expect": {
     "host_health": "online",
     "page": "LS",
     "settings.focus": 1,
     "settings.link": "online"
    }
   },
   {
    "wait": 3000
   },
   {
    "expect": {
     "host_health": "suspect"
    }
   },
   {
    "wait": 2000
   },
   {
    "expect": {
     "host_health": "offline",
     "page": "LS",
     "settings.focus": 1
    }
   }
  ]
 },
 {
  "name": "boot_auto_l1_once",
  "group": "onboard",
  "backend": "c",
  "desc": "First ONLINE after boot follows the Mac to L1 once; never again after navigation or loss",
  "steps": [
   {
    "expect": {
     "page": "HOME"
    }
   },
   {
    "host": {
     "method": "ui.hello",
     "version": 1
    }
   },
   {
    "host": {
     "method": "ui.heartbeat"
    }
   },
   {
    "wait": 1000
   },
   {
    "host": {
     "method": "ui.heartbeat"
    }
   },
   {
    "wait": 1000
   },
   {
    "host": {
     "method": "ui.heartbeat"
    }
   },
   {
    "expect": {
     "page": "L1",
     "host_health": "online",
     "ctl_page": 2
    }
   },
   {
    "knob": "K1",
    "action": "down"
   },
   {
    "wait": 1000
   },
   {
    "knob": "K1",
    "action": "up"
   },
   {
    "expect": {
     "page": "HOME"
    }
   },
   {
    "host": null
   },
   {
    "host": {
     "method": "ui.hello",
     "version": 1
    }
   },
   {
    "host": {
     "method": "ui.heartbeat"
    }
   },
   {
    "wait": 1000
   },
   {
    "host": {
     "method": "ui.heartbeat"
    }
   },
   {
    "wait": 1000
   },
   {
    "host": {
     "method": "ui.heartbeat"
    }
   },
   {
    "expect": {
     "page": "HOME",
     "host_health": "online"
    }
   }
  ]
 },
 {
  "name": "no_auto_l1_after_input",
  "group": "onboard",
  "backend": "c",
  "desc": "Any key before the Mac is ONLINE keeps the user on HOME",
  "steps": [
   {
    "press": "1,1"
   },
   {
    "host": {
     "method": "ui.hello",
     "version": 1
    }
   },
   {
    "host": {
     "method": "ui.heartbeat"
    }
   },
   {
    "wait": 1000
   },
   {
    "host": {
     "method": "ui.heartbeat"
    }
   },
   {
    "wait": 1000
   },
   {
    "host": {
     "method": "ui.heartbeat"
    }
   },
   {
    "expect": {
     "page": "HOME",
     "host_health": "online",
     "settings.link": "online"
    }
   }
  ]
 },
 {
  "name": "fb20_estop_vs_mode_key",
  "group": "onboard",
  "backend": "c",
  "desc": "fb20 is the Mac mode key on L1/L4 with the agent inactive, e-stop on on-board pages",
  "steps": [
   {
    "press": "2,2"
   },
   {
    "expect": {
     "page": "L1",
     "host_health": "offline"
    }
   },
   {
    "press": "5,4"
   },
   {
    "expect": {
     "page": "L1",
     "stopped": false
    }
   },
   {
    "press": "1,4"
   },
   {
    "press": "3,4"
   },
   {
    "expect": {
     "page": "HOME"
    }
   },
   {
    "press": "5,4"
   },
   {
    "expect": {
     "page": "HOME",
     "stopped": true
    }
   }
  ]
 }
]
