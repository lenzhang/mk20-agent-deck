[
 {
  "name": "k1_rotate_scrolls_selected",
  "group": "knobs",
  "desc": "K1 旋转 = 回看选中会话的历史（码 101 逆时针 = 更早 / 102 顺时针 = 更新），不改选中；Codex 桌面先置前再滚，不调 effort",
  "steps": [
   {
    "knob": "K1",
    "action": "ccw"
   },
   {
    "expect": {
     "toast_contains": "未选中",
     "agent_calls": {
      "*": 0
     }
    }
   },
   {
    "press": "S1"
   },
   {
    "wait": 1600
   },
   {
    "mark": "t"
   },
   {
    "knob": "K1",
    "action": "ccw",
    "n": 2
   },
   {
    "wait": 400
   },
   {
    "expect": {
     "selected_changed": false,
     "agent_calls": {
      "focus": 2,
      "scroll": 1,
      "set_effort": 0
     }
    }
   },
   {
    "knob": "K1",
    "action": "cw"
   },
   {
    "wait": 50
   },
   {
    "expect": {
     "selected_changed": false,
     "agent_calls": {
      "focus": 2,
      "scroll": 2
     }
    }
   }
  ]
 },
 {
  "name": "k1_press_returns_to_latest",
  "group": "knobs",
  "desc": "K1 短按 = 回到最新内容（码 100；Codex 桌面先置前该线程，再滚到底）；未选中只提示",
  "steps": [
   {
    "knob": "K1",
    "action": "press"
   },
   {
    "expect": {
     "toast_contains": "未选中",
     "agent_calls": {
      "*": 0
     }
    }
   },
   {
    "wait": 1600
   },
   {
    "press": "S1"
   },
   {
    "wait": 1600
   },
   {
    "mark": "t"
   },
   {
    "knob": "K1",
    "action": "press"
   },
   {
    "wait": 400
   },
   {
    "expect": {
     "agent_calls": {
      "focus": 2,
      "bottom": 1
     },
     "agent_call_within_ms": {
      "name": "bottom",
      "ms": 500
     },
     "toast_contains": "已回到最新",
     "page": "L1"
    }
   }
  ]
 },
 {
  "name": "k2_rotate_scroll_only",
  "group": "knobs",
  "desc": "K2 旋转只滚动副屏，不改选中",
  "steps": [
   {
    "press": "S1"
   },
   {
    "mark": "t"
   },
   {
    "knob": "K2",
    "action": "cw",
    "n": 2
   },
   {
    "expect": {
     "scroll": 2,
     "selected_changed": false
    }
   }
  ]
 },
 {
  "name": "unmapped_knob_code_ignored",
  "group": "knobs",
  "desc": "未映射的 ≥100 码不会落到键阵",
  "steps": [
   {
    "raw": [
     106,
     106,
     true
    ]
   },
   {
    "expect": {
     "agent_calls": {
      "*": 0
     },
     "page": "L1"
    }
   }
  ]
 }
]