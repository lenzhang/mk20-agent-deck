 {
  "name": "k1_press_focuses_selected",
  "group": "knobs",
  "desc": "K1 短按 = 聚焦选中会话（同双击/聚焦键，码 100）；未选中只提示",
  "steps": [
   {
    "knob": "K1",
    "action": "press"
   },
   {
    "expect": {
     "toast_contains": "未选中",
     "agent_calls": {
      "*": 0
     }
    }
   },
   {
    "wait": 1600
   },
   {
    "knob": "K1",
    "action": "cw"
   },
   {
    "mark": "t"
   },
   {
    "knob": "K1",
    "action": "press"
   },
   {
    "expect": {
     "agent_calls": {
      "focus": 1
     },
     "agent_call_within_ms": {
      "name": "focus",
      "ms": 350
     },
     "page": "L1"
    }
   }
  ]
 },
 {
  "name": "k2_rotate_scroll_only",
