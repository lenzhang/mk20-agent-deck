[
 {
  "name": "single_tap_selects_and_focuses",
  "group": "gestures",
  "desc": "单击会话键 = 选中并置前（PRD 1.5：按下即选中，松开 <600 ms 才聚焦）",
  "steps": [
   {
    "mark": "t"
   },
   {
    "press": "S1",
    "hold": 40
   },
   {
    "expect": {
     "selected": true,
     "agent_calls": {
      "focus": 1,
      "*": 1
     },
     "agent_call_within_ms": {
      "name": "focus",
      "ms": 350
     }
    }
   }
  ]
 },
 {
  "name": "every_tap_focuses",
  "group": "gestures",
  "desc": "再次单击同一会话或另一会话都会再置前一次（无双击手势）",
  "steps": [
   {
    "press": "S1",
    "hold": 40
   },
   {
    "wait": 100
   },
   {
    "press": "S1",
    "hold": 40
   },
   {
    "wait": 400
   },
   {
    "press": "S2",
    "hold": 40
   },
   {
    "expect": {
     "agent_calls": {
      "focus": 3
     }
    }
   }
  ]
 },
 {
  "name": "long_press_pins_without_focus",
  "group": "gestures",
  "desc": "长按会话键 ≥600 ms 钉扎/解除，只选中不置前",
  "steps": [
   {
    "press": "S2",
    "hold": 700
   },
   {
    "expect": {
     "selected": true,
     "toast_contains": "已钉扎",
     "agent_calls": {
      "*": 0
     }
    }
   },
   {
    "wait": 1600
   },
   {
    "press": "S2",
    "hold": 700
   },
   {
    "expect": {
     "toast_contains": "已取消钉扎",
     "agent_calls": {
      "*": 0
     }
    }
   }
  ]
 },
 {
  "name": "empty_slot_tap_no_action",
  "group": "gestures",
  "desc": "空槽（演示数据只有 8 个会话，S15 为空）单击只提示「空槽」",
  "steps": [
   {
    "press": "S15"
   },
   {
    "expect": {
     "toast_contains": "空槽",
     "selected": false,
     "agent_calls": {
      "*": 0
     }
    }
   }
  ]
 },
 {
  "name": "device_hid_keys_ignored",
  "group": "gestures",
  "desc": "删除 / 发送·可以 / 不行 Esc 由键盘直发 HID；即使事件到了 Mac，deck 也不动作、不改选中",
  "steps": [
   {
    "press": "S1"
   },
   {
    "mark": "t"
   },
   {
    "press": "DELETE",
    "hold": 400
   },
   {
    "press": "OK"
   },
   {
    "press": "NO"
   },
   {
    "expect": {
     "page": "L1",
     "selected_changed": false,
     "agent_calls": {
      "*": 1
     },
     "hid": [
      "Backspace down",
      "Backspace up",
      "Return down",
      "Return up",
      "Escape down",
      "Escape up"
     ]
    }
   },
   {
    "knob": "K2",
    "action": "press"
   },
   {
    "press": "OK"
   },
   {
    "expect": {
     "page": "L4",
     "agent_calls": {
      "*": 1
     }
    }
   }
  ]
 },
 {
  "name": "ptt_hold_hid",
  "group": "gestures",
  "desc": "PTT 按住 → Right Option down/up（只记录不发送）",
  "steps": [
   {
    "down": "PTT"
   },
   {
    "wait": 300
   },
   {
    "expect": {
     "ptt": true
    }
   },
   {
    "up": "PTT"
   },
   {
    "expect": {
     "ptt": false,
     "hid": [
      "RightOption down",
      "RightOption up"
     ]
    }
   }
  ]
 }
]